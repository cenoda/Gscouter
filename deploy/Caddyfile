# Caddy writes no access log unless asked to. Its error log records the
# request (the visitor's address, and the URL, which can hold a UID), so
# it is left out; certificate and startup messages are still logged.
{
	log default {
		exclude http.log.error
	}
}

# Caddy obtains and renews the HTTPS certificate for DOMAIN automatically.
{$DOMAIN} {
	encode gzip
	# Keep the pilot isolated while sharing the existing domain and TLS.
	# Exact /lab and its children match; /laboratory still goes to Gscouter.
	@rotation_lab path /lab /lab/*
	handle @rotation_lab {
		reverse_proxy rotation-lab:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
	handle {
		reverse_proxy gscouter:8080 {
			# While the app restarts for an update, hold requests until it is
			# back instead of failing them.
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
	# If it is still down, show a page instead of an empty response, which
	# some browsers save as a file.
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="refresh" content="5"><title>Gscouter</title><style>body{margin:0;display:grid;place-items:center;min-height:100vh;font:16px/1.5 system-ui,sans-serif;background:#f4f6f9;color:#1d2330}@media(prefers-color-scheme:dark){body{background:#11141a;color:#e6e9ef}}</style></head><body><div><p>Gscouter is updating. This page reloads by itself in a moment.</p><p lang="ko">업데이트 중입니다. 잠시 후 자동으로 다시 불러옵니다.</p></div></body></html>` {err.status_code}
	}
}

# The www name and the site's earlier domains (OLD_DOMAINS in .env,
# space-separated, may be empty) send visitors to the same page on DOMAIN.
www.{$DOMAIN} {$OLD_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}

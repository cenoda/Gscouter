active albedo;
for let i = 0; i < 4; i=i+1 {
  albedo skill, attack;
  zhongli skill[hold=1], dash, attack;
  rosaria skill, burst;
  xiao skill:2, burst;
  for let x = 1; x <= 12; x = x + 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}

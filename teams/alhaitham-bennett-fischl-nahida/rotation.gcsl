fn randy(mean, standardDeviation, display) {
  let value = randnorm() * standardDeviation + mean;
  if value > (mean + mean) {
    value = mean + mean;
  }
  if display {
    print(value);
  }
  return value;
}
let prev_char_id = -1;
let prev_action_id = -1;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }

  if action_id == .action.swap {
    
    delay(randy(9.5, 1.5, 0));
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    
    delay(randy(3, 1, 0));
  } else if prev_action_id != .action.attack {
    
    delay(randy(3, 1, 0));
  }
  
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}
active alhaitham;
for let i=0; i<4; i=i+1 {
  nahida skill[hold=1];
  while !.nahida.burst.ready {
    if .nahida.skill.ready {
      nahida skill;
    } else {
      nahida attack;
    }
  }
  nahida burst;
  bennett skill;
  while !.bennett.burst.ready {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  bennett burst;
  fischl attack, skill;
  alhaitham skill[hold=1], low_plunge[short=1],
            attack:3, charge,
            attack:3, dash,
            attack:3, charge,
            attack:1;
  while !.alhaitham.burst.ready {
    alhaitham attack;
  }
  alhaitham burst;

  fischl attack:2;
  if .fischl.burst.ready {
    fischl burst;
  }
  alhaitham attack:3, charge,
            attack:3, dash,
            attack:3, charge,
            attack:2;
}

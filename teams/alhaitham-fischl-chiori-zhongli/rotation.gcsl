active chiori;
for let i=0; i<4; i=i+1 {
  if i && .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  zhongli skill[hold=1], dash, attack;
  if .alhaitham.burst.ready {
    alhaitham burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst; 
  }

  alhaitham attack:3, dash,
            attack:3, skill,
            attack:3, dash,
            attack:3, charge, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;
}

active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  
  nicole skill, burst;
  
  amy attack:2, skill;
  
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:2, charge, dash, 
            attack:3, charge, dash;
  

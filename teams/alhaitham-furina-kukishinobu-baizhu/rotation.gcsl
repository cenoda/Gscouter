  }
  alhaitham skill[hold=1], low_plunge[short=1],
            attack:4, charge, dash,
            attack:4, charge, dash,
            attack:3;
  kuki skill;
  alhaitham swap;
  while !.alhaitham.burst.ready {
    alhaitham attack;
  }
  alhaitham burst;
  baizhu skill, attack;
  alhaitham attack:4, charge, dash,
            attack:4, charge, dash,
            attack:4, charge, dash,
            attack:3;
}

active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  mualani attack, skill, attack, walk[f=1];

  alhaitham burst;
  fischl attack:2, burst;
  alhaitham attack:3, charge, dash,
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:3, charge, jump,
            attack:2;
  
  mualani attack, skill, attack, walk[f=1];
  fischl attack:2, skill;
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:3;
}

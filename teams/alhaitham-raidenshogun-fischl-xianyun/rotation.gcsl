active raiden;
raiden skill;
for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, burst;
  
  fischl attack, skill;
  
  haitham skill[hold=1], low_plunge[short=1];
  while .haitham.status.xianyun-airborne-buff {
    haitham jump;
    if .airborne {
      haitham low_plunge[collision=rand()>0.4], attack:1;
    }
  }
  haitham burst;
  
  fischl attack:2, burst;
  
  xianyun attack:2; sleep(20); 
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
  
  print("done");
}

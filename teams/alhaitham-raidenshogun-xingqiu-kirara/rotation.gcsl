active xq;
 
for let r = 0; r < 5; r = r + 1 {
  xingqiu skill, dash, burst, attack;
  if r == 0 {
    raiden skill, attack;
  }
  kirara burst, attack, skill, attack;
  alhaitham burst, attack;
  if !r {
    alhaitham attack:3;
  } else {
    raiden skill, attack;
  }
  alhaitham attack:3, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;         
  kirara skill, attack;
  alhaitham skill[hold=1], low_plunge, 
           attack:3,dash,
           attack:3,dash,
           attack:3;
   
}

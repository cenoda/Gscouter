active raiden;
raiden skill;
  
for let r = 0; r < 5; r = r + 1 { 
  while !.nahida.burst.ready {
    nahida attack;
  }
  nahida burst, skill;
  xingqiu skill, dash;
  
  while !.xingqiu.burst.ready {
    xingqiu attack;
  }
  
  xingqiu burst, attack;
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:2, charge, dash, 
            attack:3, charge, dash;
  raiden attack, skill, attack; 
  
  while !.alhaitham.burst.ready { 
    alhaitham attack;
  }
  
  alhaitham burst;
  nahida attack, skill, attack; 
  alhaitham attack:3, jump,
            attack:3, jump, 
            attack:2, charge, jump,
            attack:3, dash, 
            attack:2;
}
sleep(52);

active fischl;
fischl skill; 
for let r=0; r<4; r=r+1 {
  xingqiu skill, dash;
  while !.xingqiu.burst.ready {
    xingqiu attack;
  }
  xingqiu burst, attack;
  
  dori skill, attack, burst; 
  
  haitham burst;
  
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  haitham attack:3, dash,
          attack:3, skill,
          attack:3, charge, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3;
}

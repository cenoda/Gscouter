active kazuha;
while 1 {
  kazuha skill;
  if .kazuha.burst.ready { kazuha burst; }
  nahida skill[hold=1];
  if .nahida.burst.ready { nahida burst; }
  if .yaemiko.burst.ready { yaemiko burst; }
  yaemiko skill:3;
  if .alhaitham.skill.ready { alhaitham skill; }
  if .alhaitham.burst.ready { alhaitham burst; }
  alhaitham attack:3, charge;
  alhaitham attack:3, charge;
  alhaitham attack:3, charge;
}

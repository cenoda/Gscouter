active fischl;
for let i=0; i<6; i=i+1 {
  fischl skill, attack;
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  mona burst, attack;
  fischl attack:2, burst;
  amber aim, burst;
  mona attack, skill, attack;
  amber aim;
  mona attack:3;
  amber skill, aim[bunny=1], aim:2;
}

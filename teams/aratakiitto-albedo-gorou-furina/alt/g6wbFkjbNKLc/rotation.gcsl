active furina;
       
   for let i=0; i<4; i=i+1 {
   
   furina skill, dash, burst;
   gorou attack, skill, burst;
   albedo attack, skill;
   
   itto attack, burst, skill[travel=0];
  
       while !.itto.skill.ready {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 
       
       itto skill[travel=0];
        
       while .itto.mods.itto-q {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 
       
   }

active gorou;
gorou skill,burst;
albedo attack,skill;
kirara skill, burst;
itto attack,
     burst[prestack=1],
     attack,
     skill[travel=0],
     attack:2,
     charge:5,
     attack:4,
     charge:5,
     skill[travel=0],
     charge;
wait(20); 
for let i=0; i<4; i=i+1 {
  gorou attack:2,skill,burst;
  albedo attack,skill;
  kirara skill[short_hold=1], burst;
  itto attack,
       burst[prestack=1],
       attack,
       skill[travel=0],
       charge:4,
       attack:3,
       charge:4,
       attack:3,
       skill[travel=0],
       charge:4; 
  
}

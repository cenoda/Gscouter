active zhongli;
  zhongli skill[hold=1],dash;
  gorou swap; wait(5); gorou burst;
  albedo attack, skill;
  itto attack, burst, skill[travel=0];
  
       while !.itto.skill.ready {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 
       
       itto skill[travel=0];
        
       while .itto.mods.itto-q {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 

   for let i=0; i<4; i=i+1 {
   
   gorou attack, skill;
   zhongli skill, burst;
   gorou burst;
   albedo attack, skill;
   
   itto attack, burst, skill[travel=0];
  
       while !.itto.skill.ready {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 
       
       itto skill[travel=0];
        
       while .itto.mods.itto-q {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } 
       
   }

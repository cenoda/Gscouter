active gorou;
for let i = 0; i < 4; i = i + 1 {
  gorou burst;
  
  if .chiori.burst.ready {
    
    chiori burst, skill:2;
    albedo attack, skill;
    
  } else {
    
    chiori skill:2;
    albedo attack, skill, burst;
    
  }
  
  gorou attack, skill;
  
  if i == 0 {
    itto attack, burst[prestack=1],
         attack, skill,
         attack:2, charge:5,
         attack:4, charge:5, skill[travel=0], charge;
         sleep(21); 

  } else {
    itto attack, burst[prestack=1],
         attack, skill, charge:4,
         attack:3, charge:4,
         attack:3, skill, charge:4; 

  }
}

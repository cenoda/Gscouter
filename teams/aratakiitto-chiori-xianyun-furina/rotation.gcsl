active furina;
for let i = 0; i < 4; i = i + 1 {
  
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  chiori skill, dash, skill; 
  xianyun skill, low_plunge, burst;
  
  pick_up_crystallize("any");  
  while !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  
  itto attack, burst, skill;
  
  for let p = 8; p > 0; p = p - 1 {
    itto jump;
    if .airborne {
    itto high_plunge[collision=rand()>0.5], dash;
    }
  }
  
  itto charge:3, skill, charge;
}

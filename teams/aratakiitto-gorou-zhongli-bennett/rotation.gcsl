active gorou;
  zhongli skill[hold=1];
  bennett skill, burst;
  gorou burst, skill;
 
  itto attack, burst[prestack=1], 
       attack, skill, attack:2, charge:5, 
       attack:4, charge:5, 
       skill[travel=0], charge;
       sleep(21); 

  for let i=0; i<4; i=i+1 {
  
  zhongli skill, attack:2;
  bennett skill, attack:2;
  gorou skill, attack:2;
  zhongli skill[hold=1], dash;
  bennett skill, burst;
  gorou attack, burst;
  itto attack, burst[prestack=1], 
       attack, skill, charge:4,
       attack:3, charge:4, 
       attack:3, skill, charge:4; 

  }

active zhongli;
  zhongli skill[hold=1], dash;
  gorou attack, skill;
  
  if .chiori.burst.ready {
    chiori burst;
  }
  
  chiori skill:2;
  gorou burst;
  itto attack, burst[prestack=1],
       attack, skill,
       attack:2, charge:5,
       attack:4, charge:5, skill[travel=0], charge;
       sleep(21); 
       
for let i = 0; i < 3; i = i + 1 {
  zhongli attack, skill; 
  
  gorou attack, skill;
  
  if .chiori.burst.ready {
    chiori burst;
  }
  
  chiori skill:2;
  gorou burst;
  zhongli skill[hold=1], dash;
  
  itto attack, burst[prestack=1],
       attack, skill, charge:4,
       attack:3, charge:4,
       attack:3, skill, charge:4; 
       
}

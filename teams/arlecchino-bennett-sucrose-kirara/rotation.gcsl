active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  bennett skill, burst;
  kirara skill[short_hold=1], burst;
  sucrose skill;
  if .sucrose.burst.ready {
    sucrose dash, burst;
  }
  arle charge, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}

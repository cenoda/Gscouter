active arle;
for let i = 0; i < 4; i = i + 1 { 
  arle skill;
  bennett  burst,skill;
  sucrose skill, dash;
  if .sucrose.burst.ready {
    sucrose burst, attack;
  } else {
    sucrose attack;
  }
  candace skill, burst; 
  arle charge, 
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:2;
  candace skill, attack:2, dash; 
}

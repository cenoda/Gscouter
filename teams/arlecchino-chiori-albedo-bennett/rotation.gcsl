active arle;
for let i = 0; i < 4; i = i + 1 {
  arlecchino skill;
  bennett skill, burst;
  chiori skill:2;
  albedo skill, attack;
  pick_up_crystallize("any");
  if .albedo.burst.ready {
    albedo burst;
  } else {
    chiori burst;
  }
  arlecchino attack, charge, 
             attack:3, dash, 
             attack:3, dash, 
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3;
}

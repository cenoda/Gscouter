active arle;
arle skill;
for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  furina skill, dash, attack;
  if ( i / 2 ) * 2 != i {
    furina burst;
  } else {
    yanfei attack:2, charge;
  }
  yanfei skill, attack, burst, attack;
  arle charge, 
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3,
       skill;
  if ( i / 2 ) * 2 != i {
    arle burst, skill;
  } else {
    yanfei attack:3, charge;
  }
}

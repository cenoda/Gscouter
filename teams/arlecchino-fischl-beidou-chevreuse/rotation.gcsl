active arle;
for let i = 0; i < 4; i = i + 1 {
  arle attack, skill;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  chevreuse burst, skill[hold=1], attack:2;
  beidou burst, skill;
  arle charge, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
  beidou skill, attack:2, jump; 
}

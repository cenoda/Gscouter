active fischl;
fischl skill; 
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  chevreuse burst, skill[hold=1], attack;
  thoma attack, skill, burst;
  fischl attack;
  if .fischl.skill.ready {
    fischl skill; 
  } else {
    fischl attack, burst; 
  }
  arle charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash;
  if i==0 {
    arle attack:5; 
  }
  
}

active fischl;
fischl skill; 
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  chevreuse burst, skill[hold=1], attack;
  xinyan skill, attack, burst, jump; 
  fischl attack;
  if .fischl.skill.ready {
    fischl skill; 
  } else {
    fischl attack, burst; 
  }
  arle charge, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
}

active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  
  arlecchino skill;
  durin skill, skill, burst;
  bennett skill, burst;
  if !is_even(i) {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  } 
  arlecchino attack, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3;
}

active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  
  arlecchino skill;
  durin skill:2, burst;
  chev skill[hold=1], attack, burst, attack;
  if !is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  } 
  arlecchino attack, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:2;
}

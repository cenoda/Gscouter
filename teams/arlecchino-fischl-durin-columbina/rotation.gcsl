active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  
  arlecchino skill;
  
  durin skill, skill, burst;
  
  columbina skill, attack;
  
  if (is_even(i)) {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  } 
  
  if (i != 0) {
    arlecchino attack:2;
  }
  arlecchino charge,
             attack:2, charge,
             attack:2, charge,
             attack:2, charge,
             attack:2, charge,
             attack:6, attack:2;
  if (i == 0) {
    arlecchino attack;
  }
}

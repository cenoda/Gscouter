active arle;
for let i=0; i<4; i=i+1 {
  
  arlecchino skill;
  durin skill, skill, burst;
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  } 
  mona attack, burst, attack, dash, attack;
  arlecchino charge,
             attack;
  mona skill, dash, attack;
  arlecchino attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:2;
}

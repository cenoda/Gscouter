active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  yae skill:3;
  chevreuse burst, skill[hold=1];
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  arle charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
}

active arle;
for let i = 0; i < 4; i = i + 1 {
  
  arle skill;
  if .furina.skill.ready {
    furina skill, dash, burst;
  } else {
    furina burst;
  }
  bennett burst, skill[hold=1, hold_c4=1]; 
  if !.element.t0.pyro {
    bennett attack;
  }
  lynette skill, attack, burst;
  arle charge,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3;
}

active arle;
arle skill;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, attack, burst;
  yelan burst, attack;
  bennett burst, attack, skill;
  yelan attack, skill;
  furina attack:2, dash; 
  arle charge[early_cancel=1], dash,
       attack:3, dash, 
       attack:3, dash, 
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack, skill;
}

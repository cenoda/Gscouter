active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  kazuha skill, high_plunge, burst;
  chiori skill:2;
  zhongli skill[hold=1], dash, attack;
  let startFrame = f();
  while f() - startFrame < 45 {
    while !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("pyro") {
      break;
    }
    wait(1);
  }
  arle charge, 
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash;
  kazuha skill, high_plunge;
  arle attack:3, dash, 
       attack:3, dash,
       attack:3;
}

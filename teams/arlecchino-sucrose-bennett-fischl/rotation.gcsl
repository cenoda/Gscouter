active arle;
 for let i=0; i<6; i=i+1 {
  arle skill;
  bennett burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  bennett skill, attack;
  sucrose attack, skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;
  } else {
    sucrose attack;
  }
  arle attack, charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}

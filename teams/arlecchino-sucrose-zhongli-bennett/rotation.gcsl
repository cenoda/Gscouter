active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  zhongli skill[hold=1], dash, attack;
  let startFrame = f();
  while f() - startFrame < 45 {
    while !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("pyro") {
      break;
    }
    wait(1);
  }
  bennett skill, burst;
  sucrose skill;
  if .sucrose.burst.ready {
    sucrose dash, burst;
  }
  arle charge, 
       attack:5, dash, 
       attack:5, dash,
       attack:5, dash;
}

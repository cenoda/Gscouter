active zhongli;
while 1 {
  zhongli skill[hold=1];
  furina skill;
  if .furina.burst.ready { furina burst; }
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  arlecchino skill;
  if .arlecchino.burst.ready { arlecchino burst; }
  arlecchino attack:4, charge;
  arlecchino attack:4, charge;
  while !.furina.skill.ready || !.arlecchino.skill.ready {
    arlecchino attack:4, charge;
  }
}

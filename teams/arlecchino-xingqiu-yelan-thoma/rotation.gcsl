active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  xingqiu burst, attack;
  thoma skill, attack, burst, attack;
  while !.thoma.mods.favonius-cd {
    thoma attack; 
  }
  yelan burst, attack;
  xingqiu skill, dash, attack:2;
  yelan attack, skill, attack;
  arle charge, 
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3;
  yelan attack, skill, attack;
}

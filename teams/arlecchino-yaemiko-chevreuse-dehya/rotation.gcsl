active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  yae skill:3;
  chevreuse burst, skill[hold=1], attack;
  if .yae.burst.ready {
    yae burst, skill:3;
  } else {
    yae attack:2, charge;
  }
  dehya skill:2;
  arle charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}

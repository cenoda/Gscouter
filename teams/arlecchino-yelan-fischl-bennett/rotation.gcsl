active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack; 
  }
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  arle attack, 
       charge,
       attack:5, dash,
       attack:5, dash,
       attack:5, dash,
       attack:3;
}

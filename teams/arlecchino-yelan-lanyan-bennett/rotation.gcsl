active yelan;
for let i = 0; i < 4; i = i + 1 { 
  yelan skill, attack, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  arle skill;
  bennett swap;   delay(42);  
  bennett skill, burst;
  lanyan skill:2;
  arle attack:3, charge, 
       attack:5, dash, 
       attack:5, dash, 
       attack:3, dash;
}

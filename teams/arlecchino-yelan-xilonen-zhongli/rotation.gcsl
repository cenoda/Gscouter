active arle;
for let i = 0; i < 4; i = i + 1 {
  arle skill;
  xilonen skill, attack:2;
  yelan skill, attack, burst, attack;
  zhongli skill[hold=1], dash, attack;
  if !pick_up_crystallize("pyro") {
    pick_up_crystallize("hydro");
  }
  arle charge, 
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
  zhongli burst;
}

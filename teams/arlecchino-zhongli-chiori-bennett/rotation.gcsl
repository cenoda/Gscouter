active arle;
for let i = 0; i < 4; i = i + 1 {
  arlecchino skill;
  chiori skill:2;
  bennett skill, burst; 
  zhongli skill[hold=1], dash, attack:2;
  let startFrame = f();
  while !pick_up_crystallize("pyro") && f() - startFrame < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  arlecchino charge, 
             attack:5, dash, 
             attack:5, dash, 
             attack:5, dash,
             attack:3;
}

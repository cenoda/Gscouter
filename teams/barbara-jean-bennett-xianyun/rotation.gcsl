active xianyun;
for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
  
  jean skill, burst;

  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      barbara jump;
      if .airborne {
        barbara high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 4 {
        barbara attack;
      } else if j == 8 {
        barbara attack;
      } else {
        barbara dash;
      }
    }
  }
  
  bennett attack, skill;
  
  jean skill;
}

active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst, attack;
  kaeya skill, burst, attack;
  kuki skill; 
  if .barbara.skill.ready
  {
    barbara skill;
  }
  else
  {
    barbara attack;
  } 
  barbara attack:2, charge;
  barbara attack:2, charge;
  kaeya skill, attack:3;
  nahida skill, attack:2; 
  barbara attack:2, charge;
  barbara attack:2, charge, attack:2;
}

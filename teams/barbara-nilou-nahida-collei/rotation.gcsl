active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst, attack; 
  barbara attack:2, charge;
  if .barbara.skill.ready {
    barbara skill;
  } else {
    barbara attack;
  }
  nilou skill, attack:2;
  nilou skill;
  collei skill, burst;
  barbara attack:2, charge;
  barbara attack:3;
  barbara attack:2, charge;
  barbara attack:3;
  barbara attack:2, charge;
  if .nilou.burst.ready {
    nilou burst;
  } else {
    barbara attack:2;
  }
}

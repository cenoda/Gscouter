fn rand_counter() {
  let counter = rand();
  if counter > 0.75 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.5 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}
active beidou; 
fischl attack, skill;
for let i=0; i<4; i=i+1 {
  
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  if i > 0 {
    bennett attack, charge;
  }
  bennett skill, burst;
  
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst; 
  }

  while .beidou.mods.bennett-field || .status.bennettburst { 
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready:
        beidou burst;
      case .beidou.normal > 2 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }
  
  bennett skill, attack; 
  
  print("done");
}

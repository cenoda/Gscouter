active fischl;
while 1 {
  fischl skill;
  if .fischl.burst.ready { fischl burst; }
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  sucrose skill;
  if .sucrose.burst.ready { sucrose burst; }
  beidou skill[counter=2];
  if .beidou.burst.ready { beidou burst; }
  while !.fischl.skill.ready {
    beidou attack:4;
  }
}

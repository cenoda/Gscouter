active dori;
dori burst;
for let i=0; i<4; i=i+1 {
  bennett burst;
  if .bennett.skill.ready {
    bennett skill;
  }
  
  chevreuse burst, skill[hold=1]:3; 
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett skill, attack;
  while .bennett.burst.cd {
    if .bennett.skill.ready && .bennett.swap.ready {
      bennett skill;
    } else if .dori.burst.ready && .dori.swap.ready {
      dori burst;
    } else if .dori.skill.ready && .dori.swap.ready {
      dori skill;
    } else if .dori.onfield {
      dori attack;
    } else {
      bennett attack;
    }
  }
  
  print("done");
}

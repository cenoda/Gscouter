active lisa;
lisa attack; 
for let i=0; i<4; i=i+1 {
  bennett burst, skill;
  
  chevreuse burst, skill[hold=1]:3; 
  
  if .lisa.burst.ready {
    lisa burst;
  }
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett skill, attack;
  while !.bennett.burst.ready {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  print("done");
}

active raiden;
for let i=0; i<4; i=i+1 {
  raiden skill, attack; 
  
  bennett skill, burst;
  
  chevreuse burst, skill[hold=1]:3; 
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett skill, attack;
  while .bennett.mods.bennett-field {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  print("done");
}

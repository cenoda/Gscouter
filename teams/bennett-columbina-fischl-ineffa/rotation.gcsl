active ineffa;
for let i = 0; i < 4; i = i + 1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill;
  }
  
  if i > 0 && .columbina.burst.ready {
    columbina burst, skill;
  } else {
    columbina attack, skill;
  }
  
  bennett burst, skill, dash, attack; 
  
  if .fischl.skill.ready { 
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  while .status.bennettburst || .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.normal > 2 && .bennett.infusion.bennett-fire-weapon {
      bennett charge, dash;
    } else {
      bennett attack;
    }
  }
}

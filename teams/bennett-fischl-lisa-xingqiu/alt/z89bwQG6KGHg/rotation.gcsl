active xingqiu;
for let x = 0; x < 6; x = x + 1 {
  xingqiu skill, dash, burst, attack;
  bennett skill, attack, burst;
  fischl attack:2, burst;
  lisa burst;
  bennett walk, attack:3, skill,
          attack, skill,
          attack:2, skill,
          attack, skill,
          attack:3, skill,
          attack, skill,
          attack:2, skill,
          attack, skill,
          attack:3, skill;
  fischl skill, attack;
  lisa skill[hold=1];
  bennett skill, attack;
}

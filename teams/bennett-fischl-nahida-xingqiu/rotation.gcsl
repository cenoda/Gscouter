active nahida;
for let x = 0; x < 4; x = x + 1 {
  
  nahida burst, skill;
  xingqiu skill, dash, burst, attack;
  bennett skill, attack, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst; 
  } else {
    fischl attack:3, skill, attack; 
  }
  bennett attack, skill,
          attack:4, skill,
          attack:4, skill,
          attack:4, skill,
          attack:4, skill; 
}

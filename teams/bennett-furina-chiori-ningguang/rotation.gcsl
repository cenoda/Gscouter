let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any");
  }
  return _execute_action(char_id, action_id, p);
}
active furina;
for let x=0; x<4; x=x+1 {
 
  furina skill, dash, burst; 
  bennett burst, skill;
  ningguang skill, dash, attack, charge;
  if .chiori.burst.ready {
    chiori burst;
  } 
  chiori skill:2;
  ningguang burst, dash, skill, charge, attack, charge, attack, charge, attack, charge, attack, charge, attack, charge;
  bennett skill, dash;
  
}

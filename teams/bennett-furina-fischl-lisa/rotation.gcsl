active furina;
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;
  
  bennett skill, burst;
  
  if .lisa.burst.ready && .lisa.energy == .lisa.energymax {
    lisa burst;
  }
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }

  while !.bennett.burst.ready && !.furina.skill.ready {
    if .lisa.burst.ready && .lisa.energy == .lisa.energymax {
      lisa burst;
    } else if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}

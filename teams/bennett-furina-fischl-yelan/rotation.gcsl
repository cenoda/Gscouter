active furina;    
for let i=0; i<4; i=i+1 {
	furina skill, dash, burst;
	yelan burst, attack , skill;
	bennett burst, attack, skill;
	if .fischl.burst.ready {
	  fischl attack:2, burst;
	} else {
	  fischl attack, skill;
	}
	bennett attack;
	while .status.bennettburst {
      if .bennett.skill.ready {
        bennett skill;
      } else {
        bennett attack;
      }
	}
	bennett attack:3, skill;
}

active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
	
	bennett attack:3;
  while !.furina.skill.ready {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
}

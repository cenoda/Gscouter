active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  
  rosaria skill, burst;
  
	bennett attack:2;
  while .furina.skill.cd > 90 {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  rosaria skill;
}

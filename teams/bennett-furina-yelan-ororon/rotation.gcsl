active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  bennett skill, attack, burst;
  
  ororon attack, skill, attack, burst;
  bennett attack;
  while .status.bennettburst {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
	
}

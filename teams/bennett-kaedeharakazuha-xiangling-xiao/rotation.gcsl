active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill;
  kazuha skill, high_plunge, burst;
  bennett burst, skill;
  xiangling burst, skill;
  kazuha skill, high_plunge;
  xiao skill:2, burst;
  for let x = 1; x <= 7; x = x + 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}

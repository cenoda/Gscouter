active fischl;
amy skill;
for let x = 0; x < 4; x = x + 1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  bennett skill, attack, burst;
  
  if !.fischl.burst.ready {
    fischl attack, skill; 
  } else {
    fischl attack:2, burst; 
  }
  
  bennett attack;
  while .yelan.mods.yelanburst {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}

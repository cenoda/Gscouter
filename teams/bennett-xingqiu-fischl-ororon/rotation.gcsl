active fischl;
fischl skill;
for let x = 0; x < 4; x = x + 1 {
  xingqiu skill, dash, burst, attack;
  ororon skill, burst, attack;
  
  bennett burst, skill, attack;
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett attack:1;
  
  while .status.bennettburst || .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  bennett attack;
}

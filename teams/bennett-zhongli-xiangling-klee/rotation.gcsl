active klee;
klee attack;
for let x = 0; x < 5; x = x + 1 { 
  zhongli skill[hold=1], dash, attack;
  
  while !pick_up_crystallize("pyro") { 
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  }
  
  while !.zhongli.mods.favonius-cd { 
    zhongli attack;
  }
  
  bennett burst, skill;
  xiangling burst, skill;
  klee attack, burst, walk, attack, skill[bounce=3, mine=8];
  
  if .klee.skill.ready {
    klee jump, attack, skill[bounce=3, mine=8], jump;
  } else {
    klee attack[travel=6], charge; 
  }
  for let ca = 0; ca < 5; ca = ca + 1 {
    klee attack[travel=6], charge;
  }
  
  klee attack, walk, attack, walk, attack, walk, attack, walk, attack;
  bennett skill;
}

active xianyun;
for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, attack, burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  
  charlotte skill[hold=1];

  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      charlotte jump;
      if .airborne {
        charlotte high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 1 { 
        charlotte attack;
      } else if j == 8 {
        charlotte attack;
      } else {
        charlotte dash;
      }
    }
  }
  if .charlotte.burst.ready && .charlotte.energy == .charlotte.energymax {
    charlotte burst;
  }
  
  bennett attack, skill;
  
  xiangling attack:3;
}

active mavuika; 
for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  if !i {
    chasca skill:2;
  }
  bennett skill, burst;
  if .xiangling.burst.ready {
    xiangling burst;
  } else {
    xiangling attack;
  }
  xiangling skill, dash;
  mavuika burst, charge, dash;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82);

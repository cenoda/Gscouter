active durin;
for let i=0; i<4; i=i+1 {
  durin skill, attack, burst;
  bennett skill, burst;
  citlali skill, burst, attack;
  chasca skill;
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  bennett skill;
}

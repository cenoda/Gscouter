active durin;
for let i=0; i<4; i=i+1 {
  durin skill, skill, burst;
  if is_even(i) {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  mona attack, burst, attack:3, skill, attack;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82);

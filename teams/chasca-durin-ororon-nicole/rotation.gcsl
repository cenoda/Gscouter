active nicole;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    nicole burst, skill;
  } else {
    nicole attack, skill;
  }
  durin skill:2, burst;
  ororon skill, burst;
  chasca skill, aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
}
wait(82);

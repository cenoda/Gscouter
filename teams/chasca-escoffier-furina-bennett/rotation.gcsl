active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  bennett skill, burst;
  if is_even(i) {
    escoffier skill; wait(90);  
  } else {
    escoffier skill, burst;
  }
  chasca skill;
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  bennett skill, attack:2;
}

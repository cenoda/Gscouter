active furina;
for let i=0; i<4; i=i+1 {
  furina attack, skill, dash, attack, burst;
  citlali skill, attack;
  escoffier skill, attack, burst;
  citlali burst;
  chasca skill;
  chasca aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca attack:3;
  }
}

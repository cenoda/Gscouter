active fischl;
for let i = 0; i < 4; i = i + 1 {
  
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  chevreuse burst, skill[hold=1];
  
  if !i {
    durin skill, burst, attack;
  } else {
    durin attack, skill:2, attack, burst, attack;
  }
  
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  
}

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  bennett skill, burst;
  if i && .fischl.skill.ready  {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  chasca skill;
  chasca aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca attack:3; 
  }
  bennett skill;
}

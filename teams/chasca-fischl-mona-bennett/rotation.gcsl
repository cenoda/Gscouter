active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  if !.bennett.mods.favonius-cd {
    bennett attack;
  }
  if .fischl.skill.ready  {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  mona skill, burst, attack;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}

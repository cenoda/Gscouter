fn skirk_burst() {
  if .skirk.serpents_subtlety >= 5 || .skirk.void_rifts > 0 {
    skirk skill[hold=1];
    wait(3);
    if .skirk.serpents_subtlety >= 50 {
      skirk burst;
    }
  }
}
active furina;
for let i=0; i<2; i=i+1 {
  furina skill, dash, burst;
  bennett skill, burst;
  skirk_burst();
  chasca skill, aim:4, burst;
  
  furina attack:2;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  bennett skill, burst;
  skirk_burst();
  chasca skill, aim:4;
}
wait(126);

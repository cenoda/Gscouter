active ineffa;
for let i=0; i<6; i=i+1 {
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  } else {
    ineffa attack;
  }
  
  columbina skill;
  if .columbina.burst.ready {
    columbina burst;
  }
  
  if !i {
    durin skill, burst, skill;
  } else {
    durin skill:2, burst;
  }
  
  chasca skill, aim:4, aim[bullets=4];
  if is_even(i) {
    chasca burst;
  }
}

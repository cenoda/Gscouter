active mavuika; 
for let i=0; i<4; i=i+1 {
  ineffa skill;
  if is_even(i) {
    ineffa attack;
    columbina skill, burst;
  } else {
    ineffa burst;
    columbina skill, attack:2;
  }
  mavuika skill, burst, charge, dash;
  chasca skill;
  chasca aim:4;
  chasca aim[bullets=4];
  if is_even(i) {
    chasca burst;
  } else {
  }
}
wait(82);

active ineffa;
for let i=0; i<6; i=i+1 {
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  } else {
    ineffa attack;
  }
  
  columbina skill;
  if .columbina.burst.ready {
    columbina burst;
  } else {
    columbina attack;
  }
  
  nicole skill;
  if .nicole.burst.ready {
    nicole burst;
  }
  
  chasca skill, aim:4, aim[bullets=4];
  if is_even(i) {
    chasca burst;
  }
}

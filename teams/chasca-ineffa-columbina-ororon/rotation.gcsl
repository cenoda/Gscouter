active columbina;
for let i=0; i<6; i=i+1 {
  
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  } 
  
  ororon skill, burst, attack;
  
  chasca skill, aim:4, aim[bullets=4];
  if .chasca.burst.ready {
    chasca burst;
  }
  
}

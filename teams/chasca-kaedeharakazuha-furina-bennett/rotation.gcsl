active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  kazuha burst;
  bennett skill, burst;
  if !.element.t0.pyro && !.element.t0.hydro {
    bennett attack;
  } 
  kazuha skill, high_plunge;
  chasca skill;
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  kazuha skill, high_plunge;
}

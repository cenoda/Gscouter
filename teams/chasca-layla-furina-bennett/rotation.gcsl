active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  bennett skill, burst;
  layla skill, attack, burst;
  chasca skill;
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
    chasca attack:2;
  } else {
    chasca aim[bullets=4];
    chasca attack;
  }
  bennett skill, attack;
}

active mavuika;
for let i = 0; i < 4; i = i + 1 {
  
  mavuika skill;
  if i {
    mav attack;
  }
  
  durin skill, attack, burst;
  if !i {
    furina burst;
  }
  furina skill, dash, attack;
  mavuika burst, charge, dash, charge, dash;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  
}

active mavuika; 
for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  bennett skill, burst;
  ganyu skill, attack, burst;
  mavuika burst;
  if !.chasca.burst.ready {
    mavuika charge, dash;
  }
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82);

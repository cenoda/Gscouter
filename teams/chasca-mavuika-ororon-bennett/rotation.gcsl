active mavuika; 
for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  ororon burst, skill;
  bennett skill, burst;
  mavuika burst;
  chasca skill;
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
    mavuika dash;
  } else {
    chasca aim[bullets=4];
  }
}

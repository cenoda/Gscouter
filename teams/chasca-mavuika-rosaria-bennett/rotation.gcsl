active mavuika; 
for let i=0; i<4; i=i+1 {
  mavuika skill[hold=1], dash;
  bennett skill, burst;
  rosaria skill, burst;
  mavuika burst;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82);

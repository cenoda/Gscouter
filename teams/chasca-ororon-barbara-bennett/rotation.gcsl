active ororon;
for let i=0; i<4; i=i+1 {
  ororon burst, skill;
  if !.ororon.mods.favonius-cd {
    ororon attack;
  }
  
  bennett skill, burst, attack;
  
  barbara swap; wait(11);   
  if .barbara.skill.ready { 
    barbara skill, attack;
  } else {
    barbara attack:2;
  }
  
  chasca skill;
  set_player_pos(0,-2);  
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  set_player_pos(0,0);
}
wait(82);

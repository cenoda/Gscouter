active mavuika; 
for let i=0; i<3; i=i+1 {
  mavuika skill;
  
  bennett skill, burst;
  
  shenhe attack;
  if .shenhe.burst.ready && .shenhe.energy == .shenhe.energymax { 
    shenhe burst, skill[hold=1];
    wait(23); 
  } else {
    shenhe skill[hold=1];
  }
  
  mavuika burst;
  
  chasca skill, aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
}
wait(82);

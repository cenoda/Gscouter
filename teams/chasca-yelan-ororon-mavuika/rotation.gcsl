active mavuika;
for let i=0; i<4; i=i+1 {
  mavuika attack, skill;
  
  yelan attack, skill, burst, attack;
  
  ororon burst, skill, attack;
  
  mavuika burst, charge, dash;
  chasca attack, skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82);

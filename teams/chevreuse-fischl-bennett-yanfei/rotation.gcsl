set_particle_delay("chevreuse",80);
active bennett;
for let r = 0; r < 4; r = r + 1 {
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack:2,skill;
  } else if .fischl.burst.ready {
    fischl attack:2, burst;
  }
  
  chevreuse skill[hold=1],attack,burst;
  
  yanfei skill,charge,attack:2;
  if .yanfei.burst.ready {
    yanfei burst;
  } else {
    yanfei charge;
  }
  yanfei
      attack:2, charge,
      attack:2, charge,
      attack:2, charge,
      attack:2, charge;
}

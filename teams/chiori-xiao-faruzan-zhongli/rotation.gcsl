active zhongli;
for let i=0; i<4; i=i+1 {
  
  zhongli skill[hold=1], dash; 
  while !.zhongli.mods.favonius-cd {
    zhongli attack; 
  }
  faruzan burst;
  while !.faruzan.mods.favonius-cd && !.xiao.burst.ready {
    faruzan attack; 
  }
  
  chiori skill:2;
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
}

active chongyun; 
for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  esco skill;
  
  shenhe burst, skill[hold=1];
  
  xianyun skill, low_plunge, burst;
  
  if .chongyun.burst.ready {
    chongyun burst;
  }
  while .chongyun.skill.ready {
    chongyun skill;
  }
  
  while .chongyun.status.xianyun-airborne-buff {
    chongyun jump;
    if .airborne {
      chongyun high_plunge[collision=rand()>0.5];
    }
    if .chongyun.status.xianyun-airborne-buff { 
      chongyun dash;
    }
  }
  
  xianyun attack:2;
  
  if .chongyun.burst.ready {
    chongyun burst;
  } else {
    chongyun attack:2;
  }
}

  navia burst;
  if !i {
    zhongli skill[hold=1], dash;
  } else {
    zhongli skill[hold=1], dash, attack;
  }
  yelan burst, attack, skill, attack;
  chongyun burst, attack, skill;
  navia attack, skill, attack:3, dash, attack:3; 
  navia skill[hold=1];
  yelan attack, skill, attack;
  navia attack:2, skill[hold=1], attack:3, dash, attack:2;
}

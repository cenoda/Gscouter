active chongyun; 
for let i=0; i<4; i=i+1 {
  nicole burst, skill;
  
  durin skill:2, burst;
  
  if .chongyun.burst.ready {
    chongyun burst;
  }
  chongyun skill;
  
  xianyun skill, low_plunge, attack, burst; 

  while .chongyun.status.xianyun-airborne-buff {
    chongyun jump;
    if .airborne {
      chongyun high_plunge[collision=rand()>0.5];
    }
    if .chongyun.status.xianyun-airborne-buff { 
      chongyun dash;
    }
  }
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active bennett;
for let i=0; i<6; i=i+1 { 
  if i {
    clorinde attack;
  }
  bennett skill, burst;
  if .fischl.skill.ready { 
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev attack, skill[hold=1], attack;
  }
  clorinde burst, attack;
  clorinde_combo();
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nicole;
nicole skill, burst;
fischl skill, attack;
chev burst, skill[hold=1];
clorinde_combo();
clorinde burst;
for let i=0; i<6; i=i+1 { 
  
  nicole skill, burst;
  if i && .fischl.skill.ready { 
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  chev skill[hold=1];
  wait(23);
  chev burst;
  clorinde_combo();
  clorinde burst;
}

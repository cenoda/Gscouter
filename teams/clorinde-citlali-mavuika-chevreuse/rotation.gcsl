fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      
    while !.element.t0.cryo && f() - StartFrame < 120 {   
      wait(1);
    }
  }
}
active clorinde;
for let i = 0; i < 4; i = i + 1 { 
  if i == 0 {
    clorinde burst;
    chev burst;
  }
  
  chevreuse skill[hold=1];
  if .chevreuse.burst.ready {
    chevreuse burst;
  }
  if .chevreuse.swap.cd {
    chevreuse attack;
  }
  
  if !i {
    citlali skill, attack;
  } else {
    citlali skill, burst, attack;
  }
  
  mav burst;
  WaitForCryo();
  mav charge:3, dash, charge:3, skill; 
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }
  
}

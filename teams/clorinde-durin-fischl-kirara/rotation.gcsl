fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active durin;
for let i=0; i<4; i=i+1 {
  durin skill, skill, burst;
  
  fischl attack, skill;
  
  kirara skill[short_hold=1];
  
  clorinde_combo();

  fischl attack:2, burst;
  
  kirara skill[short_hold=1];
  
  clorinde_combo();
}

active emilie;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack; 
    
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  if .mav.burst.ready {
    mav skill, burst, attack:1, dash;
  } else {
    mav skill, attack;
  }
  
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

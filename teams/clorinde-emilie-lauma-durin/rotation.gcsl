fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active emilie;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  durin skill, skill, burst;
  
  lauma skill;
  
  clorinde_combo();
  clorinde burst;
  clorinde_combo();
}

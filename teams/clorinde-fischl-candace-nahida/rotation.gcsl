fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 { 
  if ( i / 2 ) * 2 == i {
    nahida skill, burst;
  } else {
    nahida attack, skill, attack:2, charge;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  candace skill, attack, burst, attack;
  clorinde_combo();
  clorinde burst;
}

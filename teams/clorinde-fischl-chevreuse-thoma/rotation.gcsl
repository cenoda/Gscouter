active fischl;
fischl skill;
clorinde burst;
for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1], attack;
  thoma attack, skill, burst;
  if !.thoma.mods.favonius-cd {
    thoma attack;
  }
  fischl attack;
  if ( i / 2 ) * 2 != i {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde attack:3; 
  clorinde burst;
}

active emilie;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  if .xiangling.burst.ready {
    xiangling burst, skill, attack;
  } else {
    xiangling skill, dash, attack:3;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde attack; 
  clorinde burst;
}

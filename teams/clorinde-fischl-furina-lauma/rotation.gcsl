active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  if !i {
    lauma attack, skill, burst;
  } else {
    lauma skill[hold=1], burst;
  }
  fischl attack, skill;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  lauma attack, skill[hold=1];
  fischl attack:2, burst;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl; 
fischl burst;
kazuha burst;
collei burst;
clorinde_combo();
  
for let r=0; r<5; r=r+1 { 
  kazuha skill, high_plunge; 
  clorinde burst; 
  if .collei.burst.ready { 
    collei burst;
  } else {
    collei skill;
  }
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  if .kazuha.burst.ready { 
    kazuha burst; 
  } else {
    kazuha skill, high_plunge;
  }
  clorinde_combo();
  
}

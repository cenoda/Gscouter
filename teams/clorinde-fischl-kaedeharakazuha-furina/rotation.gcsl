fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let r=0; r<5; r=r+1 { 
  
  if .furina.skill.ready { 
    furina skill, dash, burst;
  } else {
    kazuha burst;
  }
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  kazuha skill, high_plunge; 
  clorinde_combo();
  kazuha skill, high_plunge; 
  clorinde burst;
  
}

active fischl;
for let i=0; i<6; i=i+1 {
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if ( i / 2 ) * 2 == i {
    kazuha skill, high_plunge, burst;
  } else {
    kazuha attack, skill, high_plunge;
  }
  kirara skill[short_hold=1], burst; 
  if !.kirara.mods.favonius-cd && .kirara.weapon == .keys.weapon.favoniussword {
    kirara attack;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

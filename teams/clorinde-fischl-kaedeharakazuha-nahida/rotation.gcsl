active fischl; 
fischl burst;
kazuha burst;
nahida skill, attack;
clorinde skill:1;
for let i=0; i<6; i=i+1 {
  clorinde attack:3, skill;
}
clorinde attack;
  
for let r=0; r<5; r=r+1 { 
  kazuha skill, high_plunge; 
  clorinde burst; 
  nahida skill; 
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  if .kazuha.burst.ready { 
    kazuha attack, burst; 
  } else {
    kazuha skill, high_plunge;
  }
  clorinde skill:2;
  for let i=0; i<6; i=i+1 {
    clorinde attack:3, skill;
  }
}

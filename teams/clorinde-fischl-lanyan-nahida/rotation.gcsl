fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl; 
for let i=0; i<2; i=i+1 {
  fischl burst;
  nahida skill, burst;
  lanyan skill:2;
  clorinde_combo();
  clorinde burst;
  lanyan attack;
 
  fischl attack; fischl skill;
  lanyan skill:2;
  lanyan burst;
  clorinde_combo();
  clorinde burst;
}

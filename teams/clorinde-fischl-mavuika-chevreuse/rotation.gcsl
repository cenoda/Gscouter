fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl;
fischl burst;
mav attack, skill;
chevreuse burst, skill[hold=1];
mav burst, dash;
clorinde_combo();
clorinde burst, attack:2;
for let i = 0; i < 2; i = i + 1 { 
 
  chevreuse attack, skill[hold=1], attack, burst;
  fischl attack, skill, attack; 
  mav attack, skill;
  clorinde attack;
  clorinde_combo();
  clorinde burst;
  
  chevreuse attack, skill[hold=1], burst;
  fischl attack:2, burst; 
  mav burst, attack, skill, dash;
  clorinde_combo();
  clorinde burst;
  
}

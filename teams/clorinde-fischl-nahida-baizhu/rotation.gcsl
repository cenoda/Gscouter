active fischl;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:3;
  }
  nahida attack, skill, burst, attack, charge;
  baizhu burst, skill, attack;
  fischl attack:2, burst;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  baizhu skill, attack;
  clorinde burst;
}

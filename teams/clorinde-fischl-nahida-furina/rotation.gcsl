fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
nahida skill;
for let i=0; i<2; i=i+1 { 
  
  if i {
    nahida skill, attack, charge;
  }
  furina skill, dash, burst;
  fischl attack:2, burst;
  clorinde_combo();
  clorinde burst;
  nahida attack, burst, skill, charge;
  fischl attack, skill;
  clorinde attack:3;
  clorinde_combo();
  clorinde burst;
}

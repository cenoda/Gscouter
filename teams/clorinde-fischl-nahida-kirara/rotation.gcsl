active nahida;
for let i=0; i<4; i=i+1 {
  nahida burst, skill;
  kirara skill[hold=34];
  if is_even(i) { 
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
      if .clorinde.bolratio >= 1 {
          clorinde skill;
      } else {
          clorinde attack;
      }
  }
}
active fischl; 
fischl burst;
xilonen skill, attack:2;
nahida skill, dash; pick_up_crystallize("electro");
clorinde attack;
clorinde_combo();
clorinde burst;
  
for let r=0; r<5; r=r+1 { 
  if .nahida.burst.ready {
    xilonen skill, attack:2;
    nahida skill, burst, dash; pick_up_crystallize("electro");
  } else {
    xilonen skill, burst, attack:2;
    nahida skill, dash; pick_up_crystallize("electro");
  }
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  clorinde attack;
  clorinde_combo();
  clorinde burst;
}

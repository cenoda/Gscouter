fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  fischl attack, skill;
  yelan attack, skill, burst, attack;
  clorinde_combo();
  fischl attack:2, burst;
  yelan skill, attack;
  clorinde_combo();
}

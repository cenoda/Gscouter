active zhongli;
while 1 {
  if .zhongli.skill.ready { zhongli skill[hold=1]; }
  nahida skill[hold=1];
  if .nahida.burst.ready { nahida burst; }
  if .fischl.skill.ready { fischl skill; }
  if .fischl.burst.ready { fischl burst; }
  if .clorinde.skill.ready { clorinde skill; }
  if .clorinde.burst.ready { clorinde burst; }
  while .clorinde.status.clorinde-night-watch > 0 {
    clorinde attack:2;
    if .clorinde.status.clorinde-night-watch > 0 { clorinde skill; }
  }
  while !.clorinde.skill.ready {
    clorinde attack:3;
  }
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl; 
fischl burst;
heizou skill;
nahida skill, attack;
clorinde_combo();
heizou attack; 
clorinde burst; 
for let r=0; r<4; r=r+1 { 
  nahida skill; 
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  heizou attack, charge, skill;
  clorinde_combo();
  heizou attack; 
  clorinde burst; 
  
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
      if .clorinde.bolratio >= 1 {
          clorinde skill;
      } else {
          clorinde attack;
      }
  }
}
active fischl; 
for let r=0; r<3; r=r+1 { 
  if r>0 {
  sucrose attack, charge; 
  clorinde burst; 
  fischl attack:2;
  }
  fischl burst;
  nahida skill, burst;
  if .sucrose.burst.ready { 
    sucrose skill, dash, burst, attack;
  } else {
    sucrose skill, dash, attack;
  }
  clorinde_combo();
  fischl attack, skill;
  if .sucrose.burst.ready {
    sucrose skill, dash, burst, attack;
  } else {
    sucrose skill, dash, attack;
  }
  clorinde_combo();
}

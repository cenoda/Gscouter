fn clorinde_combo() {
    clorinde skill;
    while .clorinde.status.clorinde-night-watch {
        if .clorinde.bolratio >= 1 {
            clorinde skill;
        } else {
            clorinde attack;
        }
    }
}
active fischl;
fischl burst; 
for let i = 0; i <4 ; i = i + 1 {
  
  thoma burst, attack, skill;
   if .fischl.skill.ready { 
    fischl attack, skill;
  } else if i {
    fischl attack:2, burst;
  }
  if .chev.burst.ready { 
    chev burst, skill[hold=1];
  } else {
    chev attack, skill[hold=1], attack;
  }
  clorinde_combo();
  clorinde attack; 
  clorinde burst;
  
}

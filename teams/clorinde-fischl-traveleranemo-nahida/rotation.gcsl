fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl; 
for let r=0; r<3; r=r+1 { 
  if r>0 {
  traveleranemo skill[hold=1,hold_ticks=1];
  fischl attack:2;
  }
  fischl burst;
  nahida skill, burst;
  traveleranemo skill[hold=1,hold_ticks=1], burst;
  clorinde_combo();
  fischl attack, skill;
  traveleranemo skill[hold=1];
  clorinde_combo();
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}
active fischl;
fischl burst;
chevreuse burst, skill[hold=1];
luminepyro skill, attack, burst;
clorinde attack;
clorinde_combo();
clorinde burst;
for let i=0; i<4; i=i+1 {
  clorinde attack;
  chevreuse burst, skill[hold=1]:3;
  if .fischl.skill.ready {
    fischl attack:2, skill, attack:2;
  } else {
    fischl attack:2, burst;
  }
  luminepyro skill, attack, burst;
  clorinde attack;
  clorinde_combo();
  clorinde burst;
}

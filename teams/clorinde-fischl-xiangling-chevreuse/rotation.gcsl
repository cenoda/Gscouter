fn clorinde_combo() {
    clorinde skill;
    while .clorinde.status.clorinde-night-watch {
        if .clorinde.bolratio >= 1 {
            clorinde skill;
        } else {
            clorinde attack;
        }
    }
}
active fischl;
fischl burst; 
for let i = 0; i < 5; i = i + 1 {
 
  if i {
    clorinde attack; 
  }
  chevreuse burst, skill[hold=1];
  if .xl.burst.ready { 
    xiangling burst, skill, dash;
  } else {
    xl attack:2, skill, dash;
  }
  if .fischl.skill.ready { 
    fischl skill, attack:2;
  } else if i {
    fischl attack:2, burst;
  }
  clorinde_combo();
  clorinde burst;
  
}

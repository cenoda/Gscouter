fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let r=0; r<3; r=r+1 { 
  if r {
    xilonen burst;
  }
  furina skill, dash, burst; 
  fischl attack, skill, attack;
  xilonen skill, attack:2;
  clorinde_combo();
  clorinde burst;
  xilonen skill, burst, attack:2;
  furina attack, burst;
  fischl attack:2, burst;
  clorinde_combo();
  clorinde burst;
  
}

active zhongli;
for let i=0; i<5; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  let startFrame = f();
  while i && !pick_up_crystallize("electro") && f() - startFrame < 30 { 
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  yaoyao attack:2, skill, attack:2;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

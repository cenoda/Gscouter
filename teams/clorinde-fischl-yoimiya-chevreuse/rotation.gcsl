active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  if ( i / 2 ) * 2 == i { 
    chev burst, skill[hold=1], attack, dash;
  } else {
    chev jump, skill[hold=1], attack:2, dash;
  }
  if i && .fischl.skill.ready {
    fischl attack, skill;
  } else if i {
    fischl attack:2, burst;
  }
  yoimiya burst, attack; 
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

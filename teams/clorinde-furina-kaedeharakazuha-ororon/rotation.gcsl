fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash, attack, burst;
  ororon skill, burst;
  kazuha skill, high_plunge, burst;
  clorinde_combo();
  kazuha skill, high_plunge;
  clorinde burst;
}

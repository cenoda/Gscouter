fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let i=0; i<3; i=i+1 {
  if !i {   
    furina skill, dash, burst, attack;
    xilonen skill, attack:2;  pick_up_crystallize("hydro");
  } else {  
    xilonen skill, attack:2;  pick_up_crystallize("electro");
    furina skill, dash, burst, attack;
  }
  mavuika skill, attack;
  clorinde_combo();
  clorinde burst;
  xilonen skill, attack:2;  pick_up_crystallize("electro");
  mavuika burst, charge:2, dash, charge, skill, dash;
  clorinde_combo();
  clorinde burst;
}

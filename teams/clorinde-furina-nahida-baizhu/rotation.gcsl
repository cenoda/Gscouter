fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  furina skill, dash, burst;
  baizhu skill, burst, attack;
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  } 
  baizhu skill, attack;
  clorinde_combo();
}

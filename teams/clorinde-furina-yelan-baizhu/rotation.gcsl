fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  baizhu skill, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  clorinde_combo();
  yelan attack, skill, attack;
  
  clorinde_combo();
  
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active columbina;
for let i=0; i<4; i=i+1 { 
  if is_even(i) {
    columbina skill;
    ineffa skill, burst;
  } else {
    columbina skill, burst;
    ineffa skill, attack;
  }
  
  if .kazuha.burst.ready {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  clorinde_combo();
  kazuha skill, high_plunge;
  clorinde burst;
}

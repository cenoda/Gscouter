fn kinich_burst_support() {
  kinich skill;
  for let i=0; i<2; i=i+1 {
    while .kinich.nightsoul.points < 20 {
      kinich attack;
    }
    kinich skill[hold=1];
  }
  kinich burst;
}
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active kinich; 
for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  xilonen skill, attack:2; pick_up_crystallize("any");
  kinich_burst_support();
  
  fischl attack:2, burst;
  
  xilonen skill, attack:2; pick_up_crystallize("any");
  
  clorinde_combo();
  
  clorinde burst;
  
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl;
for let r=0; r<4; r=r+1 {
  fischl attack, skill;
  
  if .kirara.sets.ap == 4 {
    xilonen skill, attack:2; 
    
    kirara skill[short_hold=1]; pick_up_crystallize("any");
    
  } else {
    kirara skill[short_hold=1];
    
    xilonen skill, attack:2;
  }
  clorinde_combo();
  fischl attack:2, burst;
  
  if .kirara.sets.ap == 4 {
    xilonen skill, attack:2; 
    
    kirara skill[short_hold=1]; pick_up_crystallize("any");
  } else {
    kirara skill[short_hold=1];
    
    xilonen skill, attack:2;
  }
  
  clorinde_combo();

}

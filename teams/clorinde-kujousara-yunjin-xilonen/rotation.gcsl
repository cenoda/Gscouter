fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active sara; 
for let r=0; r<2; r=r+1 { 
  
  sara skill, aim;
  wait(12);
  yunjin skill; 
  xilonen skill, attack:2;
  yunjin burst;
  sara dash; pick_up_crystallize("electro"); 
  sara burst;
  clorinde_combo();
  
  yunjin skill; 
  sara skill; 
  clorinde burst;
  xilonen skill, attack:2;
  yunjin burst;
  sara aim; pick_up_crystallize("electro"); 
  clorinde_combo();
  
 }

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active lauma;
for let i = 0; i < 4; i = i + 1 {
  lauma burst, skill[hold=.dew>1];
  
  xq skill, dash, burst, attack;
  
  durin skill, skill, burst;
  
  clorinde_combo();
  
  lauma skill[hold=1];
  
  durin skill, skill;
  
  clorinde_combo();
  
}

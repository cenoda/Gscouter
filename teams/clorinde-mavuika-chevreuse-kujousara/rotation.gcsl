fn clorinde_combo_opener() { 
  clorinde skill, attack:3, skill;
  set_player_pos(0, -5); 
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}
fn clorinde_combo_rotation() { 
  clorinde skill, attack, skill; 
  set_player_pos(0, -5); 
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}
active mavuika; 
sara skill;
mav attack, skill; 
chevreuse burst, skill[hold=1];
mav burst, charge:2, dash, charge, dash; 
sara burst;
clorinde_combo_opener();
for let i = 0; i < 4; i = i + 1 {
  
  sara aim; 
  chevreuse attack, skill[hold=1], attack; 
  clorinde burst;
  mav skill, burst, charge, dash, charge, dash; 
  if .sara.burst.ready {
    sara skill, burst;
  } else {
    sara attack, skill, attack; 
  }
  clorinde_combo_rotation();
  
}

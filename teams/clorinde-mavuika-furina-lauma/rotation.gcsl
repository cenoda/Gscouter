fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active lauma; 
lauma skill;
for let i = 0; i < 4; i = i + 1 {
  
  if i {
    lauma skill[hold=1];
  }
  furina skill, dash, burst;
  mavuika skill, burst;
  clorinde_combo();
  lauma skill[hold=1];
  clorinde burst;
  clorinde_combo();
}

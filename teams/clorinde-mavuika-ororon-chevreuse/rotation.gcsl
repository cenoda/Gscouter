let MAX_NA_COUNT = 18;  
active mavuika;
fn clorinde_combo() {
  clorinde skill;
  let na_count = 0;
  while .clorinde.status.clorinde-night-watch && na_count < MAX_NA_COUNT {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
      na_count = na_count + 1;
    }
  }
}
for let i = 0; i < 4; i = i + 1 {
  
  if i {
    mavuika attack;
  }
  mavuika skill;
  ororon skill, burst;
  chev burst, skill[hold=1];
  mavuika burst, charge:2, dash, charge:2, dash,charge:2, dash, charge:2, dash; 
  clorinde_combo();
}

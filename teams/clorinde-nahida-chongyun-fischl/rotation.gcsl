fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active clorinde;
clorinde burst;
for let i = 0; i < 4; i = i + 1 {
  chongyun skill;
  nahida skill, attack, charge;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }
  clorinde_combo();
  clorinde_combo();
}

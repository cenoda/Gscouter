fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 {
  
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  durin skill:2, burst;

  nahida skill, attack, charge;
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }
  clorinde_combo();
}

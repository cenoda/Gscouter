fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 {
  
  nahida skill, attack;

    nahida charge;

    emilie burst;

  thoma skill, attack, burst;
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }
  clorinde_combo();
  
}

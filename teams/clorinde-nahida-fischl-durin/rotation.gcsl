fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active durin;
for let i=0; i<4; i=i+1 {
  
  durin skill, skill, burst;
  nahida skill, attack;
  fischl skill, attack;
  clorinde_combo();
  clorinde burst;
  fischl attack:2, burst;
  clorinde_combo();
}

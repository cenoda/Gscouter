active nahida;
nahida skill;
for let i=0; i<4; i=i+1 {
  
  if !is_even(i) {
    nahida skill, attack, burst;
  } else if i > 0 {
    nahida skill, attack, charge;
  }
  
  if i == 0 {
    mav skill, burst, dash;
  } else if .mav.burst.ready {
    mav burst, charge:1, skill, dash;
  } else {
    mav skill, attack;
  }
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

active nahida;
for let i=0; i<4; i=i+1 {
  if i == 0 {
    nahida skill;
  } else {
    nahida skill, attack, charge;
  }
  
  mona dash:1, burst, attack;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  mona attack, skill, attack;
  
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

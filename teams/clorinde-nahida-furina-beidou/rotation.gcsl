fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}
active nahida; 
for let i=0; i<4; i=i+1 {
  nahida skill, attack, burst;
  
  furina skill, dash, burst;
  
  beidou skill[counter=rand_counter()], burst;
  
  clorinde_combo();
  beidou skill[counter=rand_counter()];
  
  if !.clorinde.skill.ready {
    clorinde burst;
  }
  clorinde_combo();
}

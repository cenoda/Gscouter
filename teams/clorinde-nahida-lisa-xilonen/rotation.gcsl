fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active lisa;
lisa attack;
for let i=0; i<4; i=i+1 {
  
  xilonen skill, attack:2;
  
  lisa burst;
  
  nahida skill; 
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  clorinde_combo();
  clorinde burst; 

  xilonen skill, attack:2;
  clorinde_combo();
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active furina;
for let r=0; r<2; r=r+1 {
  
  furina skill, dash, burst;
  ororon skill, burst;
  lynette skill, attack;
  clorinde_combo();
  clorinde burst;
  
  lynette skill, burst;
  ororon skill, burst;
  lynette skill, attack;
  clorinde_combo();
  clorinde burst;
}

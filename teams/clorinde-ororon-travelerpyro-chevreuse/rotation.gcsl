fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}
active ororon;
ororon burst, skill;
chevreuse burst, skill[hold=1]:3;
luminepyro skill, burst;
clorinde_combo();
clorinde burst;
for let i=0; i<4; i=i+1 {
  clorinde attack:2, charge;
  ororon skill, burst;
  chevreuse burst, skill[hold=1]:3;
  luminepyro skill, burst;
  clorinde_combo();
  clorinde burst;
}

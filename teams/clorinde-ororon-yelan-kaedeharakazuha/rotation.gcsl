fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active yelan;
for let r=0; r<4; r=r+1 { 
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon skill, burst;
  
  kazuha skill, high_plunge;
  
  clorinde_combo();
  
  kazuha skill, high_plunge;
  if .clorinde.burst.ready {
    clorinde burst;
  } else {
    kazuha burst;
  }
}

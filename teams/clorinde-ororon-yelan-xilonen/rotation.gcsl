fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active yelan;
for let r=0; r<4; r=r+1 { 
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon burst, skill, attack;
  
  xilonen skill, attack:2; pick_up_crystallize("any");

  clorinde_combo();
  
  xilonen skill, attack:2; pick_up_crystallize("any");

  clorinde burst;
}

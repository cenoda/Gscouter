fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active fischl; 
for let i=0; i<4; i=i+1 {
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  xilonen skill, attack:2;
  
  tighnari skill, aim;
  if i > 0 && .tighnari.burst.ready {
    tighnari burst, aim:2;
  } else {
    tighnari aim:2;
  }
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }

}

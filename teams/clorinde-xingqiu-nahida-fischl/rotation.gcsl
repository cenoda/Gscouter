fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active nahida;
for let i=0; i<3; i=i+1 { 
  
  nahida skill, burst;
  xq skill, dash, burst, attack;
  fischl attack, skill, attack;
  clorinde_combo();
  clorinde burst;
  fischl attack:2, burst;
  clorinde_combo();
  
}

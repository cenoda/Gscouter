active yae;
for let i=0; i<4; i=i+1 {
  yae skill:3;
  if .chev.burst.ready {
    chev burst, skill[hold=1], attack;
  } else {
    chev attack, skill[hold=1], attack, dash;
  }
  xinyan burst, dash;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}
active yae;
yae skill:3;
luminepyro skill, burst;
chevreuse burst, skill[hold=1];
clorinde_combo();
clorinde burst;
for let i=0; i<4; i=i+1 {
  if .yae.burst.ready {
    yae burst, skill:3;
  } else {
    clorinde attack, charge, attack;
    yae skill:3;
  }
  chevreuse burst, skill[hold=1]:3;
  luminepyro skill, burst;
  clorinde_combo();
  clorinde burst;
}

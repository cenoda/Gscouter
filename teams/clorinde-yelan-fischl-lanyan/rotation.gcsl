fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active yelan;
for let r=0; r<4; r=r+1 { 
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  }
  while !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst;
  
  if .fischl.burst.ready { 
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  lanyan attack, skill:2;
  
  clorinde_combo();
  
  if .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax {
    lanyan attack, burst;
  } else {
    lanyan attack:2;
  }
  
  clorinde burst;
}

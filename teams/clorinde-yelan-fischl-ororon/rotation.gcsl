fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active yelan;
for let r=0; r<4; r=r+1 { 
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } 
  if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon burst, attack, skill;
  
  if .fischl.skill.ready { 
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  yelan attack:2, dash, attack:2; 
  
  clorinde_combo();
  clorinde burst;
}

active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill, attack, burst, attack;
  zhongli skill[hold=1], dash, attack;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  nahida skill, attack, burst, attack;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  if .clorinde.burst.ready {
    clorinde burst;
  } else {
    clorinde attack:3, dash; 
  }
}

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active zl;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  if !.chiori.skill.ready && .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde_combo();
  clorinde burst; 
  zhongli burst;
}

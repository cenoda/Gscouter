active lauma;
lauma attack;
for let i=0; i<5; i=i+1 {
  if .columbina.burst.ready {
    columbina burst;
  }
  if i == 0 {
    columbina skill, attack;
  } else {
    columbina skill;
  }
  
  if .fischl.skill.ready{
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  mona skill, burst, attack;
  
  lauma attack, skill[hold=1], burst;
  columbina attack, charge, dash, charge, dash, charge;
  mona attack:2, charge;
  columbina attack, charge, dash, charge, dash, charge;
  
}
columbina attack;

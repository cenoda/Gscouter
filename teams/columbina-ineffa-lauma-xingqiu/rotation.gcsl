active lauma;
lauma attack;
for let i=0; i<6; i=i+1 {
  
  columbina skill, burst;
  
  if .ineffa.burst.ready {
    ineffa burst;
  }
  ineffa skill;
  
  xingqiu skill, dash, burst;
  
  lauma attack, skill[hold=.dew>0], burst;
  
  columbina attack, charge, dash, charge, dash;
  columbina attack, charge, dash;
  columbina attack, charge;
  
  xingqiu attack, charge;
  
  columbina attack, charge, dash;
  columbina attack, charge, dash;
  columbina attack, charge;
}
columbina dash, attack;

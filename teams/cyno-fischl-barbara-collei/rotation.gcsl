active barbara;
for let i=0; i<4; i=i+1 {
  if .barbara.skill.ready {
    barbara attack:3, skill, dash;
  } else {
    barbara attack:4;
  }
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  collei skill;
  if .collei.burst.ready {
    collei burst;
  }
  cyno burst;
  while .cyno.burst.cd > 300 {
    if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 3 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  print("end");
}

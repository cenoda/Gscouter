active fischl;
cyno skill;
for let i=0; i<4; i=i+1 {
  albedo skill, attack;
  collei skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  cyno burst;
  
  while .cyno.burst.cd > 280 {
    if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 3 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  print("end");
}

active fischl;
for let i=0; i<4; i=i+1 { 
  fischl skill, attack;
  
  if !is_even(i) {
    mav burst, skill, attack;
  } else {
    mav dash, skill;
  }
  
  chev skill[hold=1], burst;
  
  fischl attack:2, burst;
  
  cyno burst, attack:2, skill;
  while .fischl.skill.cd>30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

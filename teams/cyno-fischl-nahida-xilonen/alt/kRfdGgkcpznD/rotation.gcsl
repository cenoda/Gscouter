active cyno;
cyno skill;
for let i=0; i<4; i=i+1 {
  let Startframe = f();
  nahida skill, burst, attack, charge;
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  xilonen skill, attack:2;
  cyno burst;
  while f() - Startframe < 1260 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 5 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

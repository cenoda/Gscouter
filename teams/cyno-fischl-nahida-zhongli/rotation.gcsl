active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  zhongli attack, skill[hold=1], dash;
  let startFrame = f();
  while !pick_up_crystallize("electro") && f() - startFrame < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  nahida skill, burst, attack;
  fischl attack:2, burst;
  cyno skill, burst,
	     attack:2, skill, attack:3, dash,
	     attack:2, skill, attack:3, dash,
	     attack:2, skill, attack:3, dash, 
       attack:2, skill, attack:3, dash,
	     attack:2, skill, attack:3, dash,
       attack:2, skill, attack:3, dash, 
       attack:2, skill;
}

active fischl;
for let i=0; i<4; i=i+1 { 
  fischl attack, skill;
  
  furina skill, dash, attack, burst;
  
  esco skill, burst;
  
  fischl attack:2, burst;
  
  cyno skill, burst, attack:4, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

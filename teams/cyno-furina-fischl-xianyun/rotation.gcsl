active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  
  furina skill, dash, attack, burst;
  
  xianyun attack, skill, low_plunge, attack, burst, attack;
  
  fischl attack:2, burst;
  
  let plunges = 0;
  cyno skill, burst, attack; 
  
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 { 
      cyno skill;
    } else if .cyno.status.xianyun-airborne-buff {
      cyno jump;
      if .airborne {
        cyno low_plunge[collision=rand()>0.5], attack;
        plunges = plunges + 1; print(plunges);
      }
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  
}

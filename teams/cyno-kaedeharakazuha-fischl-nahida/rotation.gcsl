active fischl;
for let i=0; i<4; i=i+1 {
	fischl skill;
	kazuha skill, high_plunge, attack;
	nahida skill, burst, attack:2;
	fischl attack:2, burst;
	kazuha skill, high_plunge, burst;
	cyno burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.normal == 5 {
      cyno  skill;
    } else {
      cyno attack;
    }
  }
}

active fischl;
for let i=0; i<4; i=i+1 { 
  fischl skill, attack;
  
  if .mav.burst.ready {
    mav burst, skill, attack;
  } else {
    mav skill, attack;
  }
  
  if .kirara.burst.ready {
    kirara burst;
  }
  kirara skill[short_hold=1];
  
  fischl attack:2, burst;
  
  cyno skill, burst;
  while .fischl.skill.cd > 30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 18 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

active fischl;
for let i=0; i<4; i=i+1 { 
  fischl skill, attack;

  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev attack, skill[hold=1];

  }
  
  fischl attack:2, burst;
  
  cyno skill, burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

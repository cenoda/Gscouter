active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, attack:1, charge;
  } else {
    nahida attack, charge;
  }
  
  diona skill[hold=1], burst;
  
  fischl attack:2, burst;
  
  cyno burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill;
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xianyun attack, skill, low_plunge, burst; 
  
  fischl attack:2, burst;
  
  let plunges = 0;
  cyno skill, burst, attack, skill; 
  
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready { 
      cyno skill;
    } else if .cyno.status.xianyun-airborne-buff {
      cyno jump;
      if .airborne {
        cyno low_plunge[collision=rand()>0.5], attack;
        plunges = plunges + 1; print(plunges);
      }
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  
}

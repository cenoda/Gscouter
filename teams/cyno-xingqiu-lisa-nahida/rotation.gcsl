active nahida;
for let i=0; i<4; i=i+1 {
  if i==0 {
    nahida skill, burst;
  } else {
    nahida skill, attack, burst;
  }
  xingqiu skill, dash, burst, attack;
  lisa burst;
  cyno skill, burst;
  while .cyno.burst.cd > 470{
    if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  lisa skill[hold=1], attack:3;
  print("end");
}

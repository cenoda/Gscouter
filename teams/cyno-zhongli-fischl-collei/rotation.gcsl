active fischl;
fischl aim;
for let i=0; i<4; i=i+1 {
  zhongli attack, skill[hold=1], dash;
  collei skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  cyno burst;
  let src = f();
  
  while .cyno.burst.cd > 335 {

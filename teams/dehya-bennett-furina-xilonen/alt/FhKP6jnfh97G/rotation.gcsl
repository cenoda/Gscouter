active dehya;
for let i=0; i<5; i=i+1 {
  dehya skill;
  if i {
    furina skill, dash, burst, charge, attack:4, dash, charge;
    xilonen burst;
  } else {
    furina skill, dash;
    xilonen skill, attack:2, burst;
    furina burst, charge, attack:4, dash, charge;
  }
  bennett skill, burst;
	xilonen skill, attack:2;
  dehya burst, attack:15;
	xilonen skill, attack:2;
	bennett skill, dash, attack;
  dehya skill;
}

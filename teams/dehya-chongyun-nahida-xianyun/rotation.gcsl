fn DehyaPlunge() {
  dehya jump;
  if .airborne {
    dehya high_plunge[collision=rand()>0.5];
  }
}
active dehya; 
for let i = 0; i < 4; i = i + 1 {
  if is_even(i) {
    nahida skill, burst;
  } else {
    nahida skill, attack, charge;
  }
  
  chongyun burst, skill;
  
  xianyun skill, high_plunge, burst;
  
  dehya attack, skill;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya skill;
  DehyaPlunge();
}

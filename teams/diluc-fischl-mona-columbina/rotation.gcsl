active diluc; 
for let i=0; i<6; i=i+1 {
  fischl skill, attack;
  bina skill;
  if .bina.burst.ready {
    bina burst;
  }
  mona burst, attack;
  diluc burst, attack, skill;
  fischl attack:2, burst;
  mona attack:2, charge;
  diluc skill, attack:2, skill, attack;
  mona attack, skill, attack:2;
  diluc skill, attack, skill, skill;
}

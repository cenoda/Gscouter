active diluc; 
for let r = 0; r < 4; r = r + 1 { 
  furina skill, dash, attack, burst;
  if .xianyun.weapon == .keys.weapon.ttds {
    lynette skill:2, burst;
    
    xianyun skill, high_plunge, burst;
    
    diluc skill:3, burst;
  } else {
    lynette skill:2;
    
    xianyun skill, high_plunge, burst;
    
    lynette burst;
    
    diluc skill:2, burst, attack:1;
  }
  for let h=0; h<8; h=h+1 {
    diluc jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.50];
    }
    if .diluc.status.xianyun-airborne-buff {
      diluc dash;
    }
  }
  diluc skill:3;
}

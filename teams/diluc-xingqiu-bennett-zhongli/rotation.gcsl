active xingqiu;
while 1 {
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  if .bennett.burst.ready { bennett burst; }
  bennett skill;
  zhongli skill[hold=1];
  if .diluc.burst.ready { diluc burst; }
  diluc skill, skill, skill;
  while .diluc.status.diluc-q > 0 {
    diluc attack:4;
  }
  while !.xingqiu.skill.ready || !.zhongli.skill.ready || !.diluc.skill.ready {
    diluc attack:4;
  }
}

fn DoriPlunge() {
  dori jump;
  if .airborne {
    dori high_plunge[collision=rand()>0.5];
  }
}
active dori; 
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash;
  if !.furina.burst.ready { 
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge;
  if !.xianyun.burst.ready {
    xianyun attack;
  }
  xianyun burst;
  
  rosaria skill, burst;
  
  dori skill;
  while .dori.status.xianyun-airborne-buff {
    DoriPlunge();
    if .dori.skill.ready {
      dori skill;
    } else if !.dori.status.xianyun-airborne-buff { 
      dori attack;
    } else {
      dori dash;
    }
  }
  
  rosaria skill;
  
  while .furina.skill.cd { 
    switch {
      case .dori.burst.ready:
        dori burst;
      case .dori.skill.ready:
        dori skill;
      case .dori.normal > 2 && .dori.dash.ready && .stam > 18:
        dori dash;
      default:
        dori attack;
    }
  }
  
  print("done");
  
}

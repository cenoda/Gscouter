active dori; 
nahida skill, burst;
for let i=0; i<4; i=i+1 {
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else if i > 0 {
    nahida skill, attack, charge;
  }
  
  durin skill:2, burst;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  dori skill, attack:2, dash, attack:2, burst;
  dori skill, attack:2, dash, attack:2;
  
  nahida skill, attack, charge;
  
  dori skill, attack:2, dash, attack:2;
}

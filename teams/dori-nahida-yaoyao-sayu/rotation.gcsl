active dori; 
dori burst;
sayu skill[short_hold=1];
for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  yaoyao skill, attack;
  
  dori skill, attack:2, dash, attack:2;
  
  sayu skill[short_hold=1];
  
  dori skill, attack:2, dash, attack:2;
  
  if .sayu.burst.ready {
	  sayu burst;
  } else {
    nahida attack, charge;
  }
  
  dori skill, attack:2, burst;
  
  sayu skill[short_hold=1];
  
  print("done");
}

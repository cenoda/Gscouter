active fischl;
fischl skill, attack;
for let i=0; i<4; i=i+1 {
  let StartFrame = f();
  durin skill, burst, skill;
  bennett attack, skill, burst;
  if !is_even(i) {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  } 
  chev burst, skill[hold=1]:3;
  while f() - StartFrame < 1080 {
    if .durin.normal == 4 {
      durin dash;
    }
    durin attack;
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
  }
}

active furina;
for let i = 0; i < 4; i = i + 1 {
  furina attack, skill, burst;
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  durin skill, burst, attack;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack:3;
  if is_even(i) {
    fischl attack, skill[recast=1]; 
  } else {
    durin attack, dash;
  }
  durin attack:4;
}

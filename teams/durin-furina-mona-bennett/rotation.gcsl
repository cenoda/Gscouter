active furina;
for let i=0; i<4; i=i+1 {
  furina swap;
  let StartFrame = f();
  furina skill, dash, attack, burst;
  bennett skill, burst;
  mona burst, attack;
  durin skill, attack, burst;
  mona attack:2, skill, attack:2;
  durin swap;
  while f() - StartFrame < 1110 {
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
    durin attack;
  }
  bennett skill, attack;
}

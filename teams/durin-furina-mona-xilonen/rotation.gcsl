active xilonen;
for let i=0; i<4; i=i+1 {
  let StartFrame = f();
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  mona burst, attack;
  durin skill, attack, burst;
  mona attack:2, skill, attack:2;
  durin swap;
  while f() - StartFrame < 900 {
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
    durin attack;
  }
  xilonen skill, attack:2;
  while f() - StartFrame < 1200 {
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
    durin attack;
  }
}

active nicole;
for let i=0; i<4; i=i+1 {
  nicole skill, burst;
  citlali skill, burst, attack;
  durin skill, attack, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge, jump, attack:2;
  }
}

active nahida;
while 1 {
  nahida skill[hold=1];
  if .xiangling.burst.ready { xiangling burst; }
  xiangling skill;
  if .bennett.burst.ready { bennett burst; }
  bennett skill;
  emilie skill;
  if .emilie.burst.ready { emilie burst; }
  if .nahida.burst.ready { nahida burst; }
  emilie attack:3;
  while !.emilie.skill.ready || !.nahida.skill.ready || !.xiangling.skill.ready {
    emilie attack:3;
  }
}

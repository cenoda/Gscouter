active eula; 
for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  escoffier skill;
  
  xianyun skill, low_plunge, burst;
  
  eula skill, attack;
  
  if .amy.skill.ready { 
    amy attack:1, skill;
  } else { 
    amy attack:2, burst; 
  }

  if .eula.burst.ready && .eula.energy == .eula.energymax {
    eula burst, walk, attack, skill[hold=1];
  } else { 
    eula attack:2, skill[hold=1];
  }
  
  while .eula.status.xianyun-airborne-buff {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5];
    }
    if .eula.status.xianyun-airborne-buff { 
      eula dash;
    }
  }
  
}

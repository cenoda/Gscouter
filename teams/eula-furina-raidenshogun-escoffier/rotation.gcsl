active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  esco skill, burst;
  
  eula skill;
  if !.eula.burst.ready {
    eula attack;
  }
  eula burst, walk, attack:4, skill[hold=1], walk[f=11], attack:4;
  
  raiden burst, attack:4, skill, dash, attack:4, dash, attack:2;
}

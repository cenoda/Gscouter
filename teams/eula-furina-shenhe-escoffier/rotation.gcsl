active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  escoffier skill, burst;
  
  shenhe burst, skill;
  
  eula skill;
  if !.eula.burst.ready {
    eula attack;
  }
  eula burst, skill, attack:4, dash, attack:2, skill[hold=1], walk[f=11], attack:2;
  
  shenhe skill, attack:2;
  
  eula attack:2;
}

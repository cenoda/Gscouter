active raiden;
for let i=0; i<4; i=i+1 {
	raiden skill;
	rosaria skill;
	eula skill, attack;
	zhongli skill[hold=1], dash;
	rosaria burst;
	eula swap;
    while !.eula.burst.ready {
      if .eula.skill.ready {
        eula skill;
      } else {
        eula attack;
      }
    }
	eula burst, walk, attack:4, skill[hold=1], attack:4;
	rosaria skill;
	eula attack:2;
	raiden burst,  attack:3,charge, attack:3, charge, attack:2;
}

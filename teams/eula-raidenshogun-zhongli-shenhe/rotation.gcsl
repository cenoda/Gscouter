active raiden;
    raiden skill;
for let i=0; i<4; i=i+1 {
	shenhe skill[hold=1], attack;
	eula skill, attack;
	zhongli attack, skill[hold=1], dash;
	shenhe burst;
	eula swap;
    while !.eula.burst.ready {
      if .eula.skill.ready {
        eula skill;
      } else {
        eula attack;
      }
    }
	eula burst, attack:4,skill[hold=1], attack:4;
	shenhe skill, attack;
	eula attack:2;
	raiden burst,  attack:4, skill, attack:4, dash, attack:4;
}

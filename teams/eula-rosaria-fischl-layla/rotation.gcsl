active eula;
for let x=0; x<4; x=x+1{
  if .fischl.skill.ready {
	fischl attack, skill;
  } else {
	fischl attack:2, burst;
  }
  if !.rosaria.skill.ready {
    rosaria attack;
  }
  rosaria skill;
  eula skill, attack;
  layla burst, skill;
  if !.layla.mods.favonius-cd {
    layla attack;
  }
  rosaria burst;
  eula burst, walk, attack:4, skill[hold=1], attack:4;
  rosaria skill, attack;
  eula attack:4;
}

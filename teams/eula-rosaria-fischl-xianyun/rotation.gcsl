active eula; 
for let i = 0; i < 4; i = i + 1 {
  amy attack;
  if .amy.skill.ready { 
    amy skill; 
  } else { 
    amy attack, burst; 
  }
  
  xianyun skill, low_plunge, burst;
  
  eula skill, attack;
  
  rosaria skill, burst;

  if .eula.burst.ready && .eula.energy == .eula.energymax  {
    eula burst, walk, attack, skill[hold=1];
  } else { 
    eula skill[hold=1];
  }
  
  while .eula.status.xianyun-airborne-buff {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5];
    }
    if .eula.status.xianyun-airborne-buff { 
      eula dash;
    }
  }
  
}

active eula; 
for let x = 0; x < 4; x = x + 1 {
  yae skill:3;
  
  amy attack;
  if .amy.skill.ready { 
    amy skill; 
  } else { 
    amy attack, burst; 
  }

  xianyun skill, high_plunge, burst;

  if .eula.burst.ready && .eula.energy == .eula.energymax {
    eula skill, burst, skill[hold=1];
    
    while .eula.status.xianyun-airborne-buff {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      if .eula.status.xianyun-airborne-buff { 
        eula dash;
      }
    }
  } else {
    eula skill, attack:2;
    
    while .eula.status.xianyun-airborne-buff {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      if .eula.skill.ready {
        eula skill[hold=1];
      } if .eula.status.xianyun-airborne-buff { 
        eula dash;
      }
    }
  }
  
  print("done");
}

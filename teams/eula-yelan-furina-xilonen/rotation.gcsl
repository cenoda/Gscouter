active xilonen;
for let i = 0; i < 5; i = i + 1 {
  xilonen burst;
  furina skill, dash, burst;
  eula attack:2, skill;
  yelan burst, attack, skill, attack;
  xilonen skill, attack:2;
  eula skill, burst, attack:3, skill[hold=1], attack:4;
  yelan attack, skill, attack;
  xilonen skill, attack:2;
}

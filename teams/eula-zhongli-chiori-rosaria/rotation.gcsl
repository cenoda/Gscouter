active eula;
for let i = 0; i < 6; i = i + 1 {
  zhongli skill[hold=1];
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  chiori skill:2;
  rosaria burst, skill;
  eula attack,skill;
  if .eula.burst.ready{
    eula burst,walk;
  } else {
    eula attack:2,dash;
  }
  eula attack:4, skill[hold=1], attack:4,dash;
}
eula attack;

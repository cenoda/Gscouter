active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  faruzan skill, burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  faruzan aim[weakspot=rand()>0.1]:2, skill, aim[weakspot=rand()>0.1]:2;
  
  bennett skill, attack;
  
  xl attack:4;
  
  faruzan skill, aim[weakspot=rand()>0.1]:2;
  
  bennett skill, attack;
  
}

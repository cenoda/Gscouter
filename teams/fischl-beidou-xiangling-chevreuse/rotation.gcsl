active fischl;
for let i = 0; i < 4; i = i + 1 {
  if ( i / 2 ) * 2 == i {
    fischl attack, skill;
  } else {
    fischl attack:2, dash;
  }
  chev burst, skill[hold=1], attack;
  xiangling burst, skill, dash;
  beidou skill, burst, dash;
  fischl attack:2, burst;
  xiangling attack:4;
  chev attack:3;
  if !.chev.mods.favonius-cd {
    chev dash, attack;
  }
  beidou skill, attack:2, jump; 
  xiangling attack:4;
  chev attack:3;
}

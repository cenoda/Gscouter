active fischl;
for let i=0; i<4; i=i+1 { 
  fischl skill, attack;
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  thoma skill, attack, burst;
  fischl attack:2, burst;
  cyno skill, burst;
  while .fischl.skill.cd>30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

active fischl;
for let i=0; i<3; i=i+1 { 
  fischl skill,attack;
  nahida skill,attack:2,burst;
  thoma skill, burst;
  fischl attack:2,burst;
  cyno burst,skill;
   while .fischl.skill.cd>30{
   if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
    }
}

active yae;
for let x = 0; x < 3; x = x + 1 {
  if x==0 {
    yae skill:3;
  } else {
    yae  skill, attack, skill, attack, skill;
  }
  furina skill, dash, burst;
  baizhu skill, burst, attack;
  fischl skill, attack;
  yae attack:2;
  if .yae.burst.ready {
    yae burst;
  } else {
    yae charge, jump;
  } 
  yae skill:3,
      attack:1, charge, dash,
      attack:2; 
  baizhu attack:2, skill, attack:2;
  fischl attack:2, burst;
  yae attack:1, charge, jump,
      attack:1, charge, jump;
  baizhu  attack:2, charge, attack:2; 
  
  print("Rotation Done");
}

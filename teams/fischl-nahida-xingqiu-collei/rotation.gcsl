active fischl;
while 1 {
  fischl skill;
  if .fischl.burst.ready { fischl burst; }
  nahida skill[hold=1];
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  collei skill;
  if .collei.burst.ready { collei burst; }
  if .nahida.burst.ready { nahida burst; }
  while !.fischl.skill.ready {
    fischl attack;
  }
}

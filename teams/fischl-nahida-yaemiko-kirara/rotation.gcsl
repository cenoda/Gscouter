active fischl;
for let i=0; i<4; i=i+1 { 
  fischl skill;
  nahida skill, burst;
  yae skill, attack, skill, attack, skill, attack:2;
  kirara skill[short_hold=1], burst;
  fischl attack:2, burst;
  nahida skill, attack:4,
         dash, attack:4,
         skill, attack:3;
  yae skill, attack, skill, attack, skill, attack:2;
}

active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill;
  nahida skill, attack, burst, attack;
  yelan skill, burst, attack:2;
  fischl attack:2, burst;
  cyno burst, attack, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.normal == 5 {
      cyno  skill;
    } else {
      cyno attack;
    }
  }
}

active fischl;
for let i = 0; i < 5; i = i + 1 {
  fischl attack, burst;
  xingqiu burst, attack;
  kazuha burst;
  yelan attack, burst, attack, skill, attack:8;
  kazuha attack, skill, high_plunge, attack;
  fischl skill, attack;
  xingqiu skill, dash, attack;
  yelan attack:6, skill, attack:2;
  if .yelan.breakthrough {
    yelan aim;
  }
  yelan attack:6;
  kazuha skill, high_plunge, attack;
}

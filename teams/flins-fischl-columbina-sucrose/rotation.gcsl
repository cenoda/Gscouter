active columbina;
for let i=0; i<6; i=i+1 {
  columbina skill;
  if is_even(i) {
    columbina attack;
  } else {
    columbina burst;
  }
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if .sucrose.burst.ready && is_even(i) {
    sucrose burst, attack, skill, dash;
  } else {
    sucrose attack, skill, dash;
  }
  flins skill,
        skill, attack, burst, 
        attack:3, dash, attack:3, dash, attack:3, dash, attack,
        skill, burst, 
        attack:3, dash, attack:3, dash, attack:3, dash, attack;
  
  if .flins.status.manifest-flame {   
    flins skill;
    if .flins.energy >= 30 {
      flins burst;
    }
  }
  if !is_even(i) {
    flins attack, dash; 
  }
}

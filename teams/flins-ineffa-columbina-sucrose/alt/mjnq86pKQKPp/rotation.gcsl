active ineffa;
for let i=0; i<6; i=i+1 {
  
  if !is_even(i) {
    ineffa skill, burst;
    columbina skill, attack;
  } else {
    ineffa skill;
    if i {
      ineffa attack;
      sucrose swap;         print("Sucrose N2C > Columbina    E Q");
      sucrose attack:2, charge; 
      
    }
    columbina skill, burst;
  }
  
  if !is_even(i) && .sucrose.burst.ready {
    sucrose attack, burst;
  } else if .sucrose.skill.ready {
    sucrose swap; wait(8); 
    sucrose attack, skill, dash;
  } else {
    sucrose attack, charge;
  }
  
  flins skill, attack, 
        skill, burst, 
        attack:4, dash, attack:2, 
        skill, attack, burst, 
        attack:4, dash, attack:2, 
        skill, attack, burst, 
        attack:2;
  
  if .sucrose.skill.ready {
    sucrose attack, skill, dash;
  } else {
    sucrose attack, charge;
  }
}

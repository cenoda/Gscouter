active ineffa;
for let i=0; i<6; i=i+1 {
  if is_even(i) {
    ineffa skill, attack;
  } else {
    ineffa burst;
  }
  durin skill:2, burst;
  mona dash, burst, attack, skill;
  flins skill, attack, 
        skill, attack, burst, 
        attack:4, dash, attack:4, dash, attack:2, 
        skill, attack, burst, 
        attack;
  mona attack:2, charge;
}

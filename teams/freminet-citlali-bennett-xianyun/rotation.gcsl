fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}
active freminet;
for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;

  if .xianyun.sets.vv >= 4 && i == 0 {
    xianyun attack:2;
  }
  
  citlali skill, burst;
  
  freminet swap;
  FreminetPlunge(); freminet dash; wait(5);
  FreminetPlunge(); freminet dash; wait(10); 
  FreminetPlunge(); freminet skill;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash; wait(25); 
  FreminetPlunge(); freminet skill; 
  FreminetPlunge();
  
  bennett skill;
  while !.bennett.mods.favonius-cd { 
    bennett attack;
  }
}

fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}
active freminet; 
for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
  esco skill;
  
  chongyun burst, skill;
  
  xianyun skill, low_plunge, burst; 
  
  freminet skill:2; 
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash; 
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet skill:2;
  if i > 0 && .freminet.burst.ready {
    freminet burst;
  }
}

fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}
active freminet; 
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst, attack;
  
  xianyun attack:3;
  
  freminet skill:2;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet attack;
  freminet skill:2;
  
  bennett skill;
}

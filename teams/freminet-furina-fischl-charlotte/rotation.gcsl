fn freminetCombo(){
  freminet skill, attack, burst,
           attack:2, skill, attack, skill,
           attack:2, skill, attack, skill,
           attack:2, skill, attack, skill,
           attack:3, skill;
}
active freminet;
freminet skill;
for let i=0; i<4; i=i+1{
  furina skill, dash, burst;
  if .fischl.burst.ready{
    fischl attack:2, burst;
  }
  else if .fischl.skill.ready{
    fischl attack, skill;
  }
  charlotte skill, burst;
  
  if !i{
    freminet attack:4, skill;
    freminetCombo();
  }
  else{
    freminetCombo(); 
  }
}

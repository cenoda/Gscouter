active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  mika skill, burst;
   if .amy.skill.ready { 
    amy skill, attack; 
  } else { 
    amy attack:2, burst; 
  }
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:2, skill,  
           attack:2, skill, attack:2, skill,
           attack:3, skill;

}

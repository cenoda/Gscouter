active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  baizhu skill, burst;
  
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:1, skill,  
           attack:2, skill, attack:2, skill,
           attack:3, skill;
           
  raiden skill;
  if .raiden.energy == 90 {
    raiden burst;
  } else {
    raiden attack;
  }
}

fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}
active freminet;
for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
  
  rosaria skill, burst;
  
  freminet swap;
  FreminetPlunge(); freminet dash; 
  FreminetPlunge(); freminet skill; 
  FreminetPlunge(); freminet dash; 
  FreminetPlunge(); freminet dash; wait(20); 
  FreminetPlunge(); freminet dash; 
  FreminetPlunge(); freminet skill; 
  FreminetPlunge(); 

  rosaria skill;
  
  bennett skill;
}

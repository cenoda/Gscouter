active freminet;
for let i=0; i<4; i=i+1 {
  xq skill, dash, burst, attack;
  
  ororon skill, attack, burst, attack;
  
  mika burst, attack, skill, attack;
  
  freminet skill, attack, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:1, skill,  
           attack:2, skill, attack:2, skill, 
           attack:2, skill;
}

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, burst, attack;
  raiden skill, attack;
  sayu skill, burst;
  eula skill, attack;
  while !.eula.burst.ready {
    if .eula.skill.ready {
      eula skill;
    } else {
      eula attack;
    }
  }
  eula burst, walk, attack:4, skill[hold=1], attack:4;
  sayu skill,attack;
  eula attack:2;
  raiden burst, attack:4, dash, attack:4, dash, attack:4;
}

active yelan;
for let i=0; i<4; i=i+1 {
  yelan attack, skill, attack[travel=0];
  furina burst;
  yelan burst, attack, skill, attack[travel=0];
  xiangling burst, skill;
  furina skill;
  xianyun skill, low_plunge, burst;
  furina charge,
    jump, high_plunge[collision=1], dash,
    jump, high_plunge[collision=1], dash,
    jump, high_plunge[collision=1], dash,
    jump, high_plunge[collision=1], dash,
    jump, high_plunge[collision=1], charge;
  while !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
}

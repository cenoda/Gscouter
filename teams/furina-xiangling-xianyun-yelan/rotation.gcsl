active yelan;
for let i=0; i<4; i=i+1 {
  yelan attack, skill, attack[travel=0];
  furina burst;
  yelan burst, attack;
  xiangling burst, skill;
  furina skill;
  xianyun skill, low_plunge, burst;
  furina charge;
  furina jump, high_plunge[collision=1];
  furina dash, jump, high_plunge[collision=1];
  furina dash, jump, high_plunge[collision=1];
  furina dash, jump, high_plunge[collision=1];
  furina dash, jump, high_plunge[collision=1];
  furina charge;
  while !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
}

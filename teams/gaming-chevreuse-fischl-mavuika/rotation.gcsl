active gaming; 
fischl aim; 
for let i=0; i<4; i=i+1 {
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:1;
  } else {
    chev skill[hold=1], attack;
  }
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  if .mav.burst.ready {
    mav burst, skill, dash:1;
  } else {
    mav attack, skill;
  }
  gaming burst, attack:2,
         skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
  gaming skill, low_plunge;
  gaming skill, low_plunge;
}

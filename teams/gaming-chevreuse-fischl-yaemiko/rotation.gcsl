active yae;
for let i=0; i<4; i=i+1 {
  yae skill:3;
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  gaming burst, attack:2,
         skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge,
         skill, low_plunge,
         skill, low_plunge;
}

active gaming; 
fischl skill, attack;
for let i=0; i<4; i=i+1 {
  columbina skill;
  if .columbina.burst.ready {
    columbina burst;
  } else {
    columbina attack;
  }
  
  mona burst, attack;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  mona attack, skill, attack;
  
  gaming burst;
  for let j = 0; j < 7; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
}

active gaming; 
gaming skill, high_plunge;
for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;
  
  lynette skill, burst;
  
  diona skill[hold=1], burst;
  
  gaming burst, attack;
  let plungeCount = 0;
  for let j = 0; j < 5; j = j + 1 {
    sleep(45); 
    gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount);
  }
  sleep(30); 
  gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount); 
  gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount);
}

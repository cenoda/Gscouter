active gaming; 
furina skill, dash;
for let i = 0; i < 4; i = i + 1 {
  if .amy.skill.ready { 
    amy attack:1, skill; 
  } else { 
    amy attack:2, burst; 
  }
  
  chev burst, skill[hold=1]:3; 
  
  if .furina.skill.ready {
    furina skill, dash;
  }
  furina burst;
  
  gaming burst;
  for let j = 0; j < 6; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
  sleep(30); 
  gaming skill, high_plunge;
}

active furina;
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  bennett skill, burst;
  if !.element.t0.pyro {
    bennett attack; 
  }
  xianyun attack[travel=0], skill, low_plunge, burst; 
  gaming skill, high_plunge, burst;
  for let p=0; p<3; p=p+1 {
    if .gaming.status.xianyun-airborne-buff {
      gaming jump;
      if .airborne {
        let col = rand();
        if col > 0.5 {
          gaming high_plunge[collision=1];
        } else {
          gaming high_plunge;
        }
      }
    }
    gaming skill, high_plunge;
  }
  bennett skill, attack, dash;
}

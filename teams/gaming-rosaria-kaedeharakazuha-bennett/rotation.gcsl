  bennett skill, burst;
  
  kazuha skill, high_plunge;
  
  rosaria skill, burst;
  
  gaming burst;
  wait(45);
  for let p=0; p<4; p=p+1 {
    gaming skill;
    wait(20);
    gaming low_plunge;
  }
  for let p=0; p<2; p=p+1 {

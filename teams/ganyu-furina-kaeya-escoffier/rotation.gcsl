fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { 
    ganyu aim[hold=2, weakspot=rand()>0.2];
  } else { 
    ganyu aim[hold=2];
  }
}
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd && !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  escoffier skill, burst;
  
  kaeya skill, burst;

  if .ganyu.skill.cd {
    ganyuAim();
  }
  ganyu skill, burst;
  ganyuAim();
  
  kaeya attack, skill, dash;
  
  ganyuAim();
  ganyuAim();
  ganyuAim();
  
  ganyu skill; 
  kaeya skill;
}

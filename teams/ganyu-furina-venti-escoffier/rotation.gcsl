fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { 
    ganyu aim[hold=2, weakspot=rand()>0.2];
  } else { 
    ganyu aim[hold=2];
  }
}
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  esco skill, burst;
	
  ganyuAim();
  ganyu burst, skill; 
	
  venti skill, burst;
	
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyu skill;
  venti skill, attack; 
}

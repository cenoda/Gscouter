active mona;
while 1 {
  if .mona.skill.ready { mona skill; }
  if .mona.burst.ready { mona burst; }
  if .venti.skill.ready { venti skill[hold=1]; }
  if .venti.burst.ready { venti burst; }
  if .diona.skill.ready { diona skill[hold=1]; }
  if .diona.burst.ready { diona burst; }
  if .ganyu.skill.ready { ganyu skill; }
  if .ganyu.burst.ready { ganyu burst; }
  ganyu aim:3;
}

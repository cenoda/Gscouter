active ineffa;
for let i=0; i<5; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill, attack;
  }
  mona burst, attack;
  if is_even(i) {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }
  mona attack, skill, attack;
  hutao skill,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:2, charge, dash,
        attack:2, charge, dash;
}

active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  durin skill:2;
  xingqiu skill, dash, burst, attack;
  durin burst;
  fischl attack:2, burst;
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:3, charge;       
  if .tao.burst.ready && .tao.energy == .tao.energymax  {
    tao burst, attack:2;
  } else {
    xingqiu attack:2;
  }
}

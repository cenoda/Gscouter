active fischl;
for let i=0; i<6; i=i+1 {
  fischl skill, attack;
  xingqiu skill, dash, burst, attack;
  mona burst, attack, skill, attack;
  fischl attack:2, burst;
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge;
  if .tao.burst.ready && .tao.energy == .tao.energymax  {
    tao burst;
  } else {
    tao attack:2;
  }
}

active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  xingqiu skill, dash, burst, attack;
  sucrose attack, skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;
  }
  fischl attack, burst;
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:3, charge;       
  if .tao.burst.ready && .tao.energy == .tao.energymax  {
    tao burst, attack:2;
  } else {
    xingqiu attack:4;
  }
}

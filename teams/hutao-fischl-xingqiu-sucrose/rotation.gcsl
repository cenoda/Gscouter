active fischl;
for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, attack;
  sucrose skill, jump,  burst;
  fischl attack, skill;
  hutao skill,
    attack, charge, dash,
    attack, charge, dash,
    attack, charge, jump,
    attack, charge, dash,
    attack, charge, dash, 
    attack, charge, jump,
    attack, charge, dash,
    attack, charge, jump,
    attack, charge, jump, 
    attack, charge, jump,
    attack, charge, jump,
    attack:2, charge;       
  
  xingqiu burst, attack;
  fischl attack:2, burst;
  sucrose skill, jump, attack:3;
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, jump,
    attack:2, charge, jump, 
    attack:3, charge, jump,
    attack;  
  
}

active fischl;
for let i=0; i<4; i=i+1 {
  
  durin skill:2, burst, attack;
  yelan skill, burst, attack;
  
  if is_even(i) {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash, 
    attack;
  
}

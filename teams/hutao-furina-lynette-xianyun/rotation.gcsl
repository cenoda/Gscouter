active furina;
for let i = 0; i < 4; i = i + 1 { 
  furina skill, dash, burst;
  while .lynette.skill.ready {
    lynette skill;
  }
  if .lynette.swap.cd {
    lynette attack;
  }
  xianyun skill, low_plunge, burst;
  
  while .lynette.skill.ready {
    lynette skill;
  }
  lynette burst;
  
  hutao skill;
  for let p = 5; p > 0; p = p - 1 {
    hutao attack:2, charge, jump;
    if .airborne {
      hutao high_plunge[collision=rand()>0.5];
    }
  }
  hutao attack:2, charge, dash;
}

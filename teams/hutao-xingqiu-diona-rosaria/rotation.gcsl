active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu burst, attack, skill, attack:2;
  diona skill[hold=1];
  rosaria attack, skill, burst;
  hutao skill,
    attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1, charge, jump,
	attack:1;
  if .hutao.burst.ready { hutao burst; }
  rosaria skill, attack:2;
  xingqiu attack:2;
  print("rotation done");
}

active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu burst, attack, skill, dash, attack:2;
  yelan attack:2, burst;
  sucrose attack, skill, jump;
  if .sucrose.burst.ready {
    sucrose attack, burst; 
  }
  yelan skill, attack;
  hutao skill,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump;
  yelan skill, attack:4;
  sucrose attack:3;
  xingqiu attack;
  wait (10);
}

active xingqiu;
while 1 {
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  if .yelan.burst.ready { yelan burst; }
  yelan skill;
  zhongli skill[hold=1];
  hutao skill;
  while .hutao.status.paramita > 0 {
    if .stam >= 25 {
      hutao attack, charge;
    } else {
      hutao attack:2;
    }
  }
  while !.xingqiu.skill.ready {
    hutao attack;
  }
}

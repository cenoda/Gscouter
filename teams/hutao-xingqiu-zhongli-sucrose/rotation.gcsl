let t = 0;
active zhongli;
for let i=0; i<4; i=i+1 {
	let t = f();
	zhongli skill[hold=1], jump;
	xingqiu burst, attack, skill, dash, attack:2;
	sucrose attack, skill, dash;
	if .sucrose.skill.ready {
		sucrose attack, skill, dash;
	}
	if .sucrose.burst.ready {
		sucrose attack, burst;
	}
	sucrose attack;
	hutao skill, attack:2, charge, jump;
	for let x=0; x<6; x=x+1 {
		hutao jump, attack:2, charge;
	}
	if .hutao.burst.ready {
		hutao burst;
	} else {
	    hutao jump;
	}
	while f() - t < 21*60 {
		zhongli attack;
	}
}

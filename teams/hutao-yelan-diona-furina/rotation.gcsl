active furina;	
for let i = 0; i<4; i=i+1 { 
 furina skill, dash, burst; 
 diona skill[hold=1], burst; 
 yelan burst, attack;
 if i {
   diona attack:4; 
 }
 yelan attack, skill;
 hutao skill,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:2, charge, jump, attack; 
 yelan skill, attack:2;
 if !i {
   furina attack:3; 
 }	
}

active ineffa;
for let i=0; i<4; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, attack, burst;
  } else if i > 0 {
    ineffa skill, attack;
  } else {
    ineffa skill;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  
  hutao skill,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:2, charge, jump;
}

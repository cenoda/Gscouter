active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } 
  while !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  kuki skill;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  hutao skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2;
  
  print("done");
}

active nicole;
for let i = 0; i < 4; i = i + 1 {
  nicole attack:2, skill;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if is_even(i) {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  hutao skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump;
  if is_even(i) {
    hutao attack:2, burst;
  } else {
    hutao attack:2, charge, jump;
  }
}

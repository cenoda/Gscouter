active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } 
  while !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xilonen skill, attack:2;

  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack:2, skill;
  }
  
  hutao attack, skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:3;
	
  print("done");
}

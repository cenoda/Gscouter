active furina;
for let i=0; i<3; i=i+1 {
furina  skill, dash, burst;
  if i {
    lisa skill[hold=1], attack;}
   
lisa burst;
yelan burst, attack, skill, attack;
hutao skill,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:2, charge, jump, attack;
      if .hutao.burst.ready {  hutao attack, burst;}
  yelan  attack, skill, attack;

}

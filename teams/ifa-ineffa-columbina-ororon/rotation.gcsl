active columbina;
for let i=0; i<6; i=i+1 {
  
  if .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack;
  }
  
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  } 
  
  ororon skill, burst, attack;
 
  if .ifa.burst.ready {
    ifa burst;
  }
  ifa attack, skill;
  while .ifa.nightsoul.points > 8 {
    ifa charge;
  }
  if .ifa.burst.ready {
    ifa burst, attack;
  } else {
    ifa attack;
  }
}

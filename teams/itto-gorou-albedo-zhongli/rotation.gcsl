active albedo;
while 1 {
  if .albedo.skill.ready { albedo skill; }
  if .gorou.skill.ready { gorou skill; }
  if .gorou.burst.ready { gorou burst; }
  if .zhongli.skill.ready { zhongli skill[hold=1]; }
  if .albedo.burst.ready { albedo burst; }
  if .itto.skill.ready { itto skill; }
  if .itto.burst.ready { itto burst; }
  if .itto.mods.itto-q > 0 {
    while .itto.mods.itto-q > 0 {
      itto attack:3, charge;
    }
  } else {
    itto attack:3, charge;
  }
}

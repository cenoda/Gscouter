active bennett;
bennett skill;
for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill;
  }
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;

  kazuha skill, high_plunge[collision=1];
  while .xianyun.status.xianyun-airborne-buff {
    kazuha jump;
    if .airborne {
      kazuha high_plunge[collision=rand()>0.5];
    }
    if .kazuha.status.xianyun-airborne-buff {
      kazuha dash;
    }
  }

  if .kazuha.skill.ready {
    kazuha skill, high_plunge[collision=1];
  }
  
  bennett skill;
}

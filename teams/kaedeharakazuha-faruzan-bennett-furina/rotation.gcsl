active furina;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  bennett burst, skill;
  faruzan skill, burst, aim;
  if .kazuha.burst.ready { 
    kazuha burst;
  }
  kazuha skill, high_plunge;
  bennett skill, attack:2;
  faruzan skill, aim:2;
  kazuha skill, high_plunge[collision=1];
  bennett skill, attack:2;
  furina attack:2;
  faruzan skill, aim:2;
  kazuha skill, high_plunge;
}

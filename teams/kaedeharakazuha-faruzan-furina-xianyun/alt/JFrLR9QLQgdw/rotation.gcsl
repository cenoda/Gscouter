active furina;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  faruzan skill, burst;
  
  xianyun skill, low_plunge;
  if !.xianyun.burst.ready  {
    xianyun skill, low_plunge;
  }
  xianyun burst;
  
  while .xianyun.status.xianyun-airborne-buff {
    if .kazuha.skill.ready && .kazuha.burst.ready {
      kazuha skill, high_plunge[collision=1], burst;
    } else if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=1];
    } else if .kazuha.infusion.kazuha-c6-infusion && .kazuha.mods.kazuha-c6-dmgup > 10 {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff && .kazuha.mods.kazuha-c6-dmgup > 10 {
        kazuha dash;
      }
    } else {
      wait(1);
    }
  }
  kazuha attack, charge;
  
}

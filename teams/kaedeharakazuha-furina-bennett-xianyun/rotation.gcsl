active furina;
for let r = 4; r > 0; r = r - 1 {
  furina skill, dash, burst;
  if !.furina.mods.favonius-cd {
    furina attack;
  }
  xianyun skill, low_plunge, attack, burst;
  
  bennett skill, burst;
  
  while .xianyun.status.xianyun-airborne-buff {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=1];

    } else {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff {
        kazuha dash;
      } else {
        kazuha attack:1;
      }
    }
  }
  if .kazuha.burst.ready {
    kazuha burst;
  }
  bennett skill;
}

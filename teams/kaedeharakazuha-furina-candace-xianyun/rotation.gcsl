active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  candace skill, burst;
  
  kazuha skill, high_plunge[collision=1];
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff {
        kazuha dash;
        
      } else {
        break;
        
      }
    }
  }
  kazuha skill, high_plunge[collision=1];
  if .kazuha.burst.ready {
    kazuha burst;
  }
  
  candace attack, skill;
  if .furina.skill.cd { 
    candace attack;
  }
}

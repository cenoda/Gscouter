active furina;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready { 
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  furina skill, dash, burst;
  
  kazuha skill, high_plunge[collision=rand()>0.3];
  
  bennett skill, burst;
  
  kazuha burst;
  
  emilie attack:2;
  
  kazuha attack, skill, high_plunge[collision=rand()>0.3];
  
  bennett skill, attack;
  
  emilie attack:5;
  
  kazuha attack, skill, high_plunge[collision=rand()>0.3]; 
  
  print("done");
}

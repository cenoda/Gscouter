active ororon;
ororon burst, skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  while .xianyun.skill.ready {
    xianyun skill, low_plunge;
  }
  xianyun attack, burst; 
  
  while .furina.skill.cd {
    switch {
      
      case .ororon.burst.ready:
        ororon skill, burst;
      
      case .kazuha.skill.ready:
        kazuha skill, high_plunge[collision=rand()>0.2];
      case .kazuha.burst.ready:
        kazuha burst;
      
      case .kazuha.infusion.kazuha-c6-infusion && .previous-action == .action.low_plunge:
        kazuha attack;
      case .kazuha.infusion.kazuha-c6-infusion && .xianyun.status.xianyun-airborne-buff:
        kazuha jump;
        if .airborne {
          kazuha low_plunge[collision=rand()>0.5];
        }
      case .kazuha.infusion.kazuha-c6-infusion && .kazuha.normal > 1 && .stam > 25:
        kazuha charge;
      case .kazuha.infusion.kazuha-c6-infusion:
        kazuha attack;
      
      case .xianyun.onfield && .previous-action == .action.low_plunge:
        xianyun attack;

      case .xianyun.status.xianyun-airborne-buff:
        xianyun jump;
        if .airborne {
          xianyun low_plunge[collision=rand()>0.5];
        }
      
      case .kazuha.sets.tf == 4:
        kazuha attack;
      default:
        xianyun attack;
    }
  }

  print("done");
}

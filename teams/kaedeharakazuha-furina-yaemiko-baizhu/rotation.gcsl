active yae;
for let x = 0; x < 3; x = x + 1 {
  if x==0 {
    yae skill:3;
  } else {
    yae  skill, attack, skill, attack, skill;
  }
  
  furina skill, dash, attack;
  
  kazuha skill, high_plunge, burst;
  
  furina burst;
  baizhu skill, burst, attack;
  
  kazuha skill, high_plunge;
  
  yae attack;
  
  if .yae.burst.ready {
    yae burst; 
  } else {
    yae charge, dash;
  }
  yae skill:2, attack, skill,
      attack, charge, dash;
  kazuha skill, high_plunge;    
  
  baizhu skill, attack;
  
  yae attack:2, charge, dash,
      attack:2, charge, dash,
      attack;
  
  print("Rotation Done");
}

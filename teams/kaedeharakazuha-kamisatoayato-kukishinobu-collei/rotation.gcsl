active ayato;
for let i=0; i<4; i=i+1 {
    kamisatoayato burst[radius=2];
	kuki skill;
	kazuha skill, high_plunge, burst, attack;
	collei burst, skill;
    kamisatoayato skill, attack:15;
	kazuha skill, high_plunge, attack:2;

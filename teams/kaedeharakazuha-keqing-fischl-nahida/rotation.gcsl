active fischl;
fischl aim;
for let i=0; i<4; i=i+1 {
  if !i { 
    kazuha skill, high_plunge, burst;
    nahida skill, burst;
  } else {
    nahida burst, skill;
    kazuha burst, skill, high_plunge;
  }
  fischl attack:2, burst;
  keqing skill, burst, skill,
         attack, charge, 
         attack, charge, 
         attack, skill,
         attack, charge,
         attack, charge,
         attack;
  kazuha attack, skill, high_plunge;    
  nahida skill, attack;
  fischl attack, skill;
  keqing skill, burst, skill,
         attack, charge,
         attack, skill,
         attack, charge;
}

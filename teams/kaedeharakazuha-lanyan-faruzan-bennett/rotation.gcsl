active bennett;
for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;
  
  faruzan skill, burst;
  
  kazuha skill, high_plunge[collision=1], burst;
  
  faruzan aim:2, skill;
  
  kazuha skill, high_plunge[collision=1];
  
  lanyan skill:2;
  
  faruzan aim:2, skill; 
  
  kazuha skill, high_plunge[collision=1]; 
  
  lanyan skill:2;
  
  faruzan aim:1;
}

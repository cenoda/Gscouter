fn KazuPlunge(){
  kazuha jump;
  if .airborne {
    kazuha high_plunge[collision=rand()>0.5];
  }
}
active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill; 
  
  xianyun skill, low_plunge, burst;
  
  citlali skill, burst;
  
  kazuha burst;
  
  bennett burst;
  wait(6); 
  bennett attack;
  
  kazuha swap;
  wait(11); 
  kazuha skill, high_plunge[collision=1]; 
  wait(12); 
  KazuPlunge(); kazuha dash;
  KazuPlunge(); kazuha dash;
  KazuPlunge(); kazuha dash;
  KazuPlunge();
  kazuha skill, high_plunge[collision=1], dash;
  KazuPlunge();
  KazuPlunge(); 

  if i != 3 { 
    bennett skill;
    wait(54); 
    
    xianyun skill, low_plunge;
    
    kazuha skill, high_plunge[collision=1];
  }
}

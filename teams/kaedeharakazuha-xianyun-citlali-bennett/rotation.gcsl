fn KazuPlunge(){
  kazuha jump;
  if .airborne {
    kazuha high_plunge[collision=rand()>0.5];
  }
  wait(45); 
}
active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill, attack:2; 
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, dash, burst;
  
  citlali skill, burst;
  
  kazuha skill, high_plunge[collision=1];
  KazuPlunge();
  KazuPlunge();
  KazuPlunge();
  kazuha skill, high_plunge[collision=1];
  wait(45); 
  KazuPlunge();
  KazuPlunge();
  kazuha attack:2; 
  kazuha skill, high_plunge[collision=1];
}

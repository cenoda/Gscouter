active yae;
for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }
  
  kazuha skill, high_plunge;
  
  fischl attack, skill;
  
  baizhu skill, burst;
  
  kazuha attack, burst;
  
  yae attack:2, charge, dash;
  yae burst, skill, attack, skill, skill;
  
  kazuha skill, high_plunge;
  
  fischl attack:2, burst;
  
  baizhu skill, attack;
  
  yae attack:2, charge, dash;
  yae attack:2;
  
  kazuha skill, high_plunge;
  
  yae attack:1, charge, dash;
  yae attack:2, charge, dash;
}

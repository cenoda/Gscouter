active xilonen;
for let i=0; i<4; i=i+1 {
  xilonen burst;
  
  furina skill, dash, burst;
  
  chongyun burst, skill;
  
  xilonen attack, skill, attack:2;
  
  kaeya skill, dash, burst;
  while .furina.skill.cd > 120 {
    switch {
      case .kaeya.skill.ready:
        kaeya skill, dash;
      case .kaeya.normal > 2 && .stam > 25:
        kaeya charge;
      case .kaeya.normal > 3 && .stam > 18:
        kaeya dash;
      default:
        kaeya attack;
    }
  }
  
  xilonen skill, attack:2;
}

fn KaeyaPlunge() {
  kaeya jump;
  if .airborne {
    kaeya high_plunge[collision=rand()>0.5];
  }
}
active fischl;
fischl skill;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  
    furina attack;
  
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  if .fischl.skill.ready {
    fischl attack:2, skill; 
  } else {
    fischl attack:2, burst;
  }
  
  kaeya skill, burst;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya skill;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge();
  kaeya attack:2, charge;
}

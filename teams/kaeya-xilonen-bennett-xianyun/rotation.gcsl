fn KaeyaPlunge() {
  kaeya jump;
  if !.element.t0.cryo {
    wait(7);
  }
  if .airborne {
    kaeya high_plunge[collision=rand()>0.5];
  }
}
active xianyun;
for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;

  xilonen skill, attack:2;
  
  kaeya skill, burst;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya skill, dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); 
  
  bennett skill;
  while !.bennett.mods.favonius-cd && .bennett.weapon == .keys.weapon.favsword{ 
    bennett attack;
  }
}

active ayaka;
for let x=0; x<4; x=x+1 {
  ayaka skill, attack, charge;
  aetheranemo skill[hold=1,hold_ticks=1], burst;
  shenhe skill, burst;
  bennett burst, skill;
  ayaka dash, skill, attack, burst;
  aetheranemo skill[hold=1];
  shenhe attack, skill;
  ayaka dash, attack:2, charge, dash, attack:2, charge;
}

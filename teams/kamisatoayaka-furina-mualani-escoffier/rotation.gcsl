active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if !.furina.mods.favonius-cd && .furina.weapon == .keys.weapon.favsword {
    furina attack;
  }
  furina burst;
  escoffier skill, burst;
  if !.escoffier.mods.favonius-cd && .escoffier.weapon == .keys.weapon.favlance {
    escoffier attack;
  }
  mualani skill, attack, skill;
  ayaka skill, dash, attack, burst,
        attack, charge, dash,
        attack:2, charge,
        attack:2, charge;
  mualani skill, attack, skill;
  ayaka attack, 
        skill, dash, 
        attack, charge, 
        attack, charge,
        attack;
}

active ayaka;
ayaka dash;
for let i = 0; i < 5; i = i + 1{
  kazuha skill[hold=1], high_plunge, burst;
  shenhe skill, burst;
  kokomi skill, dash;
  ayaka dash, attack:2, skill, attack:2, charge, burst;
  kazuha skill, high_plunge;
  shenhe skill;
  
  if .shenhe.skill.ready {
    shenhe skill;
  } else {
    shenhe attack;
  }
  ayaka dash, attack:2, charge, skill, attack:2, charge;
  print("rotation done");
}

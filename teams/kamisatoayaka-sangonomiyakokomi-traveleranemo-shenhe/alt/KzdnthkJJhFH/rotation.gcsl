active ayaka;
ayaka dash;
for let i = 0; i < 5; i = i + 1{
  lumineanemo skill[hold_ticks=2], burst;
  shenhe skill, burst;
  kokomi skill, dash;
  ayaka dash, skill, attack, burst, attack:2, charge;
  lumineanemo skill[hold_ticks=1];
  shenhe skill, attack;
  ayaka dash, attack:2, charge, attack:2, skill, attack:2, charge;
  print("rotation done");
}

active nahida;
for let x = 5; x; x = x - 1 {
  nahida skill, attack, burst;
  if .ayato.burst.ready { ayato burst; }
  fischl skill, attack;
  dori skill, burst;
  ayato skill, attack:15;
  
  nahida skill, attack:2;
  fischl attack:2, burst;
  dori skill, attack:2, dash, attack;
  ayato skill, attack:10;
  
  print("rotation done");
}

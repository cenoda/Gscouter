active nahida;
for let x = 5; x; x = x - 1 {
  nahida skill,burst;
  ayato burst;
  nilou skill:3, skill;
  baizhu attack, skill, attack, burst, attack;
  nahida skill, attack, charge;
  ayato skill, attack:14;
  baizhu attack, skill, attack; 
  if .nilou.burst.ready {
    nilou burst;
  } 
  print("rotation done");
}

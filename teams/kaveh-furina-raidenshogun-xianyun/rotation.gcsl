active raiden;
raiden skill;
for let x = 0; x < 4; x = x + 1 {  
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  kaveh skill, attack, burst;
  
  while .kaveh.status.xianyun-airborne-buff {
    if .kaveh.skill.ready {
      kaveh skill;
    }
    kaveh jump;
    if .airborne {
      kaveh high_plunge[collision=rand()>0.5], dash;
    }
  }
  
  while .furina.skill.cd > 60 { 
    if .kaveh.skill.ready {
      kaveh skill;
    } else {
      kaveh attack;
    }
  }
  
  raiden attack, skill;
  
  print("done");
}

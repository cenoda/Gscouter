active kaveh; 
fischl attack, skill;
for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  kirara skill[short_hold=1];
  if .kirara.burst.ready {
    kirara burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  kaveh skill, burst;
  while .kaveh.mods.kaveh-q > 120 { 
    if .kaveh.skill.ready {
      kaveh skill;
    } else if .kaveh.normal > 3 {
      kaveh walk;
    } else {
      kaveh attack;
    }
  }
}

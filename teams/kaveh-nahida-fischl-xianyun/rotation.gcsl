active kaveh; 
for let i = 0; i < 4; i = i + 1 {
  if .amy.skill.ready && .amy.burst.ready {
    amy attack:1, skill;
  }
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  xianyun skill, low_plunge, burst;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  kaveh skill, burst, attack;
  
  while .kaveh.status.xianyun-airborne-buff {
    if .kaveh.skill.ready {
      kaveh skill;
    }
    kaveh jump;
    if .airborne {
      kaveh high_plunge[collision=rand()>0.5], dash;
    }
  }
  while !.kaveh.skill.ready {
    if .kaveh.normal > 4 {
      kaveh walk;
    } else {
      kaveh attack;
    }
  }
  kaveh skill;
}

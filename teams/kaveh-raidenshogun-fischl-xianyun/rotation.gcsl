active kaveh; 
raiden attack, skill;
for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, attack, burst;
  
  fischl attack, skill;
  
  kaveh skill, burst;
  
  while .kaveh.status.xianyun-airborne-buff {
    kaveh jump;
    if .airborne {
      kaveh low_plunge[collision=rand()>0.5];
    } 
    if .kaveh.skill.ready {
      kaveh skill;
    } else {
      kaveh dash;
    }
  }
  
  xianyun attack:2; sleep(20); 
  
  fischl attack:2, burst;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
  
  print("done");
}

active kazuha;
while 1 {
  kazuha skill;
  if .kazuha.burst.ready { kazuha burst; }
  nahida skill[hold=1];
  if .nahida.burst.ready { nahida burst; }
  if .fischl.skill.ready { fischl skill; }
  if .fischl.burst.ready { fischl burst; }
  keqing skill;
  keqing skill;
  if .keqing.burst.ready { keqing burst; }
  while .keqing.status.keqinginfuse > 0 {
    keqing attack:3, charge;
  }
}

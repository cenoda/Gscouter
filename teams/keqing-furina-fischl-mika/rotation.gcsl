active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  mika burst, attack, skill[hold=0];
  
  keq skill;
  while .fischl.oz {
    if .keq.normal > 2 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 4 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  
  fischl attack:2, burst;
  
  keq skill;
  while .furina.skill.cd {
  
    if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 4 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  keq burst;
  
}

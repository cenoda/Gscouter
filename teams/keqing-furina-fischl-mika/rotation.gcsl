active furina;
furina skill, attack, burst;
for let i=0; i<4; i=i+1 {
    if i {
        furina burst, skill;
    }
    mika burst, skill;
    fischl attack, skill;
    keq skill, burst;
    while .fischl.skill.cd > 940 {
        if .stam > 25 {
            keq attack, charge;
        } else {
            keq attack:4, charge;
        }
    }
    fischl attack:2, burst;
    while !.furina.burst.ready {
        if .stam > 25 {
            keq attack, charge;
        } else if .keq.skill.ready {
            keq skill, burst;
        } else {
            keq attack:4, charge;
        }
    }
}

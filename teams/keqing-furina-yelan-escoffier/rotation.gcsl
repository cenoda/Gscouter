active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  escoffier skill, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  while !.yelan.skill.ready {
    if .status.keqingstiletto && .keq.normal > 1 {
      keq charge;
    } else if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  
  yelan attack, skill, attack;
  
  while .furina.skill.cd {
    if .status.keqingstiletto && .keq.normal > 1 {
      keq charge;
    } else if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  keqing burst; 
}

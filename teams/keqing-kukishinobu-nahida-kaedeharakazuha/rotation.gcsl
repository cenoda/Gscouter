active nahida;
for let i=0; i<4; i=i+1 {
  if .nahida.burst.ready {nahida burst;}
  else {nahida attack:2, charge;}
  nahida skill;
  kuki burst, attack, skill;
  kazuha skill[hold=1], high_plunge, burst;
  keqing skill, burst, skill, 
    attack, charge,
    attack, charge, 
    attack, skill,
    attack, charge,
    attack, charge;
  kazuha skill, high_plunge;
}

fn KeqingPlunge() {
  keq jump;
  if .airborne {
    keq low_plunge[collision=rand()>0.5];
  }
}
active fischl;
for let i = 0; i < 4; i = i + 1 {
  fischl attack, skill;
  
  nahida skill;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst; 
  } else {
    nahida attack, charge;
  }
  
  xianyun attack, skill, low_plunge, burst; 
  
  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq skill; 
  
  fischl attack:2, burst; 
  
  xianyun attack:2; sleep(20); 
  
  keq skill; 
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq skill, burst, skill, attack, charge;
}

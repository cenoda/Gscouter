active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.burst.ready && .fischl.energy == .fischl.energymax {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  lanyan attack, skill:2;
  
  keqing skill, attack, skill,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack:2, charge;
  
  if .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax {
    lanyan attack, burst;
  } else {
    lanyan attack:1, charge:1;
  }
  
  keqing skill, attack, burst, skill;
}

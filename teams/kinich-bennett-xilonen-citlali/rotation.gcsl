active citlali;
while 1 {
  citlali skill;
  if .citlali.burst.ready { citlali burst; }
  xilonen skill;
  if .xilonen.burst.ready { xilonen burst; }
  if .bennett.burst.ready { bennett burst; }
  bennett skill;
  if .kinich.skill.ready {
    kinich skill;
    if .kinich.burst.ready { kinich burst; }
    while .kinich.nightsoul.state {
      if .kinich.nightsoul.points >= 20 && .kinich.nightsoul.duration > 90 {
        kinich skill;
      } else {
        kinich attack;
      }
    }
  }
  kinich attack:3;
  while !.citlali.skill.ready {
    kinich attack:3;
  }
}

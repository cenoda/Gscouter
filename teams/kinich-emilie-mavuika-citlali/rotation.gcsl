fn kinich_combo() {
  kinich skill;
  
  for let c=0; c<5; c=c+1 { 
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.duration > 12 {
      kinich skill[hold=1];
    }
  }
}	
active citlali;
for let i=0; i<4; i=i+1 {
  if !i {
    citlali skill, attack;
  } else {
    citlali skill, burst, attack;
  }
  mavuika burst, charge, skill, dash;
  emilie burst;
  kinich_combo();

}

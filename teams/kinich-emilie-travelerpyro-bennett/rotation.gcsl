fn kinich_combo() {
  kinich skill;
  for let c=0; c<5; c=c+1 {
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
  if .kinich.burst.ready {
    kinich burst;
  }
}
active kinich; 
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  luminepyro skill[hold=1], burst, attack;
  bennett skill, burst;
  kinich_combo();
}

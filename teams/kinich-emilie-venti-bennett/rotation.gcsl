fn kinich_combo() {
  kinich skill;
  
  for let c=0; c<5; c=c+1 { 
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
  if .kinich.burst.ready && .kinich.energy == 70 {
    kinich burst;
  }
}
active kinich;
bennett skill;
for let i=0; i<4; i=i+1 {
  if !is_even(i) {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  venti skill, burst, attack:1;
  bennett skill, burst;
  kinich_combo();
}

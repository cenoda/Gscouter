fn kinich_combo() {
  kinich skill;
  kinich attack;
  while .kinich.nightsoul.state {
    if .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
      continue;
    }
    kinich attack;
  }
}
active kinich; 
for let i=0; i<4; i=i+1 {
  durin skill:2, burst;
  bennett skill, burst;
  if is_even(i) {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  }
  kinich_combo();
  if .kinich.burst.ready && .kinich.energy == .kinich.energymax {
    kinich burst;
  } else {
    bennett skill, attack;
  }
}

fn kinich_combo() {
  kinich skill;
  
  for let c=0; c<5; c=c+1 { 
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
}
active emilie;
emilie skill;
for let i=0; i<4; i=i+1 {
  mavuika burst, charge, skill, attack;   
  bennett skill, burst;
  emilie burst;
  kinich_combo();
}

fn kinich_combo() {
  kinich skill;
  for let c=0; c<5; c=c+1 { 
    for let a=0; a<2; a=a+1 { 
      if .kinich.blind_spot {
        kinich attack[direction=.kinich.blind_spot];
       } else {
        kinich attack;
      }
    }
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
}		
active kinich;
for let i=0; i<4; i=i+1{
  ororon burst, skill;
  bennett skill, burst;
  mav burst, charge, skill, dash;
  kinich_combo();
  
}

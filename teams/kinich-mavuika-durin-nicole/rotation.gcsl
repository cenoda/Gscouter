fn kinich_combo() {
  kinich skill;
  
  for let c=0; c<5; c=c+1 { 
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.duration > 12 {
      kinich skill[hold=1];
    }
  }
}	
active nicole;
for let i=0; i<4; i=i+1 {
  nicole skill, attack;
  durin skill, burst, skill;
  mavuika skill, burst, charge, dash, charge;
  kinich_combo();
}

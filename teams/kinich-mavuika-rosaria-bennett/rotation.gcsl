fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
}
active kinich; 
for let i=0; i<4; i=i+1{
  
  bennett skill, burst;
  
  rosaria attack, skill, burst;
  
  mavuika skill, burst, dash;
  
  kinich_combo();

}

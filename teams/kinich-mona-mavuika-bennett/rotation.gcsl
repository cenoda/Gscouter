fn kinich_combo() {
  kinich skill;
  kinich attack;
  while .kinich.nightsoul.state {
    if .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
      continue;
    }
    kinich attack;
  }
}
active kinich; 
for let i=0; i<4; i=i+1 { 
  mavuika attack, skill;
  bennett burst, skill;
  mona attack, burst, skill;
  mavuika burst, dash; 
  kinich_combo();
}

fn kinich_combo() {
  kinich skill;
  
  for let c=0; c<5; c=c+1 { 
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
  
  if .kinich.burst.ready {
    kinich burst;
  }
}
active kinich; 
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  nahida skill, attack:2;
  bennett skill, burst;
  kinich_combo();
  bennett skill, dash;
}

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}
active kinich;
for let i=0; i<4; i=i+1 {
  if .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  zl skill[hold=1], dash, attack;
  ororon skill, attack, burst, attack;
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  } 
}

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}
active kinich;
for let i=0; i<5; i=i+1 {
 
  ororon skill, burst;
  amy attack;
  if .amy.burst.ready {
    amy attack:1, burst;
  } else {
    amy skill;
  }
  xilo skill, attack:2;
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  } else {
    ororon aim:2;
  }
}

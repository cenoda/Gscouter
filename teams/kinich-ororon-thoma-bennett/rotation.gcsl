fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
  if .kinich.burst.ready {
	  kinich burst;
  } else {
    kinich attack;
  }
}
active kinich;
for let i=0; i<4; i=i+1 {
  thoma attack, skill, burst, attack;
  bennett skill, burst;
  ororon skill, burst;
  kinich_combo();
}

fn kinich_combo() {
  kinich skill;
  for let c=0; c<5; c=c+1 { 
    for let a=0; a<2; a=a+1 { 
      if .kinich.blind_spot {
        kinich attack[direction=.kinich.blind_spot];
       } else {
        kinich attack;
      }
    }
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
}		
active kinich;
for let i=0; i<4; i=i+1{
  if is_even(i) {
    xiangling burst, skill, dash;
  } else {
    xiangling attack:2, skill, dash;
  }
  bennett skill, burst;
  chongyun burst, skill;
  
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  }
  
}

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}
active yae;
yae attack;
for let i=0; i<5; i=i+1 {
  
  xilonen skill, attack:2;
  
  yae skill:3;
  
  amy attack;
  if .amy.burst.ready {
    amy attack:1, burst;
  } else {
    amy skill;
  }

  kinich_combo();
  if .yae.burst.ready {
    yae attack:2, burst;
  } else if .kinich.burst.ready {
    kinich burst;
  }
  
}

fn kinich_combo() {
  kinich skill; set_player_pos(0, -3); 
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}
active kinich; 
for let i=0; i<4; i=i+1 {
  yelan skill;
  set_player_pos(0, 0); 
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon skill, attack, burst;
  
  thoma skill, attack, burst, attack;
  
  kinich_combo();
  if .kinich.burst.ready && .kinich.energy == .kinich.energymax {
    kinich burst;
  }
}

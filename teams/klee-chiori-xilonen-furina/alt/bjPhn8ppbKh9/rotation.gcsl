active furina;
for let i=0; i<2; i=i+1 {
  
  furina skill, dash, burst;
  xilonen burst, skill, attack:2;
  
  if .chiori.burst.ready {
    chiori burst, skill:2;
  } else {
    chiori skill:2;
    klee attack:2, jump;
  }
  klee attack, charge, burst, walk;
  klee attack[travel=6], charge, attack[travel=6], charge;
  klee attack, skill[bounce=3, mine=8], jump, attack[travel=6], charge;
  
 if .klee.skill.ready {
      klee attack, skill[bounce=3, mine=8], jump;
    } else {
      klee attack[travel=6], charge;
    }
  klee attack[travel=6], charge, attack[travel=6], charge;
  klee attack, walk, attack;
   
}

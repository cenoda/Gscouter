active furina;
furina skill, dash, burst;
bennett skill, burst;                 
emilie skill, attack;
klee attack, burst, walk, attack[travel=6], charge;
klee attack[travel=6], charge, attack, skill[bounce=3, mine=8];
klee jump, attack, skill[bounce=3, mine=8], jump;
for let x = 4; x > 0; x = x - 1 {
  klee attack[travel=6], charge;
}
klee attack, walk, attack;
bennett skill, attack;
furina attack; 
for let x = 3; x > 0; x = x - 1 {
  furina skill, dash, burst;
  bennett burst, skill;
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  bennett skill;
  klee attack, burst, walk, attack[travel=6], charge;
  klee attack[travel=6], charge, attack, skill[bounce=3, mine=8], jump;
  for let r = 5; r> 0; r = r - 1 {
    klee attack[travel=6], charge;
  }  
  klee attack, walk, attack, walk, attack;
}

active furina;
furina skill, dash, burst;
for let i=0; i<4; i=i+1 {
  if i {
    furina burst, skill, attack;
  }
  kaz burst;
  chev burst, skill[hold=1];
  kaz skill, high_plunge;
  klee attack, walk, attack, burst, walk, attack[travel=6], charge; 
  if !i {
    klee  attack, skill[bounce=3, mine=8], jump; 
  } else {
    klee attack[travel=6], charge; 
  }
  klee attack, skill[bounce=3, mine=8], jump;
 
  for let r = 5; r> 0; r = r - 1 {
    klee attack[travel=6], charge; 
  }  
  klee attack;
  kaz skill, high_plunge;
}

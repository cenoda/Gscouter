active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  xingqiu skill, dash, burst, attack;
  if .yaoyao.burst.ready {
    yaoyao burst, attack, skill;
  } else {
    yaoyao attack:2, skill;
  }
  while .xingqiu.skill.cd>180 {
    if .klee.skill.ready {
      klee attack, skill[bounce=3, mine=8], attack;
    }
    klee attack, walk;
  }
}

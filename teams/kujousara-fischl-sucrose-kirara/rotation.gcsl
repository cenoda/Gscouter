active sara;
sara skill;
for let i=0; i<4; i=i+1 {
  fischl attack:2, burst;
  kirara skill[hold=1], attack;
  sucrose attack, charge, skill, dash, attack, charge, burst, attack; 
  sara aim:2, skill, burst;
  
  fischl aim, skill;
  kirara burst, skill;
  sucrose attack, skill, dash;
  sara aim:1, skill, aim:5, skill;
  
  print("done");
}

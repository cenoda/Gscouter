active sara;
sara skill;
for let i=0; i<4; i=i+1 {
  fischl attack:2, burst;
  kirara skill[hold=1], attack;
  sara aim, burst;
  if .aetheranemo.burst.ready && .aetheranemo.energy == .aetheranemo.energymax {
    aetheranemo attack, skill[hold=1], burst;
  } else {
    aetheranemo attack, skill[hold=1], attack:2;
  }
  
  sara aim, skill;
  fischl attack:3, skill;
  kirara skill[hold=1], burst;
  sara aim;
  if .aetheranemo.burst.ready && .aetheranemo.energy == .aetheranemo.energymax {
    aetheranemo attack, skill[hold=1], burst;
  } else {
    aetheranemo attack, skill[hold=1], attack:2;
  }
  sara aim, skill;
  
  print("done");
}

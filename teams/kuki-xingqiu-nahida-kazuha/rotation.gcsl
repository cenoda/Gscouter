active xingqiu;
while 1 {
  if .xingqiu.skill.ready { xingqiu skill; }
  if .xingqiu.burst.ready { xingqiu burst; }
  if .nahida.skill.ready { nahida skill[hold=1]; }
  if .nahida.burst.ready { nahida burst; }
  if .kazuha.skill.ready { kazuha skill; }
  if .kazuha.burst.ready { kazuha burst; }
  if .kuki.skill.ready { kuki skill; }
  if .kuki.burst.ready { kuki burst; }
  kuki attack:4;
}

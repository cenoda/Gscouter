active kokomi;
for let x=0; x<4; x=x+1 {
  nahida skill, attack:2;
  if .nahida.burst.ready {
    nahida burst,attack;
  }
  kokomi attack, skill, dash;
  yelan skill,burst,attack:2;
  kuki attack,skill;
  kokomi attack, burst;
  while .kokomi.skill.cd > 165 {
    kokomi attack:2, dash, walk[f=2];
  }
}

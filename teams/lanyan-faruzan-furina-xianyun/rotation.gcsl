active furina;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  faruzan burst, skill;
  if .faruzan.weapon == .keys.weapon.favbow && !.faruzan.mods.favonius-cd {
    furina attack;
  }
  
  xianyun skill, low_plunge, burst;

  if .lanyan.burst.ready {
    lanyan burst;
  }
  
  while .lanyan.skill.ready {
    lanyan skill:2;
  }
  
  if .lanyan.sets.dpc >= 4 {
    lanyan attack, charge;
  }
  while .lanyan.status.xianyun-airborne-buff {
    lanyan jump;
    if .airborne {
      lanyan high_plunge[collision=rand()>0.4];
    }
    if .lanyan.status.xianyun-airborne-buff {
      lanyan dash;
    }
  }
  
  if .lanyan.burst.ready {
    lanyan burst;
  }
}

fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); 
      lanyan skill; set_player_pos(0, -3); 
      lanyan skill; 
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); 
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); 
    default:
      lanyan attack;
  }
}
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}
active beidou; 
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  beidou skill[counter=rand_counter()], burst;
  
  while .fischl.oz {
    lanyanDrivingCombo();
  }
  
  fischl attack:2, burst;
  
  nahida skill, attack, charge;
  
  beidou skill[counter=rand_counter()], attack;
  
  while .fischl.skill.cd > 30 {
    lanyanDrivingCombo();
  }
}

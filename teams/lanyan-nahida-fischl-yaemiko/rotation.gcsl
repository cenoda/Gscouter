fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); 
      lanyan skill; set_player_pos(0, -3); 
      lanyan skill; 
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); 
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); 
    default:
      lanyan attack;
  }
}
active yae;
for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill:3, attack;
  }
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  while .fischl.oz {
    lanyanDrivingCombo();
  }
}

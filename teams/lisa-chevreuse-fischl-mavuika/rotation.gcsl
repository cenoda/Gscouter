active lisa;
lisa attack;
for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:2;
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  
  if .mav.burst.ready {
    mav skill, burst, dash;
  } else {
    mav attack, skill;
  }
  
  lisa attack, burst, skill[hold=1];
  lisa attack:1, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
}

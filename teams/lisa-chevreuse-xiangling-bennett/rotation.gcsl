active lisa;
for let i=0; i<4; i=i+1 {
  lisa skill[hold=1], burst; 
  
  bennett burst, skill;
  
  chev burst, skill[hold=1]:3; 
  
  xiangling burst, skill, dash;
  
  bennett skill, attack;
  while .bennett.burst.cd {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
}

active lisa;
lisa attack;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  collei burst, skill;
  fischl attack:2, skill;
  lisa attack, burst, skill[hold=1], attack:2, charge, attack:2;
  zhongli skill[hold=1], dash, attack;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  collei attack, skill;
  fischl attack:2, burst;
  lisa attack:2, charge, attack:2, charge, attack, charge, attack, charge;
  print("rotation done");
}

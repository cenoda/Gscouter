active lisa;
lisa attack;
for let i=0; i< 4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  nahida skill, burst;
  fischl skill, attack:2;
  lisa attack, burst, attack, charge, attack:2, charge, attack:2;
  zhongli skill[hold=1], dash, attack;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  nahida attack:2, skill;
  fischl attack:2, burst;
  lisa skill, attack:3, skill, attack:3, charge, attack:3, dash, skill[hold=1];
  print("rotation done");
}

active lisa;
lisa attack;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
   }
  } 
  fischl attack, skill;
  tighnari skill, aim[weakspot=1], aim:2;
  lisa attack, burst, attack:3, skill[hold=1], attack, dash, attack:3;
  
  zhongli skill[hold=1], dash;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
   }
  } 
  fischl attack:2, burst;
  tighnari skill, aim[weakspot=1], aim:2, burst;
  lisa attack, dash, attack:3, charge, attack, dash, attack:3;
}

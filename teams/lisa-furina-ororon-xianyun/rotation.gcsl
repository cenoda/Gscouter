active ororon;
for let x=0; x<4; x=x+1 {
  ororon burst, skill;
  
  furina skill, dash, burst;
  
  while !.lisa.burst.ready {
    lisa attack;
  }
  lisa burst;
  
  xianyun skill, low_plunge, burst; 
  
  for let i=0;i<4;i=i+1 {
  
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
  
  xianyun attack:2; sleep(20); 
  
  while .furina.skill.cd > 60 || .lisa.energy < 65 {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.skill.ready {
      lisa skill[hold=1];
    } else if .lisa.normal > 3 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
}

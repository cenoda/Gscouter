active amy;
for let x=0; x<4; x=x+1 {
  fischl attack, skill;
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  while !.lisa.burst.ready {
	lisa attack;
  }
  lisa burst;
  
  xianyun skill, low_plunge, attack, burst; 

  for let i=0;i<3;i=i+1 {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
  
  fischl attack:2, burst;
  
  xianyun attack:2; sleep(20); 

  while .fischl.skill.cd > 30 || .lisa.energy < 65 {
  
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa low_plunge[collision=rand()>0.5], attack;
      }
    } else if .lisa.skill.ready {
      lisa skill[hold=1];
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
}

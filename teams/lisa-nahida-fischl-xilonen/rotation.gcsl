active lisa;
lisa attack;
for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;
  if i > 0 {
    xilonen burst;
  }
  nahida skill, attack;
  if .nahida.sets.ap >= 4 {
    nahida dash; pick_up_crystallize("any");
  }
  nahida burst;
  
  fischl skill, attack:2;
  
  lisa attack, burst;
  lisa skill[hold=1], attack, charge, dash:1, attack:3, charge; 
  
  xilonen skill, attack:2;
  
  fischl attack:2, burst;
  
  lisa attack:2, dash, attack:1;
  lisa skill[hold=1], attack:2, charge, attack:2;
}

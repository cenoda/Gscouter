fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}
active nahida;
  
for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack, burst;
  
  xingqiu skill, dash, burst, attack;
  
  lisa attack, burst, attack;
  
  beidou skill[counter=rand_counter()], attack, burst;
  
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3, dash; 
  lisa attack:3, dash, attack:3, skill[hold=1];
  
  beidou attack, skill[counter=rand_counter()]; 
}

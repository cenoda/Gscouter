# KQM Lohen quick guide, example team 4:
# Furina ED N1 Q > Escoffier EQ > Durin E N1 Q > Lohen [combo]
# Lohen's average combo as in Lohen / Durin / Nicole / Citlali:
# E 2[N1C] E/Q 4[N1C] E 5[N1C] E.
active furina;
furina skill, dash, attack, burst;
escoffier skill, burst;
durin skill, attack, burst;
lohen skill,
      attack, charge, attack, charge,
      skill;
if .lohen.burst.ready {
  lohen burst;
}
lohen attack, charge, attack, charge, attack, charge, attack, charge,
      skill,
      attack, charge, attack, charge, attack, charge, attack, charge, attack, charge,
      skill;

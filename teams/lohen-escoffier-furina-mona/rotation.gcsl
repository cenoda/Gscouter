# KQM Lohen quick guide, example team 8 (Freeze) with Furina:
# Furina ED N1 Q > Escoffier EQ > Mona EQ N1 > Lohen [combo]
# Freeze, so Lohen plays the guide's combo for Freeze teams:
# E 15-17[N1C] (N1 E), 15 strings (the guide's average is 15-16), then N1
# and Etched Into Bone and Soul.
active furina;
furina skill, dash, attack, burst;
escoffier skill, burst;
mona skill, burst, attack;
lohen skill,
      attack, charge, attack, charge, attack, charge,
      attack, charge, attack, charge, attack, charge,
      attack, charge, attack, charge, attack, charge,
      attack, charge, attack, charge, attack, charge,
      attack, charge, attack, charge, attack, charge,
      attack, skill;
if .lohen.burst.ready {
  lohen burst;
}

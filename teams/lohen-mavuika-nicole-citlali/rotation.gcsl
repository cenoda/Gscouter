# KQM Lohen quick guide, example team 2 with Citlali:
# Nicole EQ > Citlali EQ > Mavuika QE > Lohen [combo]
# Mavuika's E after her burst leaves Flamestrider when she swaps out, so
# her Ring of Searing Radiance stays off-field. Lohen's average combo as in
# Lohen / Durin / Nicole / Citlali: E 2[N1C] E/Q 4[N1C] E 5[N1C] E.
active nicole;
nicole skill, burst;
citlali skill, burst;
mavuika burst, skill;
lohen skill,
      attack, charge, attack, charge,
      skill;
if .lohen.burst.ready {
  lohen burst;
}
lohen attack, charge, attack, charge, attack, charge, attack, charge,
      skill,
      attack, charge, attack, charge, attack, charge, attack, charge, attack, charge,
      skill;

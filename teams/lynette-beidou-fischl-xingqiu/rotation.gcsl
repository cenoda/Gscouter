active beidou;
for let i=0; i<4; i=i+1 {
  let r = rand();
  fischl attack:2, burst;
  xingqiu skill, dash, burst, attack:1;
  lynette attack, burst;
  beidou attack, burst;
  lynette
    attack, skill,
    attack:2, dash,
    attack:3, dash,
    attack:2, dash;
  lynette attack:2;
  if r > 0.7 {
    beidou skill[counter=1];
  } else {
    beidou skill; 
  }
  fischl attack, skill, attack;
  lynette
  attack, skill,
  attack:2, charge,
  attack:3, charge,
  attack:2, dash,
  attack:2;
  r = rand();
  if r > 0.7 {
    beidou skill[counter=1], attack:2;
  } else {
    beidou skill, attack:2;
  }
}

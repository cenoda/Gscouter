fn LynettePlunge() {
  lynette jump;
  if .airborne {
    lynette high_plunge[collision=rand()>0.3];
  }
}
active faruzan;
for let i = 0; i < 4; i = i + 1 {
  faruzan skill, burst;
  
  while .lanyan.skill.ready {
    lanyan skill:2;
  }
  lanyan burst;
  
  xianyun skill, low_plunge, burst;
  
  if .lynette.burst.ready {
    lynette burst;
  }
  lynette skill;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge();
  
  if .lynette.burst.ready {
    lynette burst;
  }
  
  while .lynette.skill.cd {
    if .lynette.normal > 1 {
      lynette charge;
    } else {
      lynette attack;
    }
  }
  lynette skill;
  LynettePlunge(); lynette dash;
  LynettePlunge();
  lynette attack, charge, 
          attack, charge;
}

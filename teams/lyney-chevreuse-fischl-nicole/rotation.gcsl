active fischl;
for let i = 0; i < 6; i = i + 1 {
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  chevreuse burst, skill[hold=1];
  nicole skill, attack;
  lyney aim:3;
  if .lyney.burst.ready {
    lyney burst;
    delay(11);   
    lyney skill; 
  } else {
    lyney aim;
  }
  lyney aim;
  if i < 5 {
    lyney skill, aim;
  } else {
    lyney aim, skill;
  }
}

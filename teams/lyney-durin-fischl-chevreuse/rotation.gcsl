active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  
    chev burst, skill[hold=1]:3;

  durin skill, burst, skill;
  if is_even(i) {
    fischl attack:2, burst;
    lyney attack;
  } else {
    fischl skill, attack;
  }
  lyney aim:4;
  if .lyney.burst.ready {
    lyney burst;
    delay(11);
    lyney skill;
  } else {
    lyney aim;
  }
  if i < 3 { 
    lyney skill;
    lyney aim;
  } else {
    lyney aim;
    lyney skill;
  }
}

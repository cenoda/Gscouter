active bina;
for let i=0; i<6; i=i+1 {
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  mona burst, attack;
  lyney aim;
  mona attack, skill, attack;
  lyney aim; 
  if .lyney.burst.ready {
    lyney burst; delay(11); 
    lyney skill;
  } else {
    lyney aim;
  }
  lyney skill, aim:2;
}

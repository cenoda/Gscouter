active furina;
for let i=0; i<3; i=i+1 {
  if i {
    lyney aim:2;
    
  }
  
  furina skill, dash, burst; 
  
  bennett skill, burst;
  
  kokomi attack, skill, dash;
  
  lyney aim:4;
  if .lyney.burst.ready {
    lyney burst;
    delay(11); 
    lyney skill;
  } else {
    lyney aim;
  }
  lyney aim:1, skill;
}

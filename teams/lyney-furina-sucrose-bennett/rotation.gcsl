active furina;
let rotations = 5;
for let r = rotations; r > 0; r = r - 1 {
  if !.furina.skill.ready { 
    lyney aim;
  }
  if .furina.skill.ready { 
    if !.furina.burst.ready {
      bennett skill;
    }
    furina skill, walk;
    
    furina burst;
  }
    
  bennett burst, skill;
  
  sucrose attack, skill;
  
  lyney aim[weakspot=1], aim, aim, aim[weakspot=1];
  if .lyney.burst.ready {
    lyney burst;
    delay(15); 
    lyney skill;
  }
  else {
    lyney aim;
  }
      
  lyney skill;
}

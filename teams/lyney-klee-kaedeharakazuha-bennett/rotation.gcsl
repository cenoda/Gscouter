active lyney;
lyney aim[weakspot=1];
for let r = 4; r > 0; r = r - 1 {
  if .kazuha.burst.ready {
    kazuha burst;
  }
  bennett skill, burst;
  kazuha skill, high_plunge;
  klee attack, skill, dash;
  lyney aim[weakspot=1], aim;
  
  if .lyney.burst.ready {
    lyney burst;
    delay(11); 
    lyney skill;
  } else {
    lyney aim;
  }
  
  lyney aim, skill, aim;
}
sleep(9);

active mavuika;
for let i = 0; i < 4; i = i + 1 {
  mavuika skill;
  xilonen skill, attack:2;
  bennett skill, burst;
  lauma skill, dash;
  pick_up_crystallize("pyro");
  if !.mavuika.burst.ready {
    mavuika swap, charge; 
  }
  mavuika burst, charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, charge[final=1];
}

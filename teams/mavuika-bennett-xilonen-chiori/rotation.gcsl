let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash
     || ( char_id == .keys.char.chiori && action_id == .action.skill && !.chiori.status.chiori-a1-window )
     || ( char_id == .keys.char.xilonen && action_id == .action.skill )
     || ( char_id == .keys.char.mavuika && action_id == .action.charge ) {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}
active mavuika; 
mavuika skill;
xilonen skill, attack:2;
bennett skill, dash, burst;
chiori burst, skill:2;  
mavuika burst, charge:2, dash,
               charge:2, dash,
               charge:2, dash,
               charge:2, dash,
               charge:2, dash,
               charge:2, dash,
               skill;
for let i = 0; i < 2; i = i + 1 {
  xilonen skill, burst, attack:2;
  bennett skill, dash, burst;
  if .chiori.burst.ready {
    chiori burst;
  } else {
    chiori attack:2;
  }
  chiori skill:2; 
  mavuika charge, burst, charge:2, dash,
                         charge:2, dash,
                         charge:2, dash,
                         charge:2, dash,
                         charge:2, dash, 
                         charge, skill, dash;
}

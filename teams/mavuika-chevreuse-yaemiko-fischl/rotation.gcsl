let C2F = true;
active mavuika; 
for let i=0; i<4; i=i+1 {
  mavuika skill;
  yae skill:3;
  
  if .chev.burst.ready {
    chev burst, skill[hold=1]:3;
  } else {
    chev skill[hold=1], burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst; 
  }

  mavuika burst, 
    charge:14, dash;
  
}

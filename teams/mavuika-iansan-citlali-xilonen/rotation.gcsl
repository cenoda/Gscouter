# KQM Iansan quick guide, Iansan / Mavuika / Citlali / Bennett or Xilonen:
#   Mavuika tE > Xilonen E(Q) N2 > Iansan ECQ > Citlali EQ N1 > Mavuika [combo]
# Iansan's skill turns her next attack into Swift Stormflight, her
# enhanced charged attack (gcsim: skill, charge). Mavuika's burst combo
# (dash-cancelled charged attacks) is the one of the community config
# behind Mavuika / Citlali / Xilonen / Bennett (db.kqm.gg cdz8FgbKf7wk);
# the guide links Mavuika's Melt combos, which it follows.
fn mav_dc_cancel(d_travel_f) {
  if d_travel_f < 6 {
    d_travel_f = 6;
  }
  let dash_ns = 10;
  let base_cons = 0.9;
  let base_tick_rate = 6;
  while !.mavuika.dash.ready {
    wait(1);
  }
  let d_ticks = d_travel_f / base_tick_rate + 1;
  let ns_consumed = dash_ns + base_cons * d_ticks;
  if .mavuika.nightsoul.points > ns_consumed || .mavuika.status.mavuika-burst {
    mavuika dash[charge_cancel=1, travel=d_travel_f], charge;
  } else {
    mavuika jump;
  }
}
active mavuika;
mavuika skill;
xilonen skill, attack:2;
pick_up_crystallize("pyro");
iansan skill, charge, burst;
citlali skill, burst, attack;
mavuika burst;
mavuika charge;
mav_dc_cancel(6); mavuika charge:2, charge[hold=6], charge[final=1];
mav_dc_cancel(6); mavuika charge[final=1];
mav_dc_cancel(6); mavuika charge[final=1];
mav_dc_cancel(6); mavuika charge[final=1];

active mavuika;
mav skill;
for let i=0;i<5;i=i+1{
  
  if .layla.burst.ready{
    layla burst;
  }
  layla skill;
  if .layla.burst.ready{
    layla burst;
  }
  
  xilonen skill, attack:2;
  if .xilonen.burst.ready{
    xilonen burst;
  }
  
  if .rosa.burst.ready{
    rosa burst;
  }
  rosa skill;
  if .rosa.burst.ready{
    rosa attack:2, burst;
  }
  mavuika burst;
  sleep(60);
  mavuika charge:2, dash, charge:2, dash, charge:7, charge[final=1],  skill;
}

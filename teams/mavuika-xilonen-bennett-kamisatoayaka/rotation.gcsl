active mavuika;
for let x=0; x<4; x=x+1{
  mavuika skill;
  bennett skill, burst;
  xilo skill, attack:2;
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  ayaka skill, dash;
  pick_up_crystallize("any");
  ayaka burst;
  mav burst, charge:2, dash,
             charge:2, charge[final=1], dash,
             charge:2, dash,
             charge:2, dash,
             charge, dash;
  mavuika charge:4, dash;
}

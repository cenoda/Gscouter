active bina;
for let i=0; i<8; i=i+1 {
  if i && .columbina.burst.ready {
    columbina burst;
  }
  columbina skill;
  
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  }
  
  mona burst, attack, skill;
  
  sucrose skill, dash, attack;
  
  if .sucrose.burst.ready {
    sucrose burst;
  }
  
  mona charge, jump,
       charge, jump,
       charge, jump,
       charge;
  
  if .sucrose.skill.ready {
    sucrose attack, skill, jump;
  } else {
    sucrose attack:2, walk,
            attack:2;
  }
  
  mona attack:4;
}

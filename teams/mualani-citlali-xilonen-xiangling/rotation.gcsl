active mualani;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  mualani attack;
  xilonen burst, attack;
  citlali skill, attack;
  xiangling burst, skill, dash;
  xilonen skill, attack:2;
  mualani skill;
  mualani_combo();
  mualani walk[f=1];
  xilonen skill, attack:2;
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
  } else {
    mualani attack:3, charge;    
  }
}

active mualani;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  dehya skill:2;
  if ( i / 2 ) * 2 == i {
    emilie skill, attack;
    mualani burst;
  } else {
    emilie burst;
  }
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; 
  }
}

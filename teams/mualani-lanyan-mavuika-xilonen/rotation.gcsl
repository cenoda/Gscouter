fn mualani_combo() {
  mualani skill, 
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack;
}
fn mualani_combo2() {
  mualani skill, 
          walk[f=13], burst,
          walk[f=69], attack,
          walk[f=90], attack,
          walk[f=1];
}
active mavuika; 
for let i=0; i<3; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  lanyan skill:2;
  mavuika burst, charge, skill, dash;
  pick_up_crystallize("hydro"); 
  mualani_combo2();
  mualani attack, charge;
  xilonen skill, attack:2;
  lanyan skill:2, attack, burst;
  mavuika skill[hold=1], charge, dash;
  pick_up_crystallize("hydro");
  mualani_combo(); 
  mualani skill;
}

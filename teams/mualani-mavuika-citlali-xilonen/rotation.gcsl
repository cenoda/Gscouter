active mavuika;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  mualani dash, attack:2;
  citlali skill, attack; 
  xilonen skill, attack:2;
  mavuika burst, charge, skill, dash;
  mualani skill;
  mualani_combo();
  if is_even(i) {
    mualani burst;
  } else {
    mualani walk[f=1];
    xilonen burst;
    mualani attack:2;
  }
}

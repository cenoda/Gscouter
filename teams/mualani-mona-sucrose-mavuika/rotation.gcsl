active mavuika;
fn mualani_combo2() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<2; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
fn mualani_combo3() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<5; i=i+1 {
  
  mona attack, skill;
  
  mavuika burst, charge, dash, charge, dash, charge, skill;
 
  if is_even(i) {
    mona attack:2;
  }
  mona burst;
  
  sucrose skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;
  } 
 
  mualani skill;
  if .mualani.burst.ready {
    mualani walk, burst;
    mualani_combo2();
  }
  else {
    mualani_combo3();
  }

}

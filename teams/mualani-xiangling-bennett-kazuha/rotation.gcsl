active kazuha;
while 1 {
  kazuha skill;
  if .kazuha.burst.ready { kazuha burst; }
  if .xiangling.burst.ready { xiangling burst; }
  xiangling skill;
  if .bennett.burst.ready { bennett burst; }
  bennett skill;
  mualani skill;
  if .mualani.burst.ready { mualani burst; }
  while .mualani.nightsoul.state {
    if .mualani.momentum >= 3 {
      mualani attack;
    } else {
      mualani walk;
    }
  }
  mualani attack:3;
  while !.kazuha.skill.ready || !.mualani.skill.ready {
    mualani attack:3;
  }
}

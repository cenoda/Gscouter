active mavuika;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<2; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  diona skill[hold=1], burst, skill[hold=1];
  mavuika burst, jump;
  delay(9);
  mavuika charge:2, dash;
  mavuika skill;
  mualani skill;
  mualani_combo();
  mualani burst;
  
  mualani attack;
  xilonen skill, attack:2;
  diona skill[hold=1], burst, skill[hold=1];
  mavuika burst, jump;
  delay(9);
  mavuika charge:2, dash;
  mavuika skill;
  mualani skill;
  mualani_combo();
  mualani skill, dash, attack:2, charge, attack;
}

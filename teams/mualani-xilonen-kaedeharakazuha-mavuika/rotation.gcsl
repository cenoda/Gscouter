active mavuika;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  mualani attack;
  if i {
    mualani charge;
  }
  if .mavuika.cons == 0 { 
    xilonen skill, attack:2;
    kazuha skill, high_plunge;
  } else {
    kazuha skill, high_plunge;
    xilonen skill, attack:2;
  }
  mavuika burst, skill;
  mualani skill;
  mualani_combo();
  if is_even(i) {
    mualani burst;
  } else {
    mualani walk[f=1];
    xilonen burst, jump:2;
  }
}

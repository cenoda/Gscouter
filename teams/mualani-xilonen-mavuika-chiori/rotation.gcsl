active mavuika;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  mualani dash, attack;
  mavuika burst;                          pick_up_crystallize("any"); 
  mavuika charge:2, dash, skill, dash;    pick_up_crystallize("any");
  xilonen skill, attack:2;                pick_up_crystallize("any");
  chiori skill:2;
  mualani skill;
  mualani_combo();                        pick_up_crystallize("any"); 
  if is_even(i) { 
    mualani burst;
  } else {
    mualani skill;
    chiori burst;  
  }
}

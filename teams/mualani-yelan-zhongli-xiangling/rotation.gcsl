active yelan;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
for let i=0; i<4; i=i+1 {
  yelan skill, attack:2, burst, attack;
  zhongli skill[hold=1], dash, attack;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  xiangling burst, skill, dash;
  let mq=0;
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
    mq=1;
  }
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; 
  }
  mualani attack:2, dash; 
  if mq==0 {
    mualani attack:3, charge;
  }
}

active mualani;
fn mualani_combo() {
  
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}
mualani attack; 
for let i=0; i<2; i=i+1 {
  zhongli skill[hold=1], dash;
  lynette skill;
  xiangling burst, skill, dash;
  pick_up_crystallize("hydro");
  
  mualani skill;
  mualani_combo();
  mualani burst;
  delay(2); 
  while !.element.t0.hydro {
    mualani attack;
  }  
  
  zhongli skill[hold=1], dash;
  lynette skill;  
  xiangling skill, dash, attack;
  pick_up_crystallize("hydro"); 
  lynette burst, attack:2;
  
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; 
  }
  while !.element.t0.hydro {
    mualani attack;
  }
}

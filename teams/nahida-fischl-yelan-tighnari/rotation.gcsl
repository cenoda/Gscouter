active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  nahida skill, burst, attack;
  tighnari skill, aim, burst, aim:2;
  nahida skill, attack:2, charge;
  yelan burst, skill, attack;
  fischl attack:2, burst;
  nahida skill, attack:2;
  tighnari attack:2, skill, attack:2, aim, attack:2, aim, attack:2, aim, attack;
  nahida attack:3, dash, attack:3;
  yelan skill, attack:2;
}

active nahida;
for let i=0; i<4; i=i+1 {
    nahida attack, skill, burst;
	kuki skill, attack;
    collei burst, skill;
    kamisatoayato skill, attack:15, burst;
    nahida attack:2, skill, attack, charge;
	kuki burst, skill, attack;
	collei burst, skill;

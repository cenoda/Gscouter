active yae;
for let x = 0; x < 3; x = x + 1 {
    yae skill:3;
   
  nahida skill, burst, attack;
  furina skill, dash, burst; 
  xianyun attack, skill, low_plunge, burst;
  yae attack, jump, high_plunge[collision=1];
  if .yae.burst.ready {
    yae burst;
  }
  yae skill:2, attack ,skill,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], attack;
  xianyun attack:2;
  nahida skill, attack, charge;
  yae attack, jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], attack,
      jump, low_plunge[collision=1];
  
}

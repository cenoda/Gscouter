let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any"); 
  }
    
  return _execute_action(char_id, action_id, p);
}
active navia;
for let x=0; x<4; x=x+1 {
  navia burst;
  chiori skill:2;
  yelan attack, skill, burst, attack;
  if !.yelan.mods.favonius-cd {
    yelan attack;
  }
  bennett skill, burst, attack;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  yelan attack, skill, attack;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1], attack;
  } else {
    bennett skill, attack;
  }
    
  }

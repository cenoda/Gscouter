let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active navia;
for let x=0; x<3; x=x+1 {
  navia burst;
  bennett skill, burst;
  fischl attack:2, burst;      pick_up_crystallize("any"); 
  tighnari skill, aim:3; 
  print(.navia.shrapnel);
  navia skill[hold=1], attack:3, dash, attack:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  fischl attack, skill;
  tighnari skill, aim, burst, aim:2;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash;
}

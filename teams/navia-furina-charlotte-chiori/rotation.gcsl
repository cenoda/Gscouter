let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active navia;
for let x = 0; x < 4; x = x + 1 {
  navia burst;
  furina skill, dash, burst;
  charlotte attack, skill, burst, attack;
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  chiori skill:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .chiori.burst.ready && (.chiori.energy == .chiori.energymax) {
    chiori burst;
  } else {
    chiori attack:3;
  }
  charlotte attack:3, dash;
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  navia skill[hold=1], attack:3, dash, attack:2; 
  if .navia.skill.ready {
    navia skill[hold=1];
  }
}

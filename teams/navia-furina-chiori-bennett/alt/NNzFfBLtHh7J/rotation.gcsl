let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active chiori;
chiori skill:2;
navia burst; 
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack:2;
  if i {
    navia burst;
  }
  bennett skill, burst;
  chiori skill:2;
  navia dash;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  chiori skill:2;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack;
  if .navia.skill.ready {
    navia skill, attack:2; 
  } else {
    navia attack, dash; 
  }
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active furina;
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  navia burst;
  bennett skill, burst;
  xianyun attack, skill, low_plunge, attack, burst;  pick_up_crystallize("any"); 
  for let n=0; n<2; n=n+1 {
    if !.xianyun.mods.favonius-cd {
      xianyun attack;
    }
  }
  navia skill[hold=1];
  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      navia jump, high_plunge[collision=1], dash;
    } else {
      navia jump, high_plunge, dash;
    }
  }
  navia skill[hold=1];
  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      navia jump, high_plunge[collision=1], dash;
    } else {
      navia jump, high_plunge, dash;
    }
  }
  bennett skill, dash;
}

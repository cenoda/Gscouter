let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) || ( char_id == .keys.char.shenhe && action_id == .action.skill ) || ( char_id == .keys.char.rosaria && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}
active navia; 
rosaria skill;
for let i = 0; i < 4; i = i + 1 {
  if !is_even(i) {
    xilonen burst;
  }
  xilonen skill, attack:2;
  
  navia burst;
  
  shenhe skill, burst;
  
  rosaria skill, burst;
  
  if i == 0 {
    navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  } else {
    navia skill[hold=0], attack:2, dash, attack:2, dash, attack:2;
  }
  
  if i == 0 {
    shenhe skill, attack;
  } else {
    shenhe attack, skill, attack;
  }
  rosaria skill;
  
  if i == 0 {
    navia skill[hold=0], attack:2, dash, attack:2, skill;
  } else if i == 3 {
    navia skill[hold=0], attack:2, dash, attack:2, skill;
  } else {
    navia skill[hold=0], attack:2, dash, attack:2, dash, attack:2;
  }
}

let prev_char_id = -1;
let prev_action_id = -1;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( prev_char_id == .keys.char.rosaria && prev_action_id == .action.skill ) { 
    let rngVal = rand();      
    let shards = 0;
    if rngVal < 0.6 {
      shards = 1;
    } else if rngVal < 0.9 {
      shards = 2;
    } else {
      shards = 3;
    }
    for let i = 0; i < shards; i = i+1 {
      pick_up_crystallize("any"); 
    }
  }   
  
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}
active rosaria;
for let i=0; i<4; i=i+1 {
	rosaria skill;
	navia burst;
	layla burst, skill;
	yunjin skill, burst;
	rosaria skill, burst;
	navia skill, attack:3, dash, attack:3;
	navia skill[hold=1], attack:3;
}
wait(20);

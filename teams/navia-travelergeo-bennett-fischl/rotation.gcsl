fn rand_delay(mean, stddev) {
  let del = randnorm() * stddev + mean;
  if del > (mean + mean) {
    del = mean + mean;
  }
  delay(del);
}
let prev_char_id = -1;
let prev_action_id = -1;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }

  if action_id == .action.swap {
    
    rand_delay(12, 3);
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    
    rand_delay(3, 1);
  } else if prev_action_id != .action.attack {
    
    rand_delay(3, 1);
  }
  
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}
active navia; 
for let i=0; i<4; i=i+1 {
  navia burst;
  bennett skill, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst; pick_up_crystallize("any");
  } else {
    fischl attack, skill, dash; pick_up_crystallize("any");
  }
  aethergeo burst, skill[short_hold=1];
  navia skill[hold=1], attack:3, dash, attack;
  bennett skill, dash; pick_up_crystallize("any");
  aethergeo skill[short_hold=1], dash; pick_up_crystallize("any");
  navia skill[hold=1], attack;
}

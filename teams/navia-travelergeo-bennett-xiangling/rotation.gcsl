let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active luminegeo;
for let i=0; i<4; i=i+1 {
  luminegeo burst, skill[short_hold=1], attack;
  if !.luminegeo.mods.favonius-cd {
    luminegeo attack;
  }
  navia burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  navia skill[hold=1], attack:3, dash, attack:2;
  luminegeo skill[short_hold=1], attack:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1];
  }
  bennett skill, dash;
}

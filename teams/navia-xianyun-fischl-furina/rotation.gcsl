active fischl;
for {
	switch {
		case .navia.mods.navia-a1-dmg && .navia.swap.ready && .navia.mods.xianyun-airborne-buff > 120:
			navia dash, jump; 
			if .airborne { navia high_plunge; }
		case .fischl.skill.ready && .fischl.swap.ready && !.fischl.oz:
			fischl skill, attack;
		case .fischl.burst.ready && .fischl.swap.ready && !.fischl.oz:
			fischl attack:2, burst;
		case .furina.burst.ready && .furina.swap.ready:
			if .furina.skill.ready { furina skill; }
			furina burst;
		case .furina.skill.ready && .furina.swap.ready && !.furina.status.furina-skill:
			furina skill;
		case .navia.burst.ready && .navia.swap.ready:
			navia burst;
		case .xianyun.burst.ready && .xianyun.swap.ready:
			xianyun burst;
		case .xianyun.skill.ready && .xianyun.swap.ready:
			xianyun skill, high_plunge;
		case .navia.skill.ready && .navia.swap.ready:
			navia skill[hold=!(.navia.shrapnel>=6)];
		
		case .navia.onfield:
			navia attack;
		case .xianyun.onfield:
			xianyun attack;
		case .fischl.onfield:
			fischl attack;
		case .furina.onfield:
			furina attack;
	}
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any"); 
  }
  return _execute_action(char_id, action_id, p);
}
fn naviaskill() {
  if .navia.shrapnel >=3 { 
    navia skill;
  } else {
    navia skill[hold=1];
  }
}
active navia;
for let i=0; i<4; i=i+1 {
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  navia burst;
  durin skill, attack, burst;              print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  delay(4);
  xilonen skill, attack:2;                 print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  if ( i / 3 ) * 3 == i {
    naviaskill();
    
  }
}

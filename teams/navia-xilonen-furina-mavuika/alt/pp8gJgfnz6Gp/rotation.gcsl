let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active mavuika;
fn naviaskill() {
  if .navia.shrapnel == 6 { 
    navia skill;
  } else {
    navia skill[hold=1];
  }
}
for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  furina skill, dash, attack;
  xilonen skill, attack:2;
  navia burst;
  furina burst, attack;
  mavuika burst, charge, dash;                      print(.navia.shrapnel);
  naviaskill();
  navia attack:2, dash, attack:2, dash, attack:2;   print(.navia.shrapnel);
  xilonen skill, attack:2;                          print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash;                             print(.navia.shrapnel);
  if i == 0 || i == 3 {
    naviaskill();
  } else {
    navia attack:2;
  }
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli skill[hold_nostele=1], dash;
  while !.zhongli.mods.favonius-cd { 
    zhongli attack; 
  }
  for let n=0; n<3; n=n+1 { 
    if !(.navia.burst.ready && .navia.energy == .navia.energymax) {        
      navia attack;      
    }
  }
  if x==0 {
    navia skill; 
  }
  navia   burst;
  bennett skill, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst; pick_up_crystallize("any"); 
  } else {
    fischl attack, skill;
  }
  navia   skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack:2; 
  navia   dash, skill[hold=1], attack:3, dash; 
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active yae;
for let x=0; x<4; x=x+1 {
  yae skill:3;
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd { 
    zhongli attack; 
  }
  navia burst;
  if .fischl.skill.ready {
    fischl attack, skill, dash;
  } else {
    fischl attack:2, burst; pick_up_crystallize("any");
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2, dash;     print(.navia.shrapnel);
  if x<3 { 
    navia skill, attack:3, dash, attack:2;
  } else { 
    navia attack, dash, skill, attack:2, dash, attack:2, dash, attack:2;
  }
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active zhongli;
for let x = 0; x < 4; x = x + 1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
      zhongli attack;
  }
  navia burst; 
  furina skill, dash, burst;
  charlotte skill, burst, attack;
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2; 
  zhongli attack:2, skill;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  charlotte attack:2, dash; 
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  navia skill[hold=1], attack:3, dash, attack:2; 
  if .navia.skill.ready {
    navia dash, skill[hold=1];
  }
}

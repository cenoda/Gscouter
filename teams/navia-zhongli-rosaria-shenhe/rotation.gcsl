let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd { 
    zhongli attack; 
  }
  navia burst;
  shenhe attack, skill, burst;  pick_up_crystallize("any"); 
  if !.shenhe.mods.favonius-cd { 
    shenhe attack;     
  }
  rosaria skill, burst;         pick_up_crystallize("any"); 
  if !.rosaria.mods.favonius-cd {
    rosaria attack;              
  }
  navia skill[hold=1], attack:3, dash, attack:2;  
  shenhe attack, skill, attack; pick_up_crystallize("any"); 
  if !.shenhe.mods.favonius-cd { 
    shenhe attack;     
  } 
  rosaria skill;                pick_up_crystallize("any"); 
  navia skill, attack:3, dash, attack:2, dash;
  print(.navia.shrapnel);
  if .navia.skill.ready {
    navia skill;
  }
}

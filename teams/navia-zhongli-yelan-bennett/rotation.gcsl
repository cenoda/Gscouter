let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any"); 
  }
    
  return _execute_action(char_id, action_id, p);
}
active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd { 
    zhongli attack; 
  }
  navia   burst;
  yelan skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  bennett skill, burst;
  navia   skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack;
  navia   skill[hold=1], attack:3, dash, attack:2;
}

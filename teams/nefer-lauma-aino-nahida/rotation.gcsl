# Lauma quick guide, Nefer / Lauma / Aino / Nahida:
#   (Nefer E)1 > Aino E Q > Nahida E Q > Lauma tE Q > Nefer E 3[CD] E 3[CD]
#   1 first rotation only, for Verdant Dew stacking
# Nefer's charged attacks are held (Slither) until Verdant Dew turns them
# into Phantasm Performance, as the guide says she may need to wait for
# Dew; her burst replaces a dash when ready (Nefer quick guide:
# E 3[CD] E CD CQ CD).
active nefer;
let first = 1;
if first == 1 {
  nefer skill;
  first = 0;
}
aino skill;
if .aino.burst.ready {
  aino burst;
}
nahida skill;
if .nahida.burst.ready {
  nahida burst;
}
lauma skill;
if .lauma.burst.ready {
  lauma burst;
}
nefer skill, charge[hold=150], dash, charge[hold=150], dash, charge[hold=150], dash,
      skill, charge[hold=150], dash, charge[hold=150];
if .nefer.burst.ready {
  nefer burst;
} else {
  nefer dash;
}
nefer charge[hold=150], dash;

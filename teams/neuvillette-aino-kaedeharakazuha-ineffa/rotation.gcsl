active neuvillette;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  aino burst, skill;
  ineffa skill, attack;
  kazuha skill, high_plunge, burst;
  neuvillette charge, burst, skill, charge;
  kazuha skill, high_plunge;
  if .ineffa.burst.ready {
    ineffa burst;
  }
  aino skill, attack;
  neuvillette charge:2;
}
wait(173);

active neuvillette;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  citlali skill, attack:2;
  furina burst;
  charlotte skill[hold=1], burst;  
  neuvillette charge, skill, charge, burst;
  charlotte attack:3;
  if !.charlotte.mods.favonius-cd {
    charlotte dash, attack;
  }
  neuvillette charge, charge;
}
wait(173);

active neuv;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  if !i {
    durin skill, attack, burst;
  } else {
    durin burst, skill, attack;
  }
  fischl attack, skill;
  furina burst;
  neuvillette charge, burst, skill, charge;
  durin skill, attack;
  fischl attack:2, burst;
  neuvillette charge:2;
}
wait(173);

active neuvillette;	
for let i = 0; i < 4; i = i + 1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  kazuha skill, high_plunge, burst;
  furina burst;
  charlotte skill, burst, attack; 
  if !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  neuvillette charge, skill, charge, burst;
  kazuha skill, high_plunge;
  neuvillette charge, charge;
}
wait(173);

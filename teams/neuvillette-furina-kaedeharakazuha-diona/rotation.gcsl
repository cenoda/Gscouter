active neuvillette;	
for let i = 0; i < 4; i = i + 1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  kazuha skill, high_plunge, burst;
  diona skill[hold=1], burst;
  if !.diona.mods.favonius-cd {
    diona attack;
  }
  furina burst;
  neuvillette charge, skill, charge, burst;
  kazuha skill, high_plunge;
  neuvillette charge, charge;
}
wait(173);

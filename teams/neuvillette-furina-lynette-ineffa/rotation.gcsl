active neuvillette;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  ineffa skill, attack;
  if i && .ineffa.burst.ready {
    ineffa burst;
  }
  lynette skill, attack, burst;
  furina burst;
  neuvillette charge, burst, skill, charge;
  lynette skill, attack;
  neuvillette charge:2;
}
wait(173);

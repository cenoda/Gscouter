active neuvillette;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) || ( char_id == .keys.char.neuv && action_id == .action.charge ) {
    pick_up_crystallize("any"); 
  }
  return _execute_action(char_id, action_id, p);
}
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina skill, attack, dash; 
  navia burst;
  xilonen skill, burst, attack:2;
  furina burst;
  navia skill[hold=0], attack;
  neuvillette charge, burst, skill, charge;
  xilonen skill, attack:2;
  navia skill[hold=0], attack;
  neuvillette charge, charge;
}
wait(173);

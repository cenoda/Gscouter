active neuvillette;
for let x=0; x<4; x=x+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  ororon skill, attack, burst;
  xianyun skill, low_plunge, burst;
  furina burst;
  neuvillette charge, skill, charge, burst;
  xianyun skill, low_plunge;
  if !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  neuvillette charge:2;
}
wait(173);

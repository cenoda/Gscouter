active zhongli;
while 1 {
  zhongli skill[hold=1];
  furina skill;
  if .furina.burst.ready { furina burst; }
  yelan skill;
  if .yelan.burst.ready { yelan burst; }
  neuvillette skill;
  if .neuvillette.burst.ready { neuvillette burst; }
  neuvillette attack, charge;
  neuvillette attack, charge;
  neuvillette attack, charge;
  neuvillette attack, charge;
  neuvillette attack, charge;
}

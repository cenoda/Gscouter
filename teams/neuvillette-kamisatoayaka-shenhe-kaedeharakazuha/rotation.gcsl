active shenhe;
for let i = 0; i < 3; i = i + 1 {
  shenhe attack, skill, burst;
  neuv skill, attack;
  kazuha skill, high_plunge, burst;
  ayaka skill, dash, attack, burst;
  shenhe attack, skill[hold=1], attack;
  if !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  neuv charge, skill, burst;
  kazuha attack, skill, high_plunge;
  ayaka skill;
  neuv charge, charge, charge;
}
wait(173);

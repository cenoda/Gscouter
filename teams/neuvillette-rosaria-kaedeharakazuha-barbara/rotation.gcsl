active neuv;
for let i = 0; i < 3; i = i + 1 {
  neuv skill, attack:3;
  kazuha skill, high_plunge, burst;
  barbara skill, attack;
  while ( !.barbara.mods.favonius-cd ) {
    barbara attack;
  }
  rosaria skill, burst, attack;
  while ( !.rosaria.mods.favonius-cd ) {
    rosaria attack;
  }
  kazuha skill, high_plunge;
  neuv charge, skill, charge, burst;
  
  kazuha skill, high_plunge;
  barbara attack:2, dash;
  while ( !.barbara.mods.favonius-cd ) {
    barbara attack;
  }
  rosaria skill;
  while ( !.rosaria.mods.favonius-cd ) {
    rosaria attack;
  }
  neuv charge:2;
}
wait(173);

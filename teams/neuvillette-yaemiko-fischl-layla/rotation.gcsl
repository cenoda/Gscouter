active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv burst;
  layla skill, attack;
  yae skill:3;
  fischl attack, skill;
  neuv charge, charge, skill, attack:3;
  layla burst, skill;
  if .yae.burst.ready {
    yae burst, skill:3;
    fischl attack:2, burst;
  } else {
    yae attack, skill, attack, skill, attack, skill;
    fischl attack:4, burst;
  }
  neuv charge, skill, charge;
}
wait(173);

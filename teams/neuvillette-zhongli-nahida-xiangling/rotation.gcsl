active neuvillette;
for let i=0; i<4; i=i+1 { 
  neuvillette skill, attack:2;
  sleep(25);
  zhongli skill[hold=1], dash;
  pick_up_crystallize("hydro");
  nahida skill, burst;
  xiangling burst, skill;
  neuvillette charge, skill, charge, burst;
  pick_up_crystallize("any");
  zhongli skill[hold=1],dash;

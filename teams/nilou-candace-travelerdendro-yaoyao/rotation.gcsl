active nilou;
for let i=0; i<4; i=i+1 {
  nilou skill, attack:2, skill;
  travelerdendro skill, attack:2,burst;
  candace skill, burst, attack:2;
  yaoyao burst, dash,
   attack:3, dash,
   attack:3, dash,
   attack, dash,
   attack,
   skill;
  travelerdendro skill, attack:3;
  candace skill, attack:3;
  nilou attack;
  if .nilou.burst.ready {
    nilou burst;
  } else {
    nilou attack:2;
  }
}

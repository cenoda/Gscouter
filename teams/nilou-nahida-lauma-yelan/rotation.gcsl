active nahida;
while 1 {
  nahida skill[hold=1];
  lauma skill;
  if .lauma.burst.ready { lauma burst; }
  yelan skill;
  if .yelan.burst.ready { yelan burst; }
  nilou skill;
  nilou skill;
  nilou skill;
  nilou skill;
  if .nilou.burst.ready { nilou burst; }
  nilou attack:3;
  if .nahida.burst.ready { nahida burst; }
  yelan aim:5;
}

let normal_attack_state = 1;
let c_left = 0;
let c_twirl = 2;
active zl;
for {
  switch {
    case !.zhongli.tags.shielded && .zhongli.swap.ready:
      zhongli skill[hold=1], dash;
    case .chiori.skill.ready && .chiori.swap.ready:
      chiori skill:2;
    case .albedo.skill.ready && .albedo.swap.ready &&  !.albedo.elevator:
      albedo skill, attack;
    case .ningguang.skill.ready && .ningguang.swap.ready && (!.status.bennettburst || .ningguang.mods.bennett-field):
      ningguang skill, dash;
    case .ningguang.burst.ready && .ningguang.swap.ready:
      ningguang burst, walk;
    case .ningguang.jadeCount == 7 && .ningguang.swap.ready:
      ningguang charge;
    case .ningguang.onfield && .state == normal_attack_state:
      if .ningguang.prevAttack == c_left || .ningguang.prevAttack == c_twirl {
        ningguang charge;
      } else {
        ningguang walk;
      }
    case .chiori.burst.ready && .chiori.swap.ready:
      chiori burst;
    default:
      ningguang attack;
  }
}

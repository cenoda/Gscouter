let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any"); 
  }
  return _execute_action(char_id, action_id, p);
}
active mavuika;
bennett skill;
for let x=0; x<5; x=x+1 {
  xilonen skill, attack:2;
  if x {
    bennett skill, burst;
  } else {
    bennett dash,  burst, skill;
  }
  mavuika burst, charge:2, dash, charge, skill, dash;
  ningguang attack, skill, dash, attack, charge;
  xilonen skill, attack:2;
  ningguang burst, skill, dash, charge, attack, dash, attack, dash, attack, charge, attack;
}

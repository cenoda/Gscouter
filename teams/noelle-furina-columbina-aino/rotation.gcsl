let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}
active columbina;
for let i=0; i<4; i=i+1 {
  if i > 0 && (.columbina.burst.ready && .columbina.energy == .columbina.energymax) {
    columbina skill, burst;
  } else if i > 0 {
    columbina skill, attack;
  } else {
    columbina skill;
  }
  
  furina skill, burst;
  
  aino skill, burst;
  
  noelle skill, burst, 
    charge[no_limit=1]:18, charge[final=1];
}

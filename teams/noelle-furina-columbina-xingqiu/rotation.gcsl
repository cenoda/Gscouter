let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}
active columbina;
for let i=0; i<4; i=i+1 {
  if i > 0 && (.columbina.burst.ready && .columbina.energy == .columbina.energymax) {
    columbina skill, attack, burst;
  } else if i > 0 {
    columbina skill, attack;
  } else {
    columbina skill;
  }
  
  furina skill, dash, burst;

  xq burst, attack, skill, dash, attack;
  
  noelle skill, attack, burst;
  noelle attack:3, dash;
  noelle attack:3, dash;
  noelle attack:3, dash;
  noelle attack:4;
}

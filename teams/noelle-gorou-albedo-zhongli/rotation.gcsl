active albedo;
while 1 {
  if .albedo.skill.ready { albedo skill; }
  if .gorou.skill.ready { gorou skill; }
  if .gorou.burst.ready { gorou burst; }
  if .zhongli.skill.ready { zhongli skill[hold=1]; }
  if .albedo.burst.ready { albedo burst; }
  if .noelle.skill.ready { noelle skill; }
  if .noelle.burst.ready { noelle burst; }
  if .noelle.mods.noelle-burst > 0 {
    while .noelle.mods.noelle-burst > 0 {
      noelle attack:4;
    }
  } else {
    noelle attack:4;
  }
}

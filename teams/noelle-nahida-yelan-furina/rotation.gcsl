active nahida;
for let x=0; x<4; x=x+1 {
  if x==0 {
    nahida skill, burst;
  } else {
    nahida skill, attack; 
    if .nahida.burst.ready {
      nahida burst;
    }
  }
  
  furina skill, dash, burst;
  
  yelan burst, attack, skill, attack;

  noelle skill, attack, burst;
  pick_up_crystallize("hydro");
  
  while !.yelan.skill.ready {
    if .noelle.normal > 3 {
      if .yelan.mods.archaic-4pc {
        noelle dash;
        pick_up_crystallize("hydro");
      } else {
        noelle dash;
      }
    } else {
      noelle attack;
    }
  }

  yelan skill, attack;

  noelle attack:4;
  pick_up_crystallize("hydro");

}

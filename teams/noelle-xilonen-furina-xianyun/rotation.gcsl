let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilo && action_id == .action.skill ) {
    pick_up_crystallize("any"); 
  }
  return _execute_action(char_id, action_id, p);
}
active noelle; 
for let i = 0; i < 4; i = i + 1 {
  
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  xilonen skill, attack:2;
  
  noelle burst;
  while .xianyun.status.xianyun-airborne-buff {
    noelle jump;
    if .airborne {
      noelle high_plunge[collision = rand() > 0.33], dash;    
    }
  }
  if .xianyun.cons > 0 {        
    xianyun skill, low_plunge; 
  }
  
  xilonen skill, attack:2;
  
  if .noelle.skill.ready {      
    noelle skill;
  }
  if .xianyun.cons > 0 {
    noelle attack:2;
  } else {
    noelle attack:3;
  }
}

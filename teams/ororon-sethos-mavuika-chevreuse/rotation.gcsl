active mav;
for let i=0; i<4; i=i+1 { 
  ororon skill, burst;
  chev burst, skill[hold=1];
  mav burst, charge, skill, dash;
  sethos skill, burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack; 
  sethos aim[hold=2], skill;
}

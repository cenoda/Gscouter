active amy;
amy skill;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  amy attack;
  if .amy.burst.ready { 
    amy attack, burst; 
  } else { 
    amy skill; 
  }
  
  if .qiqi.skill.ready {
    qiqi skill;
  } else if .qiqi.burst.ready {
    qiqi burst;
  }
  while .qiqi.status.xianyun-airborne-buff {
    qiqi jump;
    if .airborne {
      qiqi high_plunge[collision=rand()>0.5];
    }
    if .qiqi.status.xianyun-airborne-buff { 
      qiqi dash;
    }
  }
  while .furina.skill.cd {
    if .qiqi.normal > 1 && .stam > 25 {
      qiqi charge;
    } else {
      qiqi attack;
    }
  }
}

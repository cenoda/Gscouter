active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  sara skill;
  
  chevreuse burst, skill[hold=1]:3;
  
  sara aim;
  
  durin attack, skill, burst, skill; 
  
  sara skill, aim, burst;
  raiden burst, 
         attack:4, skill, 
         attack:4, dash, 
         attack:4, dash, 
         attack:4;
}

active mav; 
raiden attack, skill;
for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;
  
  if i > 0 && .mav.burst.ready {
    mav burst, charge:2, dash, skill, dash;
  } else {
    mav skill, attack;
  }
  
  chevreuse burst, skill[hold=1]:3;
  
  bennett skill;
  if .raiden.burst.cd {
    bennett attack;
  }
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}

active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  if .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack, charge;
  }
  
  nicole skill, burst;
  
  durin skill, burst, skill;
  
  raiden burst, 
         attack:4, dash, 
         attack:4, dash, 
         attack:4, skill, 
         attack:4;
}

active raiden;
raiden skill;
for let i=0; i<4;i=i+1 {
  baizhu skill, burst;
  
  durin skill, burst, skill;
  
  fischl attack:2, burst;
  
  raiden burst, 
         attack:4, skill, 
         attack:4, dash, 
         attack:4, dash, 
         attack:4;
  
  while .baizhu.burst.cd > 40 {
    if .amy.skill.ready {
      amy attack, skill;
    }
    baizhu attack;
  }
}

active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  nicole skill, attack, burst;
  
  if i > 0 && .amy.skill.ready {
    amy attack, skill;
  }
  
  durin attack, skill, burst, skill; 
  
  fischl attack:2, burst;
  raiden burst, 
         attack:4, skill, 
         attack:4, dash, 
         attack:4, dash, 
         attack:4;
}

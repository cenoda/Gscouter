active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  emilie burst;
  
  fischl attack:2, burst;
  
  bennett attack, skill;
  
  while .raiden.burst.cd {
    raiden attack;
  }
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  }
}

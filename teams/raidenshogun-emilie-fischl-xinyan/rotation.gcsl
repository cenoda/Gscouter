active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  emilie burst;
  
  fischl attack:2, burst;
  
  while .xinyan.skill.cd {
    xinyan attack;
  }
  xinyan skill, burst;
  while .raiden.burst.cd {
    xinyan attack;
  }
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  }
}

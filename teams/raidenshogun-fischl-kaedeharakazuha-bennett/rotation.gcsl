active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  kazuha skill, high_plunge;
  bennett skill, burst;
  fischl attack:2;
  while !.fischl.burst.ready { 
    fischl attack;
  }
  fischl burst;
  kazuha burst, attack, skill, high_plunge;
  raiden burst, attack:4, dash, attack:4, dash, attack:4, skill, attack:4;
  if .fischl.skill.ready {
    fischl skill, attack;
  }
}

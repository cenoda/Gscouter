active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  let startFrame = f();
  while !pick_up_crystallize("electro") && f() - startFrame < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  nahida skill, burst, attack;
  fischl attack:2, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  if ( i / 2 ) * 2 == i {
    nahida attack:2, charge;
    fischl attack, skill;
  } else {
    zhongli burst;
  }
}

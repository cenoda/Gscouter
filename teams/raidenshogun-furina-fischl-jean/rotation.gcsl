active raiden;
raiden skill;
for let i=0; i<4; i=i+1 { 
	furina skill, dash, burst;
	
	fischl attack:2, burst;
	
	jean skill, burst;
	
	raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
	
	jean skill;
	
	if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    jean attack:1;
  }
}

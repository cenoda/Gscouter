let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.chiori && action_id == .action.skill ) || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any"); 
  }
  return _execute_action(char_id, action_id, p);
}
active raiden;
raiden skill;
for let x = 0; x < 5; x = x + 1 {
  xilonen burst, skill, attack:2;
  chiori skill, burst;
  sara skill, dash, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}

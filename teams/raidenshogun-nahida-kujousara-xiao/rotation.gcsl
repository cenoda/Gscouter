active raiden;
raiden skill;
nahida skill, attack;
for let rot = 1; rot <= 5; rot = rot + 1 {
  sara skill, aim;
  xiao skill:2, burst;
  for let x = 1; x <= 10; x = x + 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  nahida burst, skill;
  sara skill, aim, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}

active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  bennett skill, burst;
  if i==0 || i==2 {
    chevreuse burst, skill[hold=1]:3;
  } else {
    chevreuse burst, skill[hold=1];
    yae burst, skill:3;
    bennett attack, skill; 
  }
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  if i==1 || i==3 {
    yae attack:3, dash; 
  }
}

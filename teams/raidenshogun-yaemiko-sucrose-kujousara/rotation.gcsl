active raiden;
  raiden skill;
for let i=0; i<4; i=i+1 {
  yaemiko skill, skill, skill;
  sucrose skill, burst, attack:2;
  sara skill, aim;
  wait(12);
  yaemiko burst, skill, skill, skill;
  if .sucrose.skill.ready {
    sucrose skill;
  } else {
    sucrose attack:2;
  }
  sara burst;
  raiden burst, attack:4, dash, attack:4, skill, attack:4, dash, attack:4;
}

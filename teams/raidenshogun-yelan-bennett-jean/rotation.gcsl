active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  bennett skill, attack, burst, attack;
  
  jean skill, attack, burst, attack;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  
  jean skill;
  
  bennett skill;
}

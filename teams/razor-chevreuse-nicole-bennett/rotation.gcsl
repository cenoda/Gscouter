active razor; 
razor skill, dash; 
for let i=0; i<4; i=i+1 {
  
  if i == 0 {
    chev burst, skill[hold=1]:1;
  } else {
    chev attack, skill[hold=1];
  }
  
  nicole burst, skill;
  
  if .bennett.burst.ready {
    bennett burst; 
  } else {
    bennett skill, dash, burst;
  }
  razor skill, dash, attack, burst, attack, skill, dash; 
  
  while .razor.mods.razor-q > 200 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}

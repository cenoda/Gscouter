active razor; 
for let i=0; i<4; i=i+1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill, attack;
  }
  
  if i > 0 && .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack:1; 
  }
  
  if i > 0 && .sucrose.burst.ready {
    sucrose burst, attack;
  } else {
    sucrose skill, dash, attack;
  }
  
  razor skill, dash, attack:1, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3;
  if i == 1 {
    razor dash;
    razor attack:3, dash;
    razor attack:3;
  }
  
  sucrose skill, dash, attack:1;
}

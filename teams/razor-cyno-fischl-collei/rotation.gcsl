active razor;
for let i=0; i<4; i=i+1 {
  collei burst, skill;
  
  amy attack, skill;
  
  razor skill, dash, attack, burst, attack, skill, dash;
  while .collei.skill.cd { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  collei skill;
  
  amy attack:2, burst;
  
  cyno skill, burst;
  while .collei.skill.cd > 60 {
    if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 3 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

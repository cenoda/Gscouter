active razor; 
fischl skill, attack;
for let i=0; i<4; i=i+1 { 
  durin skill:2, burst;
  
  if i == 0 {
    kirara burst;
  }
  kirara skill[short_hold=1];
  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }
  
  razor skill, dash, attack, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3;
}

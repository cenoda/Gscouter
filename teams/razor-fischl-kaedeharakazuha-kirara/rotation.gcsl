active razor; 
for let i=0; i<4; i=i+1 {
	fischl attack, skill;
	
	kazuha skill, high_plunge, burst;
	
	kirara skill[hold=1], burst, attack;
	
	fischl attack:2, burst;
	
	kazuha skill, high_plunge;
	
	razor skill, dash, attack, burst, attack, skill, dash;
    while .fischl.skill.cd > 60 {
	  if .razor.normal > 3 && .razor.skill.ready {
       razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}

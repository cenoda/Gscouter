active razor; 
fischl skill, attack;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  bennett skill, burst;
  
  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  razor skill, dash, attack, burst, attack, skill, dash;
  
  while .razor.infusion.bennett-fire-weapon { 
  
    if .razor.normal > 3  && .razor.skill.ready {
       razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  bennett skill, dash;
}

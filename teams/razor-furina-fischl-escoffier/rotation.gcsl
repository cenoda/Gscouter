active razor; 
  
for let i=0; i<4; i=i+1 {
  amy attack, skill;
  
  furina skill, dash;
  if !.furina.burst.ready && !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;
  
  escoffier skill, burst;
  
  amy attack:2, burst;

  razor skill, dash, attack, burst, attack, skill, dash;
  
  while .razor.mods.razor-q > 210 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}

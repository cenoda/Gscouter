active razor;
razor skill, dash; 
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd && !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  nahida skill, burst, charge; 
  
  bennett skill, dash, burst;
  
  razor skill[hold=1], dash, attack, burst; 
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3;
  
  bennett skill;
}

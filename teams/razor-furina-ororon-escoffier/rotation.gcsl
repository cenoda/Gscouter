active razor; 
  
for let i=0; i<4; i=i+1 {
  ororon burst, skill;
  
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  escoffier skill, burst;

  razor skill, dash, attack, burst;
  let razorSkills = 0;
  while razorSkills < 3 { 
    
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
      razorSkills = razorSkills + 1;
    
    } else if .razor.normal > 3 {
      razor dash;
    
    } else {
      razor attack;
    }
  }
}

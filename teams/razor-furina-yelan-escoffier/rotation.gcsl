active razor;
razor skill, dash; 
  
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  escoffier skill, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  razor skill[hold=1], dash, attack, burst, attack, skill, dash;
  
  while .razor.mods.razor-q > 210 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}

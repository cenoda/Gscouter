active razor; 
for let i=0; i<4; i=i+1 {
  
  nahida skill;

    nahida attack, charge;

  nicole burst, skill;
  
  durin skill:2, burst;
  
  razor skill, dash, attack, burst, attack:1, skill, dash;
  
  while .razor.mods.razor-q > 240 { 
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }
  razor skill, dash;
}

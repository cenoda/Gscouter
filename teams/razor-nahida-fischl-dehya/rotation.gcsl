active razor; 
fischl skill, attack;
for let i=0; i<4; i=i+1 {
  
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  dehya skill;
  if i > 0 {
    dehya skill;
  }

  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  razor skill, dash, attack, burst, attack, skill, dash;
  
  while .razor.mods.razor-q > 190 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
        razor dash;
    } else {
      razor attack;
    }
  }
}

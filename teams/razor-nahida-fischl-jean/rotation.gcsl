active razor; 
for let i=0; i<4; i=i+1 {
	fischl attack, skill;
	
	jean skill;
	
  nahida attack:2, skill, attack, burst, attack, charge;
  
	fischl attack:2, burst;
	
	jean skill, burst;
	
	razor skill, dash, burst, attack, skill, dash; 
  while .fischl.skill.cd > 30 {
	  if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}

active razor; 
amy attack, skill;
for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  mika burst, skill;
  
  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }

  razor skill, dash, attack, burst;
  
  while .razor.mods.razor-q > 210 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  print("done");
}

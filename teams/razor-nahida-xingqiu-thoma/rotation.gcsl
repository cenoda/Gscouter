active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xq skill, dash, burst, attack;
  
  thoma skill, attack, burst, attack;
  razor skill, dash, attack, burst, attack, skill, dash;
  while .xq.mods.xingqiuburst {
  
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}

active razor; 
fn RazorPlunge() {
  razor jump;
  if .airborne {
    razor high_plunge[collision=rand()>0.5];
  }
}
for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;
  
  shenhe skill[hold=1];
  if .shenhe.burst.ready {
    shenhe burst;
  }
  
  rosaria skill, burst;
  
  razor skill;
  if .razor.burst.ready {
    razor dash, burst;
  }
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor skill;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge();
}

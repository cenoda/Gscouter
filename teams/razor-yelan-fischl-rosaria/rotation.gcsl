active razor; 
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  
  rosaria skill;
  if !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  rosaria burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  fischl attack:2, burst;
  
  razor attack, skill, dash, attack, burst;
  while .razor.mods.razor-q > 160 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}

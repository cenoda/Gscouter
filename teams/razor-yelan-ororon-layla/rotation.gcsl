active razor; 
for let i=0; i<4; i=i+1 {
  ororon burst, skill;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  layla burst, attack, skill;
  
  razor skill, dash, attack, burst;
  while .razor.mods.razor-q > 290 { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}

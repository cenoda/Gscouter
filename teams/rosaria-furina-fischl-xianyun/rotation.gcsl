active fischl;
fischl skill;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  rosaria skill, burst;
  
  if .fischl.skill.ready {
    fischl attack:2, skill; 
  } else {
    fischl attack:2, burst;
  }
  
  while .rosaria.status.xianyun-airborne-buff {
    if .rosaria.skill.ready {
      rosaria skill;
    } else {  
      rosaria jump;
      if .airborne {
        rosaria high_plunge[collision=rand()>0.5];
      }
    }
    if .rosaria.status.xianyun-airborne-buff {
      rosaria attack;
    }
  }
}

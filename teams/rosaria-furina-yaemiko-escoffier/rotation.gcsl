active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  esco skill, burst;
  
  yae skill:3;
  
  rosaria skill, burst;
  
  let rosariaSkills = 0;
  while rosariaSkills < 2 { 
    if .rosaria.skill.ready {
      rosaria skill;
      rosariaSkills = rosariaSkills + 1;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  } 
}

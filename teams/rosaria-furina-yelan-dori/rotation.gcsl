active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  if i == 0 {
    dori skill, burst;
    if !.dori.mods.favonius-cd {
      dori attack:1;
    }
  } else {
    dori skill;
    if !.dori.burst.ready {
      dori attack:2;
    }
    dori burst;
  }
  
  yelan burst, attack, skill, attack;
  
  rosaria skill, attack, burst;
  
  while !.yelan.skill.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }
  
  yelan skill, attack;
  
  while !.furina.burst.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }
  
}

active raiden;
for let i = 0; i < 4; i = i + 1 {
  let t = f();
  raiden skill, attack;
  kokomi attack, skill;
  beidou skill[counter=1], burst, attack;
  collei burst, attack, skill;
  kokomi attack, burst,
    attack:2, charge, jump,
    attack:2, charge, jump,
	attack:2, charge, jump,
	attack:2, charge, jump,
	attack:2;
  beidou skill[counter=1], attack;
  collei skill, attack;

active esco;
for let i=0; i<4; i=i+1 {
  esco skill;
  if i > 0 && .esco.burst.ready {
    esco burst;
  } else {
    esco attack;
  }
  
  furina skill, dash, attack;
  
  kokomi skill, dash, attack:2;
  citlali skill, attack:0, burst;
  
  furina burst;
  
  kokomi attack, burst,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2;
}

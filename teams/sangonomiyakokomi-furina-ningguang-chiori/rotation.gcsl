let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active furina;
for let x=0; x<4; x=x+1 {
  furina skill, dash, burst;
  kokomi skill, attack:2, dash;
  ningguang attack, dash, skill;
  chiori skill:2;
  kokomi burst,
  attack:2, dash,
  attack:2, dash,
  attack:2, walk,
  attack:2;
  ningguang burst, skill, charge, 
  attack, charge,
  attack, charge;
  if .chiori.burst.ready {
    chiori burst;
  } else {
    ningguang attack, charge;
  }
}

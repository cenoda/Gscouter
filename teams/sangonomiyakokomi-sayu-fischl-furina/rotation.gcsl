  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  sayu swap;
  while !.sayu.burst.ready {
    sayu attack;
  }
  sayu burst, skill[hold=150];
  fischl attack:2;
  while !.fischl.burst.ready {
    fischl attack;
  }
  fischl burst;
  
  kokomi burst;
  while .status.kokomiburst {
    switch {
      case .kokomi.normal < 3:
        kokomi attack;

      case .stam >= 18: 
        kokomi dash;
      default:          
        kokomi walk;
    }
  }
  
  sayu skill[hold=30];
}

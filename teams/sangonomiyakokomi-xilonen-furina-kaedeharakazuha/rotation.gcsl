active kokomi;
for let i = 0; i < 4; i = i + 1 {
  kokomi skill;
  
  furina skill, dash, attack, burst;
  
  xilonen skill, attack:2;
  
  kazuha skill, high_plunge;
  if .kazuha.burst.ready {
    kazuha burst;
  }
  
  kokomi attack, burst,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, walk,
        attack:2;
}

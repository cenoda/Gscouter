active aino;
for let i=0; i<4; i=i+1 {
  aino skill, burst;
  
  if !is_even(i) {
    ineffa burst, skill;
  } else {
    ineffa skill, attack;
  }
  
  if !is_even(i) {
    sucrose burst, attack;
  } else {
    sucrose attack, skill, dash;
  }
  
  sethos skill; 
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:1;
  sethos skill;
  
  sucrose attack, skill, dash;
  
  sethos aim[hold=2]:1;
  sethos aim[hold=2]:1;
}

active sethos;
sethos aim[hold=1];
for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, attack, skill[hold=1]:3;
  
  if i == 0 {
    durin skill, burst, skill;
  } else {
    durin attack, skill, burst, skill;
  }
  
  xiangling burst, skill, dash;
  sethos skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk;
  sethos aim[hold=2]:1, skill;
  sethos aim[hold=1]:4;
}

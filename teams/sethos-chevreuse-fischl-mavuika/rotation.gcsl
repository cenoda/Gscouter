active sethos;
sethos aim[hold=2];
for let i=0; i<4; i=i+1 { 
  
  if .chev.sets.no > 4 {
    chev burst, skill[hold=1];
  } else {
    
    if .chev.burst.ready {
      chev burst, skill[hold=1];
      if i > 0 {
        chev skill[hold=1]:2;
      }
    } else {
      chev attack, skill[hold=1];
    }
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst; 
  }

  if .mav.burst.ready && i == 0 {
    mav burst, skill, dash;
  } else if .mav.burst.ready {
    mav burst, skill, dash, charge, dash;
  } else {
    mav attack, skill;
  }
  
  sethos skill, burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill:1,
         attack:1; 
  sethos aim[hold=2]:1;
  sethos attack;
  
}

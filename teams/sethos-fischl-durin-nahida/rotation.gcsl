active durin;
for let i=0; i<4; i=i+1 {
  durin skill:2, burst;
  if is_even(i) {
    nahida skill, burst;
    fischl skill, attack;
  } else {
    nahida skill, attack, charge;
    fischl attack:2, burst;
  }
  sethos skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk, 
         skill;
  sethos aim[hold=2]:2;
}

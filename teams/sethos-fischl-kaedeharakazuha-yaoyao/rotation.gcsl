active sethos; 
sethos aim[hold=1];
for let i=0; i<4; i=i+1 {
  kazuha skill, high_plunge, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  yaoyao skill, attack:2;
  kaz skill, high_plunge;
  sethos aim[hold=2],
         skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack, skill;

}

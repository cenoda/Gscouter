active zhongli;
while 1 {
  if .zhongli.skill.ready { zhongli skill[hold=1]; }
  if .nahida.skill.ready { nahida skill[hold=1]; }
  if .nahida.burst.ready { nahida burst; }
  if .fischl.skill.ready { fischl skill; }
  if .fischl.burst.ready { fischl burst; }
  if .sethos.skill.ready { sethos skill; }
  if .sethos.burst.ready { sethos burst; }
  while .sethos.status.sethos-burst > 0 {
    sethos attack:3;
  }
  sethos aim;
}

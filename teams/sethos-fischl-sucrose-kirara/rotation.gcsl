fn sethos_combo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack; 
}
active fischl; 
fischl burst;
kirara skill[hold=10];
sucrose skill, dash, burst;
sethos skill;
sethos_combo(); 
for let r=0; r<3; r=r+1 {
  sucrose attack, charge;
  sethos aim[hold=2];
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  kirara skill[hold=10];
  if .sucrose.burst.ready {
    sucrose skill, dash, burst;
  } else {
    sucrose skill, dash, attack;
  }
  sethos skill;
  sethos_combo();
}

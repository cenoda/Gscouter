fn sethosCombo() {
  if .sethos.skill.ready {
    sethos skill;
  }
  sethos burst;
  while .sethos.mods.sethos-burst {
    if .sethos.normal > 2 {
      sethos walk;
    } else {
      sethos attack;
    }
  }
}
active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  sara skill, burst;
	
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
	
  sara aim;
  
  sethosCombo();
  sethos skill;
  sethos aim[hold=2]:2;
  
  nahida attack:1, charge, dash;
  nahida attack:1, charge, dash;
  nahida attack:1, charge, dash;
  
  print("done");
}

active lauma;
for let i=0; i<4; i=i+1 {
  lauma attack, skill[hold=.dew>1];
  
  if !is_even(i) {
    ineffa attack, skill, burst;
  } else {
    ineffa attack, skill;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  sethos skill, attack; 
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:1;
  sethos skill, attack;
  sethos aim[hold=2]:1;
  sethos attack;
  sethos aim[hold=2]:1;
}

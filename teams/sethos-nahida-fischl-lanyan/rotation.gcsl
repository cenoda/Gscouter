fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2,
         skill;
}
active sethos;
sethos aim[hold=2];
for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  if .amy.skill.ready { 
    amy attack, skill;
  } else {
    amy attack:2, burst;
  }
  
  lanyan attack, skill:2;
  
  sethos skill;
  sethosCombo();
  sethos aim[hold=2]:2;
  
  if .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax {
    lanyan burst;
  } else {
    lanyan attack, charge;
  }
}

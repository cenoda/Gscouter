fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         skill;
}
active sethos;
sethos aim[hold=2];
for let i=0; i<4; i=i+1 {
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  xilonen skill, attack:2;
  
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  nahida dash;  pick_up_crystallize("electro");
  
  if .sethos.skill.cd {
    xilonen burst;
  }
  
  sethos skill; 
  sethosCombo();
  sethos aim[hold=2];
  
}

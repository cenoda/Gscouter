active nahida;
for let i=0; i<4; i=i+1 {
  if i == 0 {
    nahida skill, burst;
  } else {
    nahida skill, attack, burst;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  kuki skill, attack;
  if .kuki.burst.ready {
    kuki burst;
  }
  
  sethos attack, skill, attack;
  sethos burst;
  sethos attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2,
         skill;
  sethos attack, aim[hold=2]:2, attack;
}

fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill;
}
active sethos;
sethos aim[hold=2];
for let i=0; i<4; i=i+1 {
	
	sucrose attack;
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:2;
  }

	tighnari skill, aim;
	if .tighnari.burst.ready {
	  tighnari burst, aim:2;
	} else {
	  tighnari aim:2;
	}
	
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  sucrose attack;
  if .sucrose.skill.ready {
    sucrose skill, dash;
  }
  if .sucrose.burst.ready {
    sucrose burst;
  }
  sethos skill; 
  sethosCombo();
  sethos aim[hold=2];
  
  print("done");
}

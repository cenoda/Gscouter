fn declensionCombo() {
  switch {
    case .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.6 && counter <= 0.80 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}
active beidou;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  beidou skill[counter=rand_counter()], burst; 
  
  while .fischl.oz {
    declensionCombo();
  }
  
  fischl attack:2, burst;
  
  beidou skill[counter=rand_counter()], attack:2;
  
  while .fischl.skill.cd > 50 {
    declensionCombo();
  }
  
  print("done");
}

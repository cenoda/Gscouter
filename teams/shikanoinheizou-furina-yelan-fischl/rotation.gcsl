fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}
active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  
  furina skill, dash, burst;
  
  yelan skill, burst, attack; 
  
  while .fischl.oz {
    declensionCombo();
  }
  
  fischl attack:2, burst;

  yelan attack:2, skill, attack:4;
  
  while .fischl.skill.cd {
    declensionCombo();
  }
  
  print("done");
}

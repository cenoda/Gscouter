fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1 && .stam > 25: 
      heizou charge;
    default:
      heizou attack;
  }
}
active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xq skill, dash, burst, attack;
  
  while .fischl.oz {
    declensionCombo();
  }
  
  fischl attack:2, burst;
  
  while .fischl.skill.cd {
    declensionCombo();
  }
}

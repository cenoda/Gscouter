fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}
active yae;
for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  while .fischl.oz {
    declensionCombo();
  }
  
  print("done");
}

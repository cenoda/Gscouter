let First_Rot_Nuke = false;  
active candace;
for let i=0; i<4; i=i+1 {
  candace skill, attack:2, burst;
  chongyun burst, skill;
  dahlia skill, attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack;
    candace swap;
    wait(10);
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack:2;
  }
}

let First_Rot_Nuke = true;  
active candace;
for let i=0; i<4; i=i+1 { 
  candace skill, attack:2;
  escoffier skill, attack, burst;
  dahlia skill, attack, burst;
  candace skill, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
  }
}

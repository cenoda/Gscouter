let First_Rot_Nuke = true;  
active dahlia;
for let i=0; i<4; i=i+1 {
  dahlia attack, skill, attack;
  if !.dahlia.mods.favonius-cd {
    dahlia attack;
  }
  candace skill, attack:2, burst;
  layla burst, attack, skill;
  dahlia attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:2;
  }
}

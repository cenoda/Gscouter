let First_Rot_Nuke = true;  
active candace;
for let i=0; i<4; i=i+1 { 
  candace attack, skill, attack;
  furina skill, dash, burst;
  escoffier skill, burst;
  candace skill, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

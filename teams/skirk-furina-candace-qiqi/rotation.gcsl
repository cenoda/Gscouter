let First_Rot_Nuke = true;  
active candace;
for let i=0; i<4; i=i+1 {
  candace attack:2, skill;
  furina skill, dash, burst;
  if is_even(i) {
    qiqi skill, attack:2;
  } else {
    qiqi burst;
    if !.qiqi.mods.favonius-cd && .qiqi.weapon == .keys.weapon.favsword {
      qiqi attack;
    }
  }
  candace burst, skill;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

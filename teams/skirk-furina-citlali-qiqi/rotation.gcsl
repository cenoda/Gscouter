let First_Rot_Nuke = true;  
active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash, attack, burst;
  if !.furina.mods.favonius-cd && .furina.weapon == .keys.weapon.favsword {
    furina attack;
  }
  if is_even(i) {
    qiqi skill, attack:2;
  } else {
    qiqi burst;
    if !.qiqi.mods.favonius-cd && .qiqi.weapon == .keys.weapon.favsword {
      qiqi attack;
    } else {
      delay(18);
    }
    delay(29);
  }
  delay(50);
  
  citlali skill, attack;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

let First_Rot_Nuke = true;  
active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash, attack, burst;
  dahlia attack, skill, burst;
  charlotte skill, attack, burst, attack;       
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
    skirk attack; 
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
    skirk attack; 
  }
}

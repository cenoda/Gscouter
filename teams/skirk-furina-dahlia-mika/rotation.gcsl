let first_Rot_Nuke = true; 
active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash;
  if i > 0 {
    furina attack;
  }
  furina burst;
  
  mika skill[hold=1], attack, burst;
  
  dahlia attack, skill, burst;
  
  if i == 0 && first_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  }
}

let First_Rot_Nuke = true;  
active furina;
for let i=0; i<4; i=i+1 { 
  furina attack, skill, dash, attack, burst;
  charlotte skill, burst, attack;       
  mualani skill, attack, skill;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
  mualani skill, attack, skill;
  if ( First_Rot_Nuke && i ) || !First_Rot_Nuke {
    furina dash;
  }
}

active furina;
furina attack, skill, dash; 
escoffier skill, attack:2;  
shenhe skill, attack:2;
skirk skill,
      attack:5, dash,
      
      attack:2, burst,
      
      attack:5, dash,
      attack:5, dash;
      
shenhe swap;
print("Skirk E cd (60 FPS) is ", .skirk.skill.cd);
print("Skirk Q cd (60 FPS) is ", .skirk.burst.cd);
for let i=0; i<4; i=i+1 { 
  shenhe skill, attack:2;
  if i {
    furina skill, dash;
  } else {
    furina attack;  
    while .furina.energy != .furina.energymax {   
      wait(1);
    }
  }
  furina burst;
  escoffier skill, burst;
  shenhe burst, skill[hold=1];
  skirk skill,
        attack:2, burst,
        
        attack:5, dash,
        attack:5, dash,
        attack:5, dash,
      
        attack:2, charge, dash,
        
        attack:5, dash,
        attack:2;
}

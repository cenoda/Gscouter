let First_Rot_Nuke = true;  
active xingqiu;
for let i=0; i<4; i=i+1 { 
  xingqiu skill, dash, attack;
  furina skill, dash, burst;
  if is_even(i) {
    qiqi skill, attack:2;
  } else {
    qiqi burst;
    if !.qiqi.mods.favonius-cd && .qiqi.weapon == .keys.weapon.favsword {
      qiqi attack;
    }
  }
  xingqiu burst, attack:2;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
    
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

let First_Rot_Nuke = true; 
active furina;
for let i=0; i<4; i=i+1 { 
  furina skill, dash, burst;
  diona skill[hold=1], burst;
  yelan burst, attack, skill, attack;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, dash,
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:4, dash,
          
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:3;
  } else {
    skirk skill,
          attack:2, dash,
          attack:2, dash, 
          attack:2, burst, 
    
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:4, dash,
          
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:3;
  }
}

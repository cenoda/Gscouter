let First_Rot_Nuke = true;  
active dahlia;
for let i=0; i<4; i=i+1 {
  dahlia attack, skill, attack;
  if !.dahlia.mods.favonius-cd {
    dahlia attack;
  }
  xingqiu skill, dash, attack, burst, attack;
  dahlia attack, burst;
  if is_even(i) {
    charlotte attack, burst, skill, attack;
  } else {
    charlotte attack, skill, attack:3;
  }
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack;
  }
}

let First_Rot_Nuke = true;  
active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu skill, burst, attack;
  shenhe skill[hold=1], attack, burst, attack;
  dahlia skill, attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack, charge, dash,
          
          attack:5, dash,
          attack:5, dash;
  }
}

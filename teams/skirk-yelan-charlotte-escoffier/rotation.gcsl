let First_Rot_Nuke = true;  
active escoffier;
for let i=0; i<4; i=i+1 { 
  if is_even(i) {
    escoffier skill, attack, burst, attack;
    yelan skill, attack, burst, attack;
    charlotte skill, attack:3;
  } else {
    escoffier skill, attack:3;
    yelan skill, attack, burst, attack;
    charlotte skill, attack, burst, attack;
  }
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:3;
  }
}

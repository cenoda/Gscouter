let First_Rot_Nuke = true;  
active chongyun;
for let i=0; i<4; i=i+1 {
  chongyun skill, attack;
  yelan skill, burst, attack;
  chongyun burst;
  layla burst, attack, skill;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

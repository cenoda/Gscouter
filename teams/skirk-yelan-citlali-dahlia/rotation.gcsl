let First_Rot_Nuke = true;  
active dahlia;
for let i=0; i<4; i=i+1 { 
  dahlia attack:2, skill, attack;
  if !.dahlia.mods.favonius-cd {
    dahlia attack;
  }
  yelan attack, skill, attack, burst, attack;
  dahlia burst, attack;
  citlali skill, attack;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash;
  }
}

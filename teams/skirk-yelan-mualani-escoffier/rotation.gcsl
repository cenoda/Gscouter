let First_Rot_Nuke = true;  
active yelan;
for let i=0; i<4; i=i+1 { 
  yelan attack, skill, attack, burst, attack;
  escoffier skill, attack, burst;
  mualani skill, attack, skill;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
  mualani skill, attack, skill;
}

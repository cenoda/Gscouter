let First_Rot_Nuke = true;  
active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill, burst, attack;
  rosaria skill, attack, burst, attack;
  dahlia skill, attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack, charge, dash,
          
          attack:5, dash,
          attack:5;
  } else {
    skirk skill,
          attack, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  }
}

active nicole;
for let i = 0; i < 4; i = i + 1 {
  
  nicole skill, burst;
  durin skill, attack, burst;
  sucrose attack, skill, dash;
  mona attack, burst, attack, skill, attack, charge;
  
  if .sucrose.skill.ready {
    sucrose skill, dash, attack;
  } else if .sucrose.burst.ready {
    sucrose burst, attack:2;
  } else {
    sucrose attack, charge, dash;
  }
  mona attack, charge, attack, charge, attack, charge;
  
}

active yae;
  
for let i=0; i<4; i=i+1 {
  if !i {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }
  sucrose burst, attack;
  if i {
    sucrose attack;
  }
  fischl attack:2, burst;
  nahida skill, burst, attack;
  yae attack, charge, dash, burst, skill, attack, skill, attack, skill;
  sucrose attack:2, skill, dash, attack, charge, attack;
  fischl attack, skill;
  
  yae attack, charge, jump, attack:2, charge, jump, attack;
  sucrose attack, skill, dash, attack, charge;
  yae attack, charge, jump;
}
  yae skill;

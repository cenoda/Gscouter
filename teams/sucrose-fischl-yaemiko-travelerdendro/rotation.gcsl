active yaemiko;
for let i=0; i<4; i=i+1 {
	if !i {
		yae attack, skill:3;
	} else {
		yae attack, skill:2, attack, skill, attack;
	}
	sucrose burst, attack;
	fischl attack:2, burst;
	luminedendro skill, burst, attack;
	sucrose attack, charge;
	yae attack, burst, attack, skill, attack, skill, attack, skill;
	sucrose attack, charge, attack, skill, dash, attack;
	fischl attack:2, skill;
	luminedendro attack,skill;
	yae attack:2, dash, attack:2;
	sucrose skill, dash, attack:2, charge, attack:2, charge;
}

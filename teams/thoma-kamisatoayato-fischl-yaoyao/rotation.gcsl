	set_player_pos (3.2, 3.1);
	ayato attack:3;
	set_player_pos (-3.2, 3.1);
	ayato attack:3;
	set_player_pos (3.2, 3.1);
	ayato attack:3;
	set_player_pos (-3.2, 3.1);
	yaoyao burst;
		set_player_pos (3.2, 3.1);

active nahida;
while 1 {
  nahida skill[hold=1];
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  yelan skill;
  if .yelan.burst.ready { yelan burst; }
  if .thoma.skill.ready { thoma skill; }
  if .thoma.burst.ready { thoma burst; }
  if .nahida.burst.ready { nahida burst; }
  while !.xingqiu.skill.ready {
    thoma attack:4;
  }
}

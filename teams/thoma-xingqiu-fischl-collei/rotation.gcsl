active collei;
let t = 0;
for let i=0; i<4; i=i+1 {
    t = f();
    collei skill;
    xingqiu burst, attack:2;
    fischl skill, attack;
    thoma skill, attack, burst;
    while f() - t <= 10*60 {
        if .thoma.normal > 3 {
            thoma dash;
        }
        thoma attack;
    }
    fischl attack, burst;
    collei burst, attack, skill;
    xingqiu attack, skill, dash, attack:2;
    while f() - t <= 25*60 {
        if .thoma.normal > 3 {
            thoma dash;
        }
        thoma attack;
    }
    print("done");
}

active nahida;
let t = 0;
for let i=0; i<4; i=i+1 {
    t = f();
    nahida skill, burst;
    xingqiu burst, attack:2;
    fischl skill, attack;
    thoma skill, attack, burst;
    while f() - t <= 10*60 {
        if .nahida.normal > 2 {
            nahida walk;
        }
        nahida attack;
    }
    fischl attack:2, burst;
    nahida skill, attack;
    xingqiu attack, skill, dash, attack:2;
    while f() - t <= 23*60 {
        if .nahida.normal > 2 {
            nahida walk;
        }
        nahida attack;
    }
}

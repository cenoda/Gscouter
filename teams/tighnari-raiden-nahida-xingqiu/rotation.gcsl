active xingqiu;
while 1 {
  if .xingqiu.skill.ready { xingqiu skill; }
  if .xingqiu.burst.ready { xingqiu burst; }
  nahida skill[hold=1];
  if .nahida.burst.ready { nahida burst; }
  if .raiden.skill.ready { raiden skill; }
  if .raiden.burst.ready { raiden burst; }
  if .tighnari.skill.ready { tighnari skill; }
  if .tighnari.burst.ready { tighnari burst; }
  tighnari aim:4;
}

active emilie;
for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  bennett skill, burst;
  faruzan skill, burst;
  aetheranemo skill[hold=1], burst;
  faruzan skill, aim:2;
  aetheranemo attack:2, charge, attack:1, skill[hold=1];
  bennett skill; 
  faruzan skill, aim:2;
}

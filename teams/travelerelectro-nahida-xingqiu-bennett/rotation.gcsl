  xingqiu skill, dash, burst, attack;
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  }
  bennett attack, burst, skill;
  lumineelectro burst, attack:2;
  bennett skill;
  lumineelectro attack:5;
  bennett skill;
  lumineelectro attack:5;
  bennett skill;
  lumineelectro attack:6;
  bennett skill;
}

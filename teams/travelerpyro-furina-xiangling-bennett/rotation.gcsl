active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  
  aetherpyro skill[hold=1];
  while .status.bennettburst || .aetherpyro.mods.bennett-field {
  
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 2 && .stam > 25: 
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
  aetherpyro attack; 
  
  bennett skill;
}

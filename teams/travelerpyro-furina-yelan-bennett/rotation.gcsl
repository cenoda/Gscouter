active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  bennett burst, attack, skill;
  
  aetherpyro attack, skill[hold=1], attack:1;
  while .yelan.mods.yelanburst {
  
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 3 && .stam > 25: 
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
  
  bennett skill;
}

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  esco skill, burst;
  
  yelan burst, attack, skill, attack;
  
  aetherpyro skill[hold=1], attack;
  while .yelan.skill.cd {
    switch {
      case .aetherpyro.burst.ready: 
        aetherpyro burst;

      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
  
  yelan attack, skill, attack;
  while .yelan.mods.yelanburst {
    switch {
      case .aetherpyro.burst.ready: 
        aetherpyro burst;

      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
}

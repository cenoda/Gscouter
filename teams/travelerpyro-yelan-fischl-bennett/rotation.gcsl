active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  bennett burst, attack, skill;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  aetherpyro attack, skill[hold=1], attack:2, charge; 
  while .yelan.mods.yelanburst {
  
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 3 && .stam > 25: 
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
  
  bennett skill;
}

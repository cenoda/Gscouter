active yelan;
for let i=0; i<4; i=i+1 {
  xilonen burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xilonen skill, attack:2;
  if .xilonen.sets.ap >= 4 {
    pick_up_crystallize("any");
  }
  
  if .fischl.skill.ready {
    fischl attack, skill;
    if .fischl.sets.ap >= 4{
      fischl dash; pick_up_crystallize("any");
    }
  } else {
    fischl attack:2, burst;
    if .fischl.sets.ap >= 4 {
      pick_up_crystallize("any");
    }
  }
  
  aetherpyro attack, skill[hold=1];
  while .yelan.mods.yelanburst {
  
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 3 && .stam > 25: 
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: 
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
}

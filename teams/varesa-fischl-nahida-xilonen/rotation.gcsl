fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
for let i=0; i<6; i=i+1 {
  if i==1 {
    xilonen skill, burst, attack:2;
  } else {
    xilonen skill, attack:2;
  }
  nahida skill, dash; pick_up_crystallize("electro");
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }
  varesa_combo(5);
}

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
for let i=0; i<4; i=i+1 {
  if .chevreuse.burst.ready && .chevreuse.energy == .chevreuse.energymax {
    chevreuse burst;
  } 
  chevreuse skill[hold=1];
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if .xiangling.burst.ready {
    xiangling burst;
  }
  xiangling skill, dash;
  varesa_combo(5);
  if i {
    varesa_combo(1);
  }
}

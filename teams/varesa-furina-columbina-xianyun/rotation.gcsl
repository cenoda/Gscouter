fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 
    } else if .xianyun.status.xianyun-airborne-buff { 
      varesa jump;
      if .airborne {
        varesa high_plunge[collision=1]; 
      }
    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active columbina;
columbina skill;
for let i=0; i<4; i=i+1 {
  if !is_even(i) {
    columbina skill, burst;
  } else if i > 0 {
    columbina skill, attack;
  }
  
  if is_even(i) && i > 0 {
    furina skill, dash, attack, burst;
  } else {
    furina skill, dash, burst;
  }
  
  if !.element.t0.electro {
    varesa attack:2;
  }
  
  xianyun skill, low_plunge, burst;
  
  varesa_combo(6);
  
  xianyun attack:2; 
}

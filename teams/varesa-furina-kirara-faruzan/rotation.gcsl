fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active furina;
for let i=0; i<4; i=i+1 {
  furina skill;
  faruzan skill, aim;
  kirara skill[short_hold=1];
  varesa_combo(5);
  if i && .faruzan.burst.ready && .faruzan.energy == .faruzan.energymax {
    faruzan burst, aim;
  } else {
    faruzan skill, aim;
  }  
  kirara skill, burst;
  varesa_combo(3);
}

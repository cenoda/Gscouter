fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
for let i=0; i<4; i=i+1 {
  if !.element.t0.electro {
    varesa attack;
  }
  xilonen skill, attack:2;
  furina skill, dash, burst, attack:2;
  mavuika skill, burst, charge:2, dash, charge, dash;
  varesa_combo(1);
  if !.element.t0.electro {
    varesa attack;
  }
  xilonen skill, attack:2;
  varesa_combo(3);
}

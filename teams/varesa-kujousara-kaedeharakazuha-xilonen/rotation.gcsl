fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
for let i=0; i<6; i=i+1 {
  if i && .xilonen.burst.ready {
    xilonen burst;
    varesa attack;
  }
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  sara dash; pick_up_crystallize("electro");
  sara skill;
  if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  } else {
    sara aim;
  }
  varesa_combo(4);
}

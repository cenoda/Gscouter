fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
chevreuse burst, skill[hold=1];
ororon burst, skill;
sara skill;
varesa_combo(3);
chevreuse skill[hold=1], attack;
sara burst;
varesa_combo(4);
for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  chevreuse burst, skill[hold=1];
  sara skill;
  varesa_combo(3);
  chevreuse skill[hold=1], attack;
  if .sara.burst.ready {
    sara aim, burst;
  } else {
    sara aim;
  }
  varesa_combo(4);
}

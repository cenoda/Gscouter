fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
chevreuse burst, skill[hold=1];
travelerpyro skill, burst;
sara skill, burst;
varesa_combo(2);
sara aim;
varesa_combo(4);
for let i=0; i<3; i=i+1 {
  chevreuse skill[hold=1];
  if .chevreuse.burst.ready {
    chevreuse burst;
  }
  travelerpyro skill, attack, burst;
  sara skill;
  if .sara.burst.ready {
    sara burst;
  } 
  varesa_combo(2);
  sara aim;
  varesa_combo(4);
}

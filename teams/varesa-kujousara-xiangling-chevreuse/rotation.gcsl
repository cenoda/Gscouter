fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active varesa;
varesa_combo(1);
chevreuse burst, skill[hold=1];
sara skill;
xiangling burst, skill, dash;
sara burst;
varesa_combo(2);
sara aim;
varesa_combo(3);
for let i=0; i<5; i=i+1 {
  if .chevreuse.burst.ready {
    chevreuse burst;
  }
  chevreuse skill[hold=1];
  sara skill;
  if .sara.burst.ready {
    sara burst;
  }
  if .xiangling.burst.ready {
    xiangling burst;
  }
  xiangling skill, dash;
  sara aim;
  varesa_combo(4);
}

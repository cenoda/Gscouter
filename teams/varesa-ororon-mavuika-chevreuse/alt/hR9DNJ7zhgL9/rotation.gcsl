fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active ororon;
for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  if !i {
    chev burst, skill[hold=1];  
  } else {
    chev skill[hold=1];
    if .chev.burst.ready {
      chev burst;
    } else {
      chev attack;
    }
  }
  mavuika skill, burst, charge:2, dash, charge:2, dash;
  varesa_combo(5);
}

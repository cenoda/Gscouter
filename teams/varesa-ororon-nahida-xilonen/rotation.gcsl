fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; 

    } else {
      varesa charge, high_plunge[collision=1]; 
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}
active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill;
  if i {
    nahida charge;
  }
  ororon skill, burst;
  if .xilonen.burst.ready {
    xilonen burst, skill, attack:2; pick_up_crystallize("any");
    varesa_combo(5);
  } else {
    xilonen skill, attack:2; pick_up_crystallize("any");
    varesa_combo(6);
  }
}

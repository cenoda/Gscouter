# GameWith Vesna team guide, Anemo on-field driver team:
# Ineffa E (Q when available) > Columbina E Q > Sucrose E > Vesna [combo]
# Columbina bursts when ready (no ER her build reaches gives a burst
# every rotation).
# Vesna's combo: E [N C E]x2 Q E [N C E]x2. With 5 Sword Essence per
# wind pinion (one with N1, two with each Charged Attack) its 8 attacks,
# the skill and the burst pay for all five Windborne Swords; when the
# burst is not ready, or the next sword is not, she keeps attacking
# ("use Normal and Charged Attacks to recharge her special Skill") until
# the fifth ends Armed for Action.
active ineffa;
ineffa skill;
if .ineffa.burst.ready {
  ineffa burst;
}
columbina skill;
if .columbina.burst.ready {
  columbina burst;
}
sucrose skill;
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
vesna burst;
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

# Written in the order of the GameWith Vesna team guide's Stellar Swirl
# rotations (Cryo supports, then the other supports, then Vesna's
# combo): Odette E E > Cryo Traveler E N1C Q > Diona E (hold) Q > Vesna
# combo. GameWith's Stellar Swirl teams are Vesna / Odette / Cryo
# Traveler / Vodyanitsa and Vesna / Cryo Traveler / Diona / Sucrose; for
# the Cryo slots it lists Odette, the Cryo Traveler, Diona and Qiqi, and
# for the fourth slot Vodyanitsa, Faruzan, Sucrose, Lan Yan and Qiqi.
# Cryo Traveler and Diona burst when ready. Diona holds her skill
# (GameWith: tap or hold), which feeds her burst better. gcsim needs a
# normal attack before the Traveler's charged attack.
# Vesna's combo as in every Vesna team (GameWith's): E [N C E]x2 Q E [N
# C E]x2, the burst when ready. With 5 Sword Essence per attack it pays
# for only four Windborne Swords even with the burst, so whenever the
# next one is not ready she keeps attacking until the fifth ends Armed
# for Action.
active odette;
odette skill:2;
travelercryo skill, attack, charge;
if .travelercryo.burst.ready {
  travelercryo burst;
}
diona skill[hold=1];
if .diona.burst.ready {
  diona burst;
}
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
if .vesna.burst.ready {
  vesna burst;
}
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

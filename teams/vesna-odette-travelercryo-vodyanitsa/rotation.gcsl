# GameWith Vesna team guide, premium Stellar Swirl team:
# Odette E E > Traveler E C Q > Vodyanitsa E > Vesna [combo]
# gcsim needs a normal attack before the Traveler's charged attack
# (E N1C Q, as in the KQM Sandrone guide). The Traveler bursts when ready
# (no ER the substats reach gives a burst every rotation).
# Vesna's combo: E [N C E]x2 Q E [N C E]x2, the burst when ready. With 5
# Sword Essence per wind pinion (one with N1, two with each Charged
# Attack) its 8 attacks, the skill and the burst pay for all five
# Windborne Swords; when the burst is not ready, or the next sword is
# not, she keeps attacking ("use Normal and Charged Attacks to recharge
# her special Skill") until the fifth ends Armed for Action.
active odette;
odette skill:2;
travelercryo skill, attack, charge;
if .travelercryo.burst.ready {
  travelercryo burst;
}
vodyanitsa skill;
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
if .vesna.burst.ready {
  vesna burst;
}
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

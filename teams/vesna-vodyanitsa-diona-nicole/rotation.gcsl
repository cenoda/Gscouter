# GameWith Vesna team guide, F2P Stellar Swirl team (Traveler E C Q >
# Diona E Q > Sucrose E > Vesna combo) with Vodyanitsa for Sucrose (a
# substitute it lists) and Nicole in the Cryo Traveler's slot; the guide
# lists Nicole only as an ATK% buffer for Vesna's Anemo driver team:
# Diona E (hold) Q > Nicole E Q > Vodyanitsa E > Vesna combo. Diona and
# Nicole burst when ready. Diona holds her skill (the guide: tap or
# hold), which feeds her burst better.
# Vesna's combo as in every Vesna team (GameWith's): E [N C E]x2 Q E
# [N C E]x2, the burst when ready. With 5 Sword Essence per attack it
# pays for only four Windborne Swords even with the burst, so whenever the
# next one is not ready she keeps attacking until the fifth ends Armed for
# Action.
active diona;
diona skill[hold=1];
if .diona.burst.ready {
  diona burst;
}
nicole skill;
if .nicole.burst.ready {
  nicole burst;
}
vodyanitsa skill;
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
if .vesna.burst.ready {
  vesna burst;
}
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

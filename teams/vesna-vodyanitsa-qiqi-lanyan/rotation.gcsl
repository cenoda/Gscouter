# Written in the order of the GameWith Vesna team guide's Stellar Swirl
# rotations (Cryo supports, then the other supports, then Vesna's
# combo): Qiqi E Q > Lan Yan E Q > Vodyanitsa E > Vesna combo.
# GameWith's Stellar Swirl teams are Vesna / Odette / Cryo Traveler /
# Vodyanitsa and Vesna / Cryo Traveler / Diona / Sucrose; for the Cryo
# slots it lists Odette, the Cryo Traveler, Diona and Qiqi, and for the
# fourth slot Vodyanitsa, Faruzan, Sucrose, Lan Yan and Qiqi. Qiqi and
# Lan Yan burst when ready.
# Vesna's combo as in every Vesna team (GameWith's): E [N C E]x2 Q E [N
# C E]x2, the burst when ready. With 5 Sword Essence per wind pinion
# (one with N1, two with each Charged Attack) its 8 attacks, the skill
# and the burst pay for all five Windborne Swords; when the burst is not
# ready, or the next sword is not, she keeps attacking until the fifth
# ends Armed for Action.
active qiqi;
qiqi skill;
if .qiqi.burst.ready {
  qiqi burst;
}
lanyan skill;
if .lanyan.burst.ready {
  lanyan burst;
}
vodyanitsa skill;
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
if .vesna.burst.ready {
  vesna burst;
}
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

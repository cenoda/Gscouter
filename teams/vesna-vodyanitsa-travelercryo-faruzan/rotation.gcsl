# KQM Vodyanitsa quick guide: "If one of Odette or Cryo Traveler is
# unavailable, C6 Faruzan can be a decent replacement for them." Its
# Odette / Cryo Traveler team, Odette replaced by Faruzan as its
# Odette / Faruzan team plays her:
# Faruzan E C Q > Cryo Traveler E N1C Q > Vodyanitsa E > Vesna combo
# Faruzan's C is her hold-mode aimed shot. Faruzan and the Traveler
# burst when ready.
# Vesna's combo as in every Vesna team (the guide does not spell it out;
# GameWith's): E [N C E]x2 Q E [N C E]x2, the burst when ready. With 5
# Sword Essence per attack it pays for only four Windborne Swords even
# with the burst, so whenever the next one is not ready she keeps
# attacking until the fifth ends Armed for Action.
active faruzan;
faruzan skill, aim;
if .faruzan.burst.ready {
  faruzan burst;
}
travelercryo skill, attack, charge;
if .travelercryo.burst.ready {
  travelercryo burst;
}
vodyanitsa skill;
vesna skill,
      attack, charge, skill,
      attack, charge, skill;
if .vesna.burst.ready {
  vesna burst;
}
while .vesna.armed {
  while .vesna.armed && !.vesna.skill.ready {
    vesna attack, charge;
  }
  if .vesna.armed {
    vesna skill;
  }
  if .vesna.armed {
    vesna attack, charge;
  }
}

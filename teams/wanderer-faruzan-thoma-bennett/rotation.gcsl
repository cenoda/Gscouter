active faruzan;
for let i = 0; i < 5; i = i + 1 {
  thoma skill, burst;
  faruzan skill, aim[weakspot=1], burst;
  bennett skill, burst;
  wanderer charge, skill;  
   while .wanderer.skydweller-points > 3 {
    switch {
    case .wanderer.normal < 3:
      wanderer attack;
    case .wanderer.mods.wanderer-a4:
      wanderer dash;
    default:
      wanderer charge;
    }
  }
  if .wanderer.burst.ready {
    wanderer burst;
  } else {
    wanderer skill;
  }
  bennett skill;
}

active furina;
for let x = 0; x < 4; x = x + 1  {
  furina skill, dash; 
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd && !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  if x {
    bennett burst, skill;
  } else {
    bennett skill, burst;
  }
  
  faruzan burst;
  while !.faruzan.mods.favonius-cd {
    if .faruzan.skill.ready {
      faruzan skill;
    } else {
      faruzan attack;
    }
  } 
  
  if .wanderer.burst.ready {
    wanderer attack:2, burst;
  }
  wanderer attack, skill, attack, charge;	
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 2 {
      wanderer charge;
    } else {
      wanderer attack;
    }
  }
  wanderer skill;
}

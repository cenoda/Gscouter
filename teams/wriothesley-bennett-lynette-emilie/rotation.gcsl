set_particle_delay("lynette", 0);
active wrio;
wrio attack; 
for let r=0; r<4; r=r+1 {
  if r && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  lynette attack, skill;
  bennett skill, burst;
  lynette attack, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge, jump;
  }
  while !.element.t0.cryo { 
    wrio attack;
  }
}

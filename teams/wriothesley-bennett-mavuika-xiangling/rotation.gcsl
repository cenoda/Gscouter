active wrio;
for let r=0; r<3; r=r+1 {
  
  wrio attack; 
  mavuika burst, skill;
  bennett burst, skill;
  xiangling burst, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
       
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack, charge, attack;
  }
}
wait(35);

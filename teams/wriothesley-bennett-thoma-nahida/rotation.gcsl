active thoma;
for let r=0; r<4; r=r+1 {
  thoma skill, burst;
  while !.thoma.mods.favonius-cd {
    thoma attack;
  }
  nahida skill, burst;
  bennett skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge;
  }
  bennett skill, attack;
}

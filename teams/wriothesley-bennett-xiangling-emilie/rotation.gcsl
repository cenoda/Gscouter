active emilie;
for let i=0; i<4; i=i+1 {
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill; 
  }
  bennett burst, skill;
  xiangling burst, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready  {
    wrio burst;
  } else {
    wrio charge;
  }
  bennett skill;
  xiangling attack:2, dash;
  while !.xl.mods.favonius-cd {
    xl attack;
  }
}

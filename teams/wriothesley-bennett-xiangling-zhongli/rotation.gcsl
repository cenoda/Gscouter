active zl;
for let r=0; r<4; r=r+1 {
	zhongli skill[hold=1], jump;
	while !.zl.mods.favonius-cd {
   zl attack;
  }
	bennett burst, skill;
	xiangling burst, skill;
	wrio skill,
	     attack:3, charge, jump,
		   attack:3, charge, jump,
		   attack:3, charge, jump, 
		   attack:3, charge, jump, 
		   attack:3, charge, jump,
		   attack:3;
	if .wrio.burst.ready  {
		wrio burst;
	} else {
		wrio charge;
	}
  bennett skill;
	xiangling attack:2, jump;
}

active xingqiu;
while 1 {
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  kazuha skill;
  if .kazuha.burst.ready { kazuha burst; }
  bennett skill;
  if .bennett.burst.ready { bennett burst; }
  wriothesley skill;
  if .wriothesley.burst.ready { wriothesley burst; }
  let i = 0;
  while i < 11 {
    if .stam >= 25 {
      wriothesley attack, charge;
    } else {
      wriothesley attack:2;
    }
    i = i + 1;
  }
}

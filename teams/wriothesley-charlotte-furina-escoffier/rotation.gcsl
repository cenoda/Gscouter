active furina;
for let i=0; i<4;i=i+1 {
  furina attack, skill, burst;
  if is_even(i) {
    escoffier skill, burst;
  } else {
    escoffier skill, attack;
  }
  charlotte skill, burst, attack;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
    wrio attack:2; 
  } else {
    wrio charge, jump, attack;
  }
}

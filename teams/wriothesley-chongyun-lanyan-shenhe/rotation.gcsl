active chongyun;
for let x=0; x<4; x=x+1 {
  chongyun skill;
  shenhe attack, skill[hold=1], burst;
  chongyun burst;
  lanyan skill:2;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio attack:3, charge;
  }
}

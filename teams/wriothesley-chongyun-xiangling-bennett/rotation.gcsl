active chongyun;
for let i=0; i<4; i=i+1 {
  chongyun skill;
  bennett skill;
  chongyun burst;
  bennett burst, skill;
  xiangling burst, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready  {
    wrio burst;
  } else {
    wrio charge;
  }
}

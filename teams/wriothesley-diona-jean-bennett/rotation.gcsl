active diona;
for let i=0; i<4; i=i+1 {
  if .diona.weapon == .keys.weapon.sacbow {
    diona skill[hold=1];
  }
  diona skill[hold=1], burst;
  jean attack, skill;
  jean burst;
  bennett skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge;
  }
  bennett skill, attack;
}

active diona;
for let i=0; i<4; i=i+1 {
  diona skill[hold=1], attack, burst, attack;
  bennett burst, skill;
  xiangling burst, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready  {
    wrio burst;
  } else {
    wrio charge;
  }
  bennett skill;
  xiangling swap; wait(55);
}

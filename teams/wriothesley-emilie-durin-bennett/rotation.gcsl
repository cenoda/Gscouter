active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill;
  durin skill, skill, burst;
  if !is_even(i) {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  bennett skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge;
  }
}

active emilie;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  thoma skill, attack, burst;
  while !.thoma.mods.favonius-cd {
    thoma attack;
  }
  dehya skill:2;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump;
  }
}

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  diona skill[hold=1]:2;
  escoffier skill, burst;
  diona burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump;
  }
}

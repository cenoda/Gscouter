active furina;
for let i=0; i<4;i=i+1 {
  furina skill, dash, burst;
  escoffier skill, burst;
  kazuha skill, high_plunge, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if is_even(i) {
    wrio burst;
  } else {
    wrio attack:3;
  }
  kazuha skill, high_plunge;
}

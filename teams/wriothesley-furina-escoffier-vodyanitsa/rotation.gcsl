# FandomWire's Wriothesley / Escoffier / Vodyanitsa / Furina. Rotation
# from the harvested Wriothesley / Furina / Escoffier / Citlali team with
# Vodyanitsa's skill in Citlali's place, the last swap before Wriothesley
# (she holds Thrilling Tales); she bursts when ready.
# Escoffier bursts when ready (the KQM Vodyanitsa quick guide's Skirk
# team alternates her burst between rotations; Vodyanitsa gives her
# fewer particles than the member she replaces).
active furina;
for let i=0; i<4; i=i+1 {
  furina attack, skill, burst;
  escoffier skill, attack;
  if .escoffier.burst.ready {
    escoffier burst;
  }
  vodyanitsa skill;
  if .vodyanitsa.burst.ready {
    vodyanitsa burst;
  }
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump, attack;
  }
}

active wrio;
wrio attack;
for let i=0; i<4;i=i+1 {
  xilonen skill, attack:2, burst;
  furina skill, dash, burst;
  if is_even(i) { 
    escoffier skill, attack:3;
  } else {
    escoffier skill, burst;
  }
  xilonen skill, attack:2;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if is_even(i) {
    wrio burst;
  } else {
    wrio attack, charge;
  }
}

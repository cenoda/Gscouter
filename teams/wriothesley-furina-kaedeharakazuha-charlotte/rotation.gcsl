active furina;
for let i=0; i<4; i=i+1 {
  furina attack, skill, burst;
  charlotte skill, burst, attack;
  kazuha skill, high_plunge;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio charge;
  }
  kazuha skill, high_plunge;
}

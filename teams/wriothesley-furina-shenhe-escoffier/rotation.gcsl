active furina;
for let i=0; i<4;i=i+1 {
  furina skill, dash, attack, burst;
  
  escoffier skill, burst;
  
  shenhe skill[hold=1], attack, burst;
  if !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge;
  }
}

active furina;
for let i=0; i<4; i=i+1 {
  if !i {
    furina skill, dash, burst;
  } else {
    furina burst, skill, dash;
  }
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  shenhe skill[hold=1], burst;
  while !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  xianyun skill, low_plunge, burst, attack;
  wrio skill;
  for let n=0; n<4; n=n+1 {
    let col = rand();
    wrio attack:3, charge, jump;
    if .airborne {
      if col > 0.5 {
        wrio high_plunge[collision=1];
      } else {
        wrio high_plunge;
      }
    }
  }
  wrio attack:3, charge, dash;
  if .wrio.burst.ready {
	  wrio burst;
  }
}

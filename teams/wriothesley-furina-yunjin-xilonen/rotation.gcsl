active wrio;
wrio attack;
for let x=0; x<4; x=x+1 {
  xilonen skill, attack:2, burst;
  furina attack, skill, burst;
  yunjin skill, burst;
  if .yunjin.sets.ap >= 4 {
    yunjin dash; pick_up_crystallize("cryo"); 
  } else {
    yunjin dash; pick_up_crystallize("any"); 
  }
  xilonen skill, attack:2;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack:3;
  }
}

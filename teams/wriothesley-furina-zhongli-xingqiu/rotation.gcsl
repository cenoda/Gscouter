active furina;
while 1 {
  if .furina.skill.ready { furina skill; }
  if .furina.burst.ready { furina burst; }
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  zhongli skill[hold=1];
  wriothesley skill;
  if .wriothesley.burst.ready { wriothesley burst; }
  let i = 0;
  while i < 8 {
    if .stam >= 25 {
      wriothesley attack, charge;
    } else {
      wriothesley attack:2;
    }
    i = i + 1;
  }
}

active shenhe;
for let i=0; i<4;i=i+1 {
  shenhe skill[hold=1], attack, burst;
  if !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  escoffier skill, attack, burst;
  mualani skill, attack, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump, attack:2;
  }
  mualani skill, attack, skill;
}

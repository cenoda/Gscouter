  bennett skill, burst;
  lynette skill, burst, attack;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4, charge, jump;

active rosa;
for let i=0; i<4; i=i+1 {
  rosaria skill, attack;
  kazuha skill, high_plunge, burst;
  bennett skill, burst;
  rosaria skill, burst;
  kazuha skill, high_plunge;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio attack:3, charge, jump;
  }
}

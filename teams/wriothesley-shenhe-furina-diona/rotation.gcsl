active wrio;
for let x=0; x<4; x=x+1 {
  furina attack, skill, burst;
  diona burst, skill[hold=1], attack;
  shenhe attack:2, skill[hold=1], burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio charge, jump, attack;
  }
}

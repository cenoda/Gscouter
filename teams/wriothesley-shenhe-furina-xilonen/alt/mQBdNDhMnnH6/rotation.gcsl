active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack;
  shenhe skill[hold=1];
  if is_even(i) {
    shenhe burst;
  }
  xilonen skill, attack:2;
  wrio  skill;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge;
  if is_even(i)  {
    wrio dash;
    wrio attack:3;
    wrio burst;
  } else {
    wrio jump;
    wrio attack:5, charge;
  }
}

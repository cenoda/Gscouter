active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack;
  bennett burst, skill;
  xiangling burst, skill, dash;
  wrio  skill;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, dash;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio attack:3, charge, dash;
  }
  bennett skill, dash;
}

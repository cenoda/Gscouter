active wrio;
wrio attack:1;
for let i=0; i<4; i=i+1 {
  xilo skill, attack:2;
  bennett attack, skill, burst;
  mavuika skill, burst;
  wrio skill,
       attack:5, charge, dash,
       attack:5, charge, dash,
       attack:5, charge, dash,
       attack:3;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, dash;
    wrio attack;  
  }
}

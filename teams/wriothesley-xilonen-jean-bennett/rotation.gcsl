active wrio;
wrio attack;
for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;
  jean attack:3, skill, attack:3; 
  bennett skill, burst;
  jean burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio attack, charge;
  }
}

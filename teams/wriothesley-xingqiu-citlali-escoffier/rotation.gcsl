active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu skill, burst, attack;
  escoffier skill, attack, burst, attack;
  citlali skill, attack, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready  {
    wrio burst; 
  } else {
    wrio charge; 
  }
}

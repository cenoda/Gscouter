active xingqiu;
for let i=0; i<4;i=i+1 {
  xingqiu skill, dash, burst, attack;
  escoffier skill, attack, burst;
  rosaria skill, attack, burst, attack;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump;
  }
}

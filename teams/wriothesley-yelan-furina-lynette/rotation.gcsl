active furina;
for let i=0; i<4; i=i+1 {
 furina skill, dash, burst;
 yelan skill, burst, attack;
 if .lynette.skill.ready {
   lynette skill, attack, burst;
 } else {
   lynette attack, burst;
 }
 wrio  skill,
       attack:5, charge, dash,
       attack:5, charge, dash,
       attack:5, charge, dash;  
 if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
   wrio burst;
 }
 lynette skill, attack;
}

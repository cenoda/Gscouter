active yelan;
for let i=0; i<4;i=i+1 {
  escoffier skill, attack, burst;
  yelan skill, attack, burst, attack;
  mona skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if is_even(i) {
    wrio burst;
  } else {
    wrio charge, jump;
  }
}

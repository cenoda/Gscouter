active wrio;
wrio attack;
for let x=0; x<4; x=x+1 {
  xilonen skill, attack:2;
  yunjin skill, burst;

  bennett skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:5, charge, jump,
       attack:2;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack;
  }
}

active kuki;
for let i=0; i<4; i=i+1 {
   kuki skill;
   bennett burst;
   bennett skill;
   kazuha skill,high_plunge,burst;
   if .xiangling.burst.cd < 90
   {
     xiangling burst;
   }
   else
   {
     xiangling attack:2;
   }
   
   xiangling skill;
   bennett attack:2,skill;
   if .xiangling.burst.cd < 90
   {
     xiangling burst;
   }
   else
   {
     xiangling attack:3;
   }
   
   kazuha attack,skill,high_plunge;
   bennett attack:2,skill;
   xiangling attack:2;
}

active furina;
  furina skill, dash;
  xianyun skill, low_plunge;
  furina burst;
  xianyun burst;
  yelan burst, attack, skill, attack;
  hutao skill;
  for let p = 7; p > 0; p = p - 1 {
    hutao attack, jump;
    if .airborne {
      hutao low_plunge[collision=rand()>0.5];
    }
  }
  
  yelan attack, skill, attack:2;
for let i = 0; i < 2; i = i + 1 {
  xianyun skill, low_plunge, attack:3;
  furina burst, skill, dash;
  xianyun burst, attack;
  yelan burst, attack, skill, attack;
  hutao skill;
  for let p = 7; p > 0; p = p - 1 {
    hutao attack, jump;
    if .airborne {
      hutao low_plunge[collision=rand()>0.5];
    }
  }
  hutao attack;
  yelan attack, skill, attack:2;
  
  }

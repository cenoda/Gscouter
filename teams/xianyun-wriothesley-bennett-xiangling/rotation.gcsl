active xianyun;
  
for let i=0; i<4; i=i+1 {
  xianyun attack, skill, high_plunge, burst;
  while !.bennett.burst.ready {
    bennett attack;
  }
  bennett burst,skill;
  while !.xiangling.burst.ready {
    xiangling attack;
  }
  xiangling burst, skill;
  while .xiangling.mods.favonius-cd == 0 {
    xiangling attack;
  }
  wriothesley skill;
  for let p=0; p<4; p=p+1 {
    wriothesley attack:3, charge, jump;
    if .airborne {
      wriothesley high_plunge;
    } else {
      wriothesley attack, charge;
      break;
    }
  }
  if .wriothesley.burst.ready && .wriothesley.energy == 60 {
    wriothesley burst;
  }
  bennett skill;
  xiangling attack:3;
}

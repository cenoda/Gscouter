let HP = true;
active columbina;
columbina skill;
for let i=0; i<4; i=i+1 {
  if i > 0 && .columbina.burst.ready {
    columbina skill, burst;
  } else if i > 0 {
    columbina skill, attack;
  }
  
  ineffa skill;
  if i > 0 && .ineffa.burst.ready {
    ineffa burst;
  } 
  
  ororon skill, burst;
  
  xiao skill:2, burst;
  if HP == true {
    for let h = 11; h > 0; h = h - 1 {
      xiao jump, high_plunge[collision=rand()>0.5];
    }
  } else {
    for let h = 12; h > 0; h = h - 1 {
      xiao jump, low_plunge[collision=rand()>0.5];
    }
  }
}

active faruzan;
for let i=0; i<4; i=i+1 {
  while !.faruzan.mods.favonius-cd && i {
    faruzan attack;
  }
  faruzan burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
 
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan burst;
  if !.faruzan.mods.favonius-cd && !.xiao.burst.ready {
    faruzan attack;
  }
  
  durin skill, burst, skill;
  
  prune burst, skill;
  
  xiao skill:2;
  if .xiao.skill.ready && !.xiao.burst.ready {
    xiao skill;
  }
  xiao burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=1];
  }
}

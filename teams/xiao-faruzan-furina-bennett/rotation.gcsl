active furina;
for let i=0; i<4; i=i+1 {
  
  if !.furina.burst.ready {
    xiao attack;
  }
  
  furina skill, dash, burst;
  
  if i {
    bennett burst, skill;
  }
  else {
    bennett skill, burst;
  }
  
  faruzan burst;
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  
}

active furina;
for let i=0; i<2; i=i+1 {
  furina skill,burst;
  faruzan burst;
  sayu burst,skill;
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  sayu skill;
  print("end");
}

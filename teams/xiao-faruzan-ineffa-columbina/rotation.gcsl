active columbina;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    columbina skill, burst;
    ineffa skill, attack;
  } else {
    columbina skill, attack;
    if .ineffa.burst.ready {
      ineffa burst, skill;
    } else {
      ineffa skill, attack;
      columbina attack:3;
    }
  }
  faruzan burst;
  if !.faruzan.mods.favonius-cd {
    faruzan attack;
  }
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
}

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan attack, burst;
  
  while !.faruzan.mods.favonius-cd && !.xiao.burst.ready {
    faruzan attack;
  }
  
  jean skill, burst;
  
  bennett skill, burst;
 
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
      if col > 0.5 {
        xiao jump, high_plunge[collision=1];
      } else {
        xiao jump, high_plunge;
      }
  }
  
}

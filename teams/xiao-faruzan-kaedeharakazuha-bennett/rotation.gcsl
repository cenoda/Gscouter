active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  faruzan burst;
  kazuha attack, burst, skill, high_plunge;
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  kazuha skill, high_plunge;
}

active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  faruzan burst;
  while !.faruzan.mods.favonius-cd && !.xiao.burst.ready {  
    faruzan attack;
  }
  
  nicole burst;
  if !.nicole.mods.favonius-cd && !.xiao.burst.ready {
    nicole attack;
  }
  nicole skill;
  fischl attack:2, burst;
  xiao skill:2, burst;
  for let h = 11; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=1];
  }
}

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan skill, burst;
  while !.faru.mods.favonius-cd {
    faruzan attack;
  }
  bennett skill, burst;
  sucrose swap; wait(16);  
  sucrose skill;
  if i && .sucrose.skill.ready && .sucrose.weapon != .keys.weapon.ttds {  
    sucrose skill, dash;
  } else {
    sucrose dash;
  }
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}
print("end");

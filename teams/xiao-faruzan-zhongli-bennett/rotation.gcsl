active zhongli;
for let i=0; i<4; i=i+1 {
  zhongli attack, skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd && !.xiao.burst.ready {
    zhongli attack;
  }
  faruzan attack, burst;
  bennett skill, burst;
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  bennett skill;
  print("end");
}

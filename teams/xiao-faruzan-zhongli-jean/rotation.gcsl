active zhongli;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  
  faruzan attack, burst;
  
  if i == 0 {
    jean skill, burst;
  } else {
    jean burst, attack, skill;
  }
  
  xiao skill:2, burst;
  for let h = 11; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  for let h = 2; h > 0; h = h - 1 {
    xiao jump, low_plunge[collision=rand()>0.5];
  }
  
  jean skill;     
}

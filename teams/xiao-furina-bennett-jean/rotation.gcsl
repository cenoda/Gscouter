active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  if .jean.cons >= 4 {
    bennett skill, burst;
    
    jean skill, burst;
  } else {
    jean skill, burst;
    
    bennett skill, burst;
  }
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
}

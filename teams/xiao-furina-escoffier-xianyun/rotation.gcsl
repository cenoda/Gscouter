active furina;
for let i=0; i<4; i=i+1 {
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  esco skill;
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, attack, burst;
  
  xiao skill:2, burst;
  for let h = 10; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
}

active raiden;
raiden skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  
  xiao skill:2, burst;
  if .xiao.sets.longnightsoath >= 4 || .xiao.sets.dpc >= 4 {
    xiao attack, charge;
  }
  for let h = 8; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
  raiden burst, attack:4, skill, attack:4;
}

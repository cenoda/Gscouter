active furina;
let rotations = 4;
for let r = rotations; r > 0; r = r - 1 {
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst, attack;

  xianyun attack[travel=0], attack; 
  xiao skill;
  for let h = 8; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  
  xiao skill;
  
  bennett skill, dash;
  
}

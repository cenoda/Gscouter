active furina;
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  yelan skill;
  if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xiao skill:2, burst;
  for let h = 8; h > 0; h = h - 1 {
    xiao attack, jump, low_plunge[collision=rand()>0.5];
  }
  xiao attack;
}

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan burst;
  while (!.faruzan.mods.favonius-cd) {
    faruzan attack;
  } 
  
  jean skill, burst;
  while (!.jean.mods.favonius-cd) {
    jean attack;
  } 
  
  venti skill, burst;
  
  xiao skill:2, burst;
  for let h = 11; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  for let h = 2; h > 0; h = h - 1 {
    xiao jump, low_plunge[collision=rand()>0.5];
  }
}

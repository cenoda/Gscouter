active esco;
for let i=0; i<4; i=i+1 {
  if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
  esco skill;
  
  xianyun skill, low_plunge, burst;
  
  rosa skill, burst;
  
  xiao skill:2, burst;
  for let h = 9; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
}

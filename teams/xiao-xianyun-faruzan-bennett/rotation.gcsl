active bennett;
while 1 {
  if .bennett.skill.ready { bennett skill; }
  if .bennett.burst.ready { bennett burst; }
  if .faruzan.skill.ready { faruzan skill[hold=1]; }
  if .faruzan.burst.ready { faruzan burst; }
  if .xianyun.skill.ready { xianyun skill, high_plunge; }
  if .xianyun.burst.ready { xianyun burst; }
  if .xiao.burst.ready { xiao burst; }
  if .xiao.status.xiaoburst > 0 {
    while .xiao.status.xiaoburst > 0 {
      if .xiao.skill.ready { xiao skill; }
      xiao jump, high_plunge;
    }
  } else {
    xiao attack:5;
  }
}

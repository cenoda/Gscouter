active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;
  bennett burst, attack, skill;
  xiangling attack, burst, attack, skill, dash;
  xiao skill:2, burst;
  for let h = 7; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao attack, jump, high_plunge[collision=1];
    } else {
      xiao attack, jump, high_plunge;
    }
  }
  bennett skill;
}

active collei;
let t = 0;
for let i=0; i<4; i=i+1 {
    t = f();
    collei skill;
    xingqiu burst, attack;
    fischl skill, attack;
    xiao attack:3, skill, attack:5, skill, attack:2;
    fischl attack, burst;

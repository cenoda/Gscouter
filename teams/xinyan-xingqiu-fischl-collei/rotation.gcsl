active collei;
let t = 0;
for let i = 0; i < 4; i = i + 1 {
    t = f();
    collei skill;
    xingqiu burst, attack:2;
    fischl skill, attack;
    xinyan skill, attack, burst;
    while f() - t <= 10*60 {
        if .fischl.normal > 2 {
            fischl dash;
        }
        fischl attack;
    }
    fischl attack, burst;
    collei burst, attack, skill;
    xingqiu attack, skill, dash, attack:2;
    while f() - t <= 24*60 {
        if .fischl.normal > 2 {
            fischl dash;
        }
        fischl attack;
    }
    print("done");
}

active yae;
for let i=0; i<3; i=i+1 { 
    if !i {
      yae skill:3;
    } else {
	  yae attack, skill, attack, skill, attack, skill, attack;
	}
	baizhu burst, skill, attack;
	if !i { 
	fischl attack:2, skill;
	} else {
	fischl attack:3, skill;
	}
	tighnari skill, aim, burst, aim:2;
	yae attack, burst, attack, skill, attack, skill, attack, skill, attack:2;
	baizhu skill, attack;
	fischl attack:2, burst;
	tighnari skill, aim, burst, aim:2;
}

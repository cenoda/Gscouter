fn clorinde_combo() { 
  clorinde skill;
   while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active yae;
yae skill:3;
mav attack, skill;
chevreuse burst, skill[hold=1];
mav burst, dash;
clorinde_combo();
yae burst; 
for let i = 0; i < 4; i = i + 1 { 
  yae skill:3;
  chevreuse burst, skill[hold=1];
  clorinde burst; 
  if .mav.burst.ready { 
    mav skill, burst, dash;
  } else {
    mav attack, skill;
    clorinde attack;
  }
  clorinde_combo();
}

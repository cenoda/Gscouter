active yae;
for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }

  if .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  fischl skill, attack;
  
  if .mav.burst.ready {
    mav burst, 
        charge:2, charge[final=1], dash, 
        charge:2, charge[final=1], dash, 
        skill, dash;
  } else {
    mav dash, skill;
    yae attack:2, charge, jump;
    yae attack:2, charge, jump;
  }
  
  yae attack, burst, skill:3;
  
  fischl attack:2, burst;                 
  
  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
  yae attack:2, charge, dash;
  yae attack:2;
}

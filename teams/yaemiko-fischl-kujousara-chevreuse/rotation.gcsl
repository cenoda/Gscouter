active yae;
for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  chevreuse burst;
  if i==0 {
    chevreuse skill[hold=1];
  } else {
    chevreuse attack:2;
  }
  if .sara.skill.ready {
    sara skill, aim; 
  } else if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  yae attack:2, charge, dash,
      attack:2, charge, dash,
      attack:2;
  chevreuse skill[hold=1], attack:3; 
  if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  } else if .sara.skill.ready {
    sara skill, aim;
  }
  if .yae.burst.ready {
    yae burst;
  } else {
    yae attack:2, charge, dash;
  }
}

active yae;
for let x=0; x<4; x=x+1 {
  if x==0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill, attack;
  }
  nahida skill, burst, attack;
  fischl attack, skill;
  xianyun attack, skill, low_plunge, burst;
  yae attack, jump, low_plunge[collision=rand()>0.5], burst, skill:2, attack, skill;
  
  for let i=0;i<2;i=i+1 {
    yae jump;
    if .airborne {
      yae low_plunge[collision=rand()>0.5], dash;
    }
  }
  
  xianyun attack:2;
  fischl attack:2, burst;
  
  yae attack;
  for let i=0;i<5;i=i+1 {
    yae jump;
    if .airborne {
      yae low_plunge[collision=rand()>0.5], dash;
    }
  }
}

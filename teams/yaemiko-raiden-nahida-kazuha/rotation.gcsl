active kazuha;
while 1 {
  if .kazuha.skill.ready { kazuha skill; }
  if .kazuha.burst.ready { kazuha burst; }
  if .nahida.skill.ready { nahida skill[hold=1]; }
  if .nahida.burst.ready { nahida burst; }
  if .raiden.skill.ready { raiden skill; }
  if .raiden.burst.ready { raiden burst; }
  if .yaemiko.burst.ready { yaemiko burst; }
  yaemiko skill:2;
  yaemiko attack:4;
}

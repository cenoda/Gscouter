active xingqiu;
while 1 {
  xingqiu skill;
  if .xingqiu.burst.ready { xingqiu burst; }
  bennett skill;
  if .bennett.burst.ready { bennett burst; }
  kazuha skill;
  if .kazuha.burst.ready { kazuha burst; }
  if .yanfei.burst.ready { yanfei burst; }
  if .yanfei.skill.ready { yanfei skill; }
  while !.xingqiu.skill.ready {
    yanfei attack:2, charge;
  }
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}
active furina;
for let i=0; i<4; i=i+1 {
  
  furina skill, dash, attack, burst, attack;
  
  xilonen skill, attack:2; pick_up_crystallize("any");
  
  chiori skill:2;
  
  yelan burst, attack;
  chiori burst, attack:2, skill:2;
  
  yelan skill;  pick_up_crystallize("any");
  
  yelan attack:3;
  xilonen skill, attack:2;
  chiori attack, skill, attack:3, dash, attack:3, skill:2; 
  yelan attack, skill; pick_up_crystallize("any");
    
  yelan attack;
}

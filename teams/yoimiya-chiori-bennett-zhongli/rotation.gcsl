active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli attack, skill[hold=1], dash;
  while (.zhongli.mods.favonius-cd==0) {
	  zhongli attack;
	}
	chiori skill:2;
  bennett burst,skill;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:1;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
  } else if .chiori.burst.ready && .chiori.energy == .chiori.energymax {
    chiori burst;
  } else {
    chiori attack:3;
  }
  bennett skill,attack:2;
}

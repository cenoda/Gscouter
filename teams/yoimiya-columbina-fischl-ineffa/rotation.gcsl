active fischl;
for let i=0; i < 4; i=i+1 {
  
  if i > 0 && .ineffa.burst.ready {
    ineffa skill,burst;
  } else if i > 0 {
    ineffa skill,attack;
  } else {
    ineffa skill;
  }
  
  if .bina.burst.ready {
    bina skill, burst;
  } else { 
    bina attack,skill;
  }
  
  if .fischl.skill.ready {
    fischl skill,attack;
  } else {
    fischl attack:2, burst;
  }
  if i > 0 {
    yoi attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5,dash,attack:3;
  if .yoi.burst.ready {
    yoi burst;
  } else {
    yoi attack:1;
  }
}

active zhongli;
for let i = 0; i < 6; i = i + 1 {
  zhongli skill[hold=1], dash, attack;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  bennett burst, skill;
  if ( i / 2 ) * 2 !=i {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:2, dash;
  bennett skill, attack;
  if ( i / 2 ) * 2 !=i {
    yoimiya burst;
  } else {
    bennett attack;
  }
}

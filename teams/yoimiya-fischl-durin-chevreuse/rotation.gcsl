active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  if !i {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], burst;
  }
  durin skill, burst, skill;
  fischl attack:2, burst;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    fischl attack:2;
  }
}

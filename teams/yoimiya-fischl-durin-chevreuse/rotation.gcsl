active fischl;
fischl skill;
for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1]:3;
  durin skill, burst, skill;
  if is_even(i) {
    fischl attack:2, burst;
    yoimiya attack;
  } else {
    fischl attack, skill, attack;
  } 
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    fischl attack; 
    fischl skill[recast=1];
  }
}

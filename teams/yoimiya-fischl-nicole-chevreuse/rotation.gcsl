active fischl;
fischl skill, attack;
for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1]:3;
  nicole skill, burst;
  if is_even(i) {
    fischl burst;
    wait(89);   
  } else {
    fischl attack, skill, attack;
  } 
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    yoimiya attack, dash; 
  }
}

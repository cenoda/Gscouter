active furina;
furina skill, dash;
for let i = 0; i < 4; i = i + 1 {
  sigewinne attack:2, skill;
  furina burst;
  if i {
    furina skill, dash;
  }
  bennett skill, burst;
  yoimiya attack:2; 
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:3;
  }
  bennett skill, dash;
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); 
  }
	
  return _execute_action(char_id, action_id, p);
}
active furina;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst, attack:2, dash, attack;
  if is_even(i) {
    xilonen skill, attack:2;
    chiori burst, skill:2;
  } else {
    xilonen skill, burst, attack:2;
    chiori skill:2;
  }
  pick_up_crystallize("any");
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    chiori skill:2;
    yoimiya attack:2;
  }
}

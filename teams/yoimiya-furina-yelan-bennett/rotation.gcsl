active furina;
for let i = 0; i < 5; i = i + 1 {
 if !i {
    furina skill, dash, burst; 
  } else {
    furina burst, skill, dash;
  }
  yelan burst, attack;
  bennett burst, attack, skill;
  yelan attack, skill;

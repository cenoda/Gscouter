active xilonen;
for let i = 0; i < 4; i = i + 1 {
  xilonen skill, attack:2;    pick_up_crystallize("hydro");
  xilonen skill; 
  xilonen burst;
  furina skill, dash, burst, attack;
  yunjin skill, burst;
  xilonen skill, attack:2;    pick_up_crystallize("hydro");
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:3;
  if is_even(i) {
    yoimiya burst;
  }
}

active lisa;
for let i = 0; i < 4; i = i + 1 {
  lisa skill[hold=1], burst, attack;
  while !.lisa.mods.favonius-cd {
  lisa attack;}
  bennett burst, skill;
  chevreuse burst, skill[hold=1]:3;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  bennett skill, attack:2, dash;
}

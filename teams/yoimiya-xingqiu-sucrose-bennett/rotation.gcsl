active xingqiu;
for let i=0; i<4; i=i+1 {
  xingqiu attack:2, skill, dash, burst, attack;
  bennett skill, dash; 
  set_player_pos(0,-2);
  bennett burst;
  sucrose attack:3, skill, dash, attack; 
  set_player_pos(0,0);
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack; 
  bennett attack:2, skill, attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:3, dash;
  }
}

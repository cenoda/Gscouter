active fischl;
for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  durin skill:2, burst;
  yelan skill, burst, attack;
  fischl attack:2, burst;
  yoimiya attack, skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    yoimiya attack;
  }
}

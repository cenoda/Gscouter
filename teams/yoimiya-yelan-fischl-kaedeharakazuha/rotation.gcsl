active yoimiya;
for let x=0; x<2; x=x+1 {
  yoimiya burst;
  kazuha skill, high_plunge, burst;  
  yelan skill, attack, burst, attack;
  fischl attack:2, burst;            
  kazuha attack, skill, high_plunge; 
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash;
  
  yoimiya aim[hold=2];           
  kazuha skill, high_plunge, burst;  
  yelan skill, attack, burst, attack;
  fischl attack:2, skill;            
  kazuha skill, high_plunge;         
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
}

active yelan;
for let x=0; x<4; x=x+1 {
  yelan attack, skill, burst, attack; 
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  thoma attack, skill, attack, burst;
  while !.thoma.mods.favonius-cd {
    thoma attack;
  }  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else { 
    fischl attack:2, burst;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
  } else {
    fischl dash, attack:2; 
  }
}

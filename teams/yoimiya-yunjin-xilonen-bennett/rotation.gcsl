active bennett;
bennett skill;
for let i = 0; i < 4; i = i + 1 {
  xilonen skill, attack:2;
  yunjin skill, attack, burst;
  bennett skill, burst, dash;
  pick_up_crystallize("pyro");
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:2, dash;
  }
  bennett skill, dash;
}

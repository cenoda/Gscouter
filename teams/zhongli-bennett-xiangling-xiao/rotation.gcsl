active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill;
  zhongli skill[hold=1], dash, attack:2;
  bennett burst, skill;
  xiangling burst, skill;
  xiao skill:2, burst;
    for let x = 1; x <= 9; x = x + 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}

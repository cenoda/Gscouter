active fischl;
fischl aim; 
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  fischl attack:2, burst;
  collei burst;
  keqing skill, burst, skill,
         attack, charge, 
         attack, charge, 
         attack, skill,
         attack, charge,
         attack, charge,
         attack;
    
  zhongli skill[hold=1], dash, attack;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } 
  fischl attack, skill;
  collei skill;
  keqing skill, burst, skill,
         attack, charge, 
         attack, charge, 
         attack, skill,
         attack, charge,
         attack, charge,
         attack;
}

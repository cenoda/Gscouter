active albedo;
for let x=0; x<4; x=x+1{
  albedo skill;
  zhongli attack, skill[hold=1], dash;
  bennett skill, burst;
  xiao skill:2, burst;
  for let h=0; h < 11; h=h+1 {
    let col=rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}

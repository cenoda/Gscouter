active columbina;
while 1 {
  columbina skill;
  if .columbina.burst.ready { columbina burst; }
  zhongli skill;
  illuga skill;
  if .illuga.burst.ready { illuga burst; }
  zibai skill;
  if .zibai.burst.ready { zibai burst; }
  while .zibai.status.zibai-skill > 0 {
    if .zibai.radiance >= 70 {
      zibai skill;
    } else {
      zibai attack;
    }
  }
  while !.zibai.skill.ready || !.columbina.skill.ready {
    zibai attack;
  }
}

# Zibai quick guide, Zibai / Linnea / Gorou / Columbina:
#   Columbina E (Q) > Linnea (N1) E > Gorou (Q) E > Zibai combo
# Full combo: E, then 4[N4 E]; if Q is available, N1 Q after an E.
# Spirit Steed's Stride (Zibai's E in Lunar Phase Shift) needs 70 Phase
# Shift Radiance: Zibai attacks until she has it, and her mode ends after
# four of them. Linnea's burst is left out, as both guides allow without
# a need for healing; on the fork it would stop Lumi (design §5.4).
active columbina;
columbina skill;
if .columbina.burst.ready {
  columbina burst;
}
linnea attack, skill;
if .gorou.burst.ready {
  gorou burst;
}
gorou skill;
zibai skill;
for let i = 0; i < 4; i = i + 1 {
  zibai attack:4;
  while .zibai.radiance > 0 && .zibai.radiance < 70 {
    zibai attack;
  }
  if .zibai.radiance >= 70 {
    zibai skill;
    if .zibai.burst.ready {
      zibai attack, burst;
    }
  }
}

# Zibai quick guide, Zibai / Linnea / Columbina / Ineffa:
#   Columbina E (Q) > Ineffa E (Q) > Linnea (N1) E or 5[E] > Zibai combo
# Ineffa's burst is skipped in the first rotation, then used when
# available, as the guide says. Linnea plays Super Mode, (N1) E. Full
# combo: E, then 4[N4 E]; if Q is available, N1 Q after an E. Spirit
# Steed's Stride needs 70 Phase Shift Radiance: Zibai attacks until she
# has it. Linnea's burst is left out (only for healing; on the fork it
# would stop Lumi, design §5.4).
active columbina;
let first = 1;
columbina skill;
if .columbina.burst.ready {
  columbina burst;
}
ineffa skill;
if first == 0 && .ineffa.burst.ready {
  ineffa burst;
}
first = 0;
linnea attack, skill;
zibai skill;
for let i = 0; i < 4; i = i + 1 {
  zibai attack:4;
  while .zibai.radiance > 0 && .zibai.radiance < 70 {
    zibai attack;
  }
  if .zibai.radiance >= 70 {
    zibai skill;
    if .zibai.burst.ready {
      zibai attack, burst;
    }
  }
}
